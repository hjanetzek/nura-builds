# nura-builds overlay (targets/pixel3.sh): pmaports' recipe at 535fba79ee (7.1_rc1-r4), copied over the
# pmaports recipe by scripts/setup.sh. Changes are marked "nura-builds:". Planned: the USB Type-C
# and VBUS series for PMI8998 (USB OTG), see docs/google-blueline.md.
# Co-Maintainer: Joel Selvaraj <foss@joelselvaraj.com>
# Stable Linux kernel with patches for SDM845 devices
# Kernel config based on: arch/arm64/configs/defconfig and sdm845.config
maintainer="Casey Connolly <kcxt@postmarketos.org>"
_flavor="postmarketos-qcom-sdm845"
pkgname=linux-$_flavor
pkgver=7.1_rc1
# nura-builds: pmaports' pkgrel + 100, above the published package (+1: ALSA sequencer)
pkgrel=105
pkgdesc="Mainline Kernel fork for SDM845 devices"
arch="aarch64"
_carch="arm64"
url="https://gitlab.com/sdm845-mainline/linux"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	pmb:kconfigcheck-lockdown
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

_tag="sdm845-7.1-rc1-r0"

# Source
# nura-builds: otg-*.patch, USB OTG for the Pixel 3 (docs/google-blueline.md): the qcom PMIC Type-C
# driver backported from v7.4-rc1, David Heidelberg's "Qualcomm Type-C support for 1st generation"
# RFC and "Enable Qualcomm VBUS block on PMI8998 and PM660" (the Pixel 3 parts; some adapted to this
# tree, marked in their messages), and the dual power role with VBUS for the Pixel 3 (ours)
source="
	linux-$_tag.tar.gz::https://gitlab.com/sdm845-mainline/linux/-/archive/$_tag/linux-$_tag.tar.gz
	config-postmarketos-qcom-sdm845.aarch64
	libbpf-Fix-UAF-in-strset__add_str.patch
	enable-dynamic-ftrace.patch
	otg-0001-usb-typec-tcpm-qcom-backport-the-driver-from-v7.4-rc.patch
	otg-0002-usb-typec-tcpm-qcom-Release-the-connector-fwnode-ref.patch
	otg-0003-dt-bindings-usb-qcom-pmic-typec-Update-example-with-.patch
	otg-0004-dt-bindings-usb-Add-Qualcomm-1st-gen-PMIC-Type-C.patch
	otg-0005-usb-typec-qcom-Make-PMIC-port-probe-selectable.patch
	otg-0006-usb-typec-qcom-Make-typec_port-accept-also-different.patch
	otg-0007-usb-typec-qcom-Add-gen1-Type-C-port-support.patch
	otg-0008-arm64-dts-qcom-pmi8998-Add-USB-Type-C-port-controlle.patch
	otg-0009-arm64-dts-qcom-sdm845-google-common-Enable-USB-Type-.patch
	otg-0010-regulator-qcom_usb_vbus-Fix-the-MODULE_LICENSE-strin.patch
	otg-0011-power-supply-qcom_smbx-Do-not-interfere-with-vbus-dr.patch
	otg-0012-dt-bindings-regulator-qcom-usb-vbus-regulator-Add-pm.patch
	otg-0013-arm64-dts-qcom-pmi8998-Add-node-for-PMIC-VBUS-booste.patch
	otg-0014-arm64-dts-qcom-sdm845-google-Enable-vbus-support.patch
	otg-0015-arm64-dts-qcom-sdm845-google-common-dual-power-role-.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	if [ -e "$builddir/arch/$_carch/boot/vmlinuz.efi" ]; then
		# ZBOOT EFI decompressor for EFI booting
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
			"$pkgdir/boot/linux.efi"

		# Old GZIP'd kernel image for boot.img compatibility
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
			"$pkgdir/boot/vmlinuz"
	else
		echo "WARNING: CONFIG_ZBOOT not enabled!"
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
			"$pkgdir/boot/vmlinuz"
	fi

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr/ \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs-tmp

	mkdir -p "$pkgdir"/boot/dtbs/qcom
	cp -r "$pkgdir"/boot/dtbs-tmp/qcom/sdm8* "$pkgdir"/boot/dtbs/qcom
	rm -rf "$pkgdir"/boot/dtbs-tmp

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}


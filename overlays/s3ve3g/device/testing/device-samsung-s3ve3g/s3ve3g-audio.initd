#!/sbin/openrc-run
# Samsung Galaxy S III Neo: the audio output follows the headphone jack (headphones while a plug
# is in, the speaker otherwise), see s3ve3g-audio

description="Audio output following the headphone jack"

supervisor=supervise-daemon
command=/usr/bin/s3ve3g-audio
command_args="follow"
respawn_delay=5
respawn_max=10

depend() {
	after modules
}

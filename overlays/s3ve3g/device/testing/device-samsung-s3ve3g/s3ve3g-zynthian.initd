#!/sbin/openrc-run
# Samsung Galaxy S III Neo: zynthian's Qt UI full-screen (eglfs, no compositor) with JACK, started at
# boot as the phone's user (/usr/bin/s3ve3g-zynthian; settings in /etc/conf.d/s3ve3g-zynthian).
# The screen is switched on for it; the power key switches it off and on (s3ve3g-powerkey).

description="zynthian (Qt UI on eglfs, JACK)"
supervisor=supervise-daemon
command=/usr/bin/s3ve3g-zynthian
respawn_delay=5
respawn_max=5

# the phone's user (postmarketOS: uid 10000), with its groups (video, input, audio)
: "${ZYNTHIAN_USER:=$(getent passwd 10000 | cut -d: -f1)}"
command_user="$ZYNTHIAN_USER"

depend() {
	need seatd
	after s3ve3g-screen-off s3ve3g-audio s3ve3g-powerkey udev-settle
	# OpenRC starts the runlevel one service at a time: zynthian first, the services it doesn't
	# need (network, time, ssh, ...) after it, while zynthian loads (it started 14 s after the
	# kernel start, after NetworkManager, wpa_supplicant, routewrangler, ...)
	before networkmanager wpa_supplicant unudhcpd unudhcpd.usb0 routewrangler chronyd sshd haveged rfkill
	before sleep-inhibitor postmarketos-zram-swap swapfile zynthian-webconf
}

start_pre() {
	if ! command -v zynthian >/dev/null; then
		eerror "zynthian isn't installed"
		return 1
	fi
	if service_started s3ve3g-mdt; then
		eerror "s3ve3g-mdt runs: one session at a time (s3ve3g-session zynthian switches)"
		return 1
	fi
	if [ -z "$ZYNTHIAN_USER" ]; then
		eerror "no user for zynthian (ZYNTHIAN_USER in /etc/conf.d/s3ve3g-zynthian)"
		return 1
	fi
	local home
	home=$(getent passwd "$ZYNTHIAN_USER" | cut -d: -f6)
	export HOME="$home" USER="$ZYNTHIAN_USER" LOGNAME="$ZYNTHIAN_USER"
	export XDG_RUNTIME_DIR="/tmp/runtime-$ZYNTHIAN_USER"
	# zynthian writes its first-frame marker there (and Qt complains without it)
	checkpath -d -m 0700 -o "$ZYNTHIAN_USER" "$XDG_RUNTIME_DIR"
	# s3ve3g-screen-off blanked it after boot (burn-in protection while nothing is shown)
	/usr/bin/s3ve3g-screen on || true
}

zynthian_pids() {
	local p
	pgrep -x zynthian_deskto; pgrep -x aeolus; pgrep -x jackd; pgrep -x wireplumber; pgrep -x pipewire
	for p in $(pgrep -x python3); do
		grep -q zynthian_qt_main "/proc/$p/cmdline" 2>/dev/null && echo "$p"
	done
}

stop_post() {
	# what the launcher started besides zynthian's own launcher: jackd, the UI, aeolus. Waited for
	# (up to 10 s, then killed): an old UI still holding the display makes the next start's UI
	# fail to get DRM master ("Could not set DRM mode ... Permission denied", nothing on screen)
	local pids i=0
	pids=$(zynthian_pids)
	[ -n "$pids" ] && kill $pids 2>/dev/null
	while [ -n "$(zynthian_pids)" ] && [ $i -lt 20 ]; do
		sleep 0.5; i=$((i + 1))
	done
	pids=$(zynthian_pids)
	[ -n "$pids" ] && kill -9 $pids 2>/dev/null
	return 0
}

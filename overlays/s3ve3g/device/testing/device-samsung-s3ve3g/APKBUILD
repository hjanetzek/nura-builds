# nura-builds overlay (targets/s3ve3g.sh): pmaports' archived device package (downstream kernel
# 3.4, too old for systemd), moved to the mainline kernel linux-postmarketos-qcom-msm8226 (whose
# s3ve3g device tree is ours, the kernel's overlay) and to device/testing (setup.sh removes the
# archived one: pmbootstrap init doesn't take an archived device unasked).
# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-samsung-s3ve3g
pkgdesc="Samsung Galaxy S III Neo"
# nura-builds: pmaports' pkgver 4 + 100
pkgver=104
pkgrel=12
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a330
	linux-postmarketos-qcom-msm8226
	mkbootimg
	postmarketos-base
	postmarketos-bootsplash
	soc-qcom-msm8226
"
makedepends="devicepkg-dev"
# nura-builds: pmOS's boot splash (plymouth, DRM renderer; msm in the initramfs, deviceinfo), its
# kernel command line options built into the kernel (CONFIG_CMDLINE, see below); OpenRC settings
# in the -openrc subpackage
subpackages="$pkgname-openrc:_openrc"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname-openrc.post-install $pkgname-openrc.post-upgrade"
source="
	deviceinfo
	s3ve3g-firmware.sh
	s3ve3g-firmware.service
	s3ve3g-firmware.initd
	s3ve3g-screen.sh
	s3ve3g-screen-off.initd
	s3ve3g-screen-off.service
	s3ve3g-debug-telnet.initd
	s3ve3g-display-manual.conf
	s3ve3g-no-smgr.conf
	s3ve3g-panic.sysctl
	ucm-s3ve3g.conf
	ucm-HiFi.conf
	s3ve3g-audio.sh
	s3ve3g-audio.initd
	s3ve3g-audio-rt.conf
	s3ve3g-powerkey.sh
	s3ve3g-powerkey.initd
	s3ve3g-powerkey.service
	s3ve3g-powerkey-logind.conf
	s3ve3g-zynthian.sh
	s3ve3g-zynthian.initd
	s3ve3g-zynthian.confd
	s3ve3g-zynthian.service
	s3ve3g-jack.sh
	s3ve3g-mdt.sh
	s3ve3g-mdt.initd
	s3ve3g-mdt.confd
	s3ve3g-session.sh
	s3ve3g-midi.conf
	s3ve3g-mdt-keys.py
	s3ve3g-pipewire.conf
	s3ve3g-wireplumber.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# nura-builds: Samsung's bootloader appends ~840 characters to the boot image's command line
	# and doesn't boot more than 1024 in total: the device options are built into the kernel
	# (CONFIG_CMDLINE, plymouth's "splash plymouth.ignore-serial-consoles plymouth.prefer-fbcon"
	# too), and quiet and plymouth's options (00-base.conf, 20-plymouth.conf in
	# /usr/lib/kernel-cmdline.d) are overridden with empty files, so the boot image only has
	# pmOS's pmos_boot_uuid, pmos_root_uuid and pmos_rootfsopts (about 130 characters)
	install -Dm644 /dev/null "$pkgdir"/etc/kernel-cmdline.d/00-base.conf
	install -Dm644 /dev/null "$pkgdir"/etc/kernel-cmdline.d/20-plymouth.conf

	# nura-builds: the display driver in the initramfs, so that msm takes over from the
	# bootloader's framebuffer (simpledrm) within the first seconds and plymouth's boot splash
	# runs on it (the IOMMUs it needs since 7.x are built in: QCOM_IOMMU, ARM_SMMU). mkinitfs
	# takes the modules from these lists (it no longer reads deviceinfo_modules_initfs)
	printf "%s\n" msm panel-samsung-s3ve3g-s6e8aa0a |
		install -Dm644 /dev/stdin "$pkgdir"/usr/share/mkinitfs/modules/90-$pkgname.modules

	# nura-builds: the Wi-Fi firmware (apnhlos) and NV calibration file (system) copied from the
	# stock partitions into /lib/firmware once, before udev, instead of msm-firmware-loader (which
	# mounted and scanned all firmware partitions on every boot: 4 s at 787 MHz); for systemd and
	# OpenRC (its script in the -openrc subpackage)
	install -Dm755 "$srcdir"/s3ve3g-firmware.sh "$pkgdir"/usr/libexec/s3ve3g-firmware
	install -Dm644 "$srcdir"/s3ve3g-firmware.service \
		"$pkgdir"/usr/lib/systemd/system/s3ve3g-firmware.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../s3ve3g-firmware.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/s3ve3g-firmware.service

	# nura-builds: the initramfs's mdev.conf (postmarketos-initramfs) runs
	# /lib/mdev/persistent-storage (mdev-conf's /dev/disk/by-* links) for every block device, but
	# the initramfs doesn't have it: "not found" for each of the eMMC's ~30 partitions, on the
	# console at about 45 ms a line. The initramfs doesn't use those links (udev makes them in the
	# rootfs): a no-op in its place, in the initramfs only
	install -Dm755 /dev/stdin "$pkgdir"/usr/share/$pkgname/persistent-storage-noop <<-EOF
	#!/bin/sh
	EOF
	# and the GPU's microcode (firmware-qcom-adreno-a330), which msm requests when it binds in the
	# initramfs (without it: "failed to load a330_pm4.fw" and no GPU until a later open)
	printf "%s\n" "/usr/share/$pkgname/persistent-storage-noop:/lib/mdev/persistent-storage" \
		/lib/firmware/qcom/a330_pm4.fw /lib/firmware/qcom/a330_pfp.fw |
		install -Dm644 /dev/stdin "$pkgdir"/usr/share/mkinitfs/files/90-$pkgname.files

	# nura-builds: the screen black after boot (no panel driver, so no brightness control; an
	# AMOLED's black pixels are off: no burn-in); "s3ve3g-screen on" brings the console back
	install -Dm755 "$srcdir"/s3ve3g-screen.sh "$pkgdir"/usr/bin/s3ve3g-screen
	install -Dm644 "$srcdir"/s3ve3g-screen-off.service \
		"$pkgdir"/usr/lib/systemd/system/s3ve3g-screen-off.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../s3ve3g-screen-off.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/s3ve3g-screen-off.service

	# nura-builds, bring-up: a place to blacklist msm (display, GPU) again while debugging it
	install -Dm644 "$srcdir"/s3ve3g-display-manual.conf "$pkgdir"/etc/modprobe.d/s3ve3g-display-manual.conf
	# qcom_smgr never probes without a sensor registry and blocks udev-settle ~6 s (see the file)
	install -Dm644 "$srcdir"/s3ve3g-no-smgr.conf "$pkgdir"/etc/modprobe.d/s3ve3g-no-smgr.conf
	# the MDSS kept from runtime suspend (its resume leaves the MDP unreachable; DPMS works with it)

	# nura-builds: the ALSA UCM profile (speaker, headphones) for the card "Samsung Galaxy S III
	# Neo" of the APQ8096 machine driver
	install -Dm644 "$srcdir"/ucm-s3ve3g.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/apq8096/Samsung Galaxy S III Neo.conf"
	install -Dm644 "$srcdir"/ucm-HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/Samsung/s3ve3g/HiFi.conf
	# "s3ve3g-audio speaker|headphones": switch the output with that profile, remembered for the
	# next boot (OpenRC service s3ve3g-audio in the -openrc subpackage)
	install -Dm755 "$srcdir"/s3ve3g-audio.sh "$pkgdir"/usr/bin/s3ve3g-audio
	# realtime scheduling and locked memory for the audio group (JACK, zynthian)
	install -Dm644 "$srcdir"/s3ve3g-audio-rt.conf "$pkgdir"/etc/security/limits.d/95-s3ve3g-audio-rt.conf
	# nura-builds: the power key switches the screen off and on (panel and touchscreen; works
	# under a Qt eglfs application too), instead of logind powering the phone off (elogind
	# doesn't read pmOS's /usr/lib/elogind/logind.conf with HandlePowerKey=ignore)
	install -Dm755 "$srcdir"/s3ve3g-powerkey.sh "$pkgdir"/usr/bin/s3ve3g-powerkey
	install -Dm644 "$srcdir"/s3ve3g-powerkey-logind.conf \
		"$pkgdir"/etc/elogind/logind.conf.d/50-s3ve3g-powerkey.conf
	install -Dm644 "$srcdir"/s3ve3g-powerkey-logind.conf \
		"$pkgdir"/etc/systemd/logind.conf.d/50-s3ve3g-powerkey.conf
	install -Dm644 "$srcdir"/s3ve3g-powerkey.service \
		"$pkgdir"/usr/lib/systemd/system/s3ve3g-powerkey.service
	ln -s ../s3ve3g-powerkey.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/s3ve3g-powerkey.service

	# nura-builds: zynthian's Qt UI at boot, full-screen without a compositor (Qt eglfs), with JACK
	# on the sound card, as the phone's user (uid 10000); zynthian itself isn't a dependency (not
	# packaged for armv7 yet): the services don't start without it
	install -Dm755 "$srcdir"/s3ve3g-zynthian.sh "$pkgdir"/usr/bin/s3ve3g-zynthian
	# JACK on the sound card, shared by the session launchers (zynthian, MicroDexed-touch)
	install -Dm644 "$srcdir"/s3ve3g-jack.sh "$pkgdir"/usr/share/s3ve3g/jack.sh
	# MicroDexed-touch as the session instead of zynthian (headless with JACK; package
	# microdexed-touch, not a dependency); s3ve3g-session (OpenRC) switches
	install -Dm755 "$srcdir"/s3ve3g-mdt.sh "$pkgdir"/usr/bin/s3ve3g-mdt
	# the phone's keys to MDT's control port (python3, not a dependency: zynthian brings it;
	# without it s3ve3g-mdt starts no relay)
	install -Dm755 "$srcdir"/s3ve3g-mdt-keys.py "$pkgdir"/usr/bin/s3ve3g-mdt-keys
	# PipeWire for the MDT session (pipewire-jack not a dependency): 48 kHz/480, the card's
	# Pro Audio profile
	install -Dm644 "$srcdir"/s3ve3g-pipewire.conf \
		"$pkgdir"/usr/share/pipewire/pipewire.conf.d/50-s3ve3g.conf
	install -Dm644 "$srcdir"/s3ve3g-wireplumber.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/50-s3ve3g.conf
	# the ALSA sequencer (MIDI programs; nothing else loads it here)
	install -Dm644 "$srcdir"/s3ve3g-midi.conf "$pkgdir"/etc/modules-load.d/s3ve3g-midi.conf
	install -Dm644 "$srcdir"/s3ve3g-zynthian.service \
		"$pkgdir"/usr/lib/systemd/system/s3ve3g-zynthian.service
	ln -s ../s3ve3g-zynthian.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/s3ve3g-zynthian.service

	# bring-up: restart on an oops (alpine's 00-alpine.conf has kernel.panic = 120, no panic_on_oops)
	install -Dm644 "$srcdir"/s3ve3g-panic.sysctl "$pkgdir"/etc/sysctl.d/90-s3ve3g-panic.conf

	# nura-builds (systemd): services masked for a faster boot (their packages are dependencies of
	# postmarketos-base-ui): systemd-nsresourced and -mountfsd (their BPF programs don't load on
	# this kernel; nsresourced held up udevd, and so every device, for 32 s), nftables (the
	# firewall: NetworkManager and the login prompt waited for it); OpenRC: the -openrc
	# subpackage's post-install script
	local unit
	for unit in systemd-nsresourced.service systemd-nsresourced.socket \
		systemd-mountfsd.service systemd-mountfsd.socket nftables.service; do
		mkdir -p "$pkgdir"/etc/systemd/system
		ln -s /dev/null "$pkgdir"/etc/systemd/system/$unit
	done
}

_openrc() {
	pkgdesc="Samsung Galaxy S III Neo: OpenRC services"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-base-openrc"
	# after it: its post-install script enables nftables, ours disables it
	depends="postmarketos-base-nftables-openrc busybox-extras"

	install -Dm755 "$srcdir"/s3ve3g-firmware.initd "$subpkgdir"/etc/init.d/s3ve3g-firmware
	install -Dm755 "$srcdir"/s3ve3g-screen-off.initd "$subpkgdir"/etc/init.d/s3ve3g-screen-off
	install -Dm755 "$srcdir"/s3ve3g-audio.initd "$subpkgdir"/etc/init.d/s3ve3g-audio
	install -Dm755 "$srcdir"/s3ve3g-powerkey.initd "$subpkgdir"/etc/init.d/s3ve3g-powerkey
	install -Dm755 "$srcdir"/s3ve3g-zynthian.initd "$subpkgdir"/etc/init.d/s3ve3g-zynthian
	install -Dm644 "$srcdir"/s3ve3g-zynthian.confd "$subpkgdir"/etc/conf.d/s3ve3g-zynthian
	# the MicroDexed-touch session, not enabled; s3ve3g-session zynthian|mdt chooses
	install -Dm755 "$srcdir"/s3ve3g-mdt.initd "$subpkgdir"/etc/init.d/s3ve3g-mdt
	install -Dm644 "$srcdir"/s3ve3g-mdt.confd "$subpkgdir"/etc/conf.d/s3ve3g-mdt
	install -Dm755 "$srcdir"/s3ve3g-session.sh "$subpkgdir"/usr/bin/s3ve3g-session
	# bring-up: a telnet login on the USB network before udev (busybox-extras' telnetd)
	install -Dm755 "$srcdir"/s3ve3g-debug-telnet.initd "$subpkgdir"/etc/init.d/s3ve3g-debug-telnet
}


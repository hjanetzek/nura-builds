# nura-builds overlay (targets/s3ve3g.sh): pmaports' archived device package
# (downstream kernel 3.4, too old for systemd), moved to the mainline kernel and to device/testing
# (setup.sh removes the archived one: pmbootstrap init doesn't take an archived device unasked)
# linux-postmarketos-qcom-msm8226, whose s3ve3g device tree is ours (the kernel's overlay).
# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-samsung-s3ve3g
pkgdesc="Samsung Galaxy S III Neo"
# nura-builds: pmaports' pkgver 4 + 100
pkgver=104
pkgrel=6
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a330
	linux-postmarketos-qcom-msm8226
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8226
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}


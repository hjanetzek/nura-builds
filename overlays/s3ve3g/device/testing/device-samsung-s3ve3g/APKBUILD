# nura-builds overlay (targets/s3ve3g.sh): pmaports' archived device package
# (downstream kernel 3.4, too old for systemd), moved to the mainline kernel and to device/testing
# (setup.sh removes the archived one: pmbootstrap init doesn't take an archived device unasked)
# linux-postmarketos-qcom-msm8226, whose s3ve3g device tree is ours (the kernel's overlay).
# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-samsung-s3ve3g
pkgdesc="Samsung Galaxy S III Neo"
# nura-builds: pmaports' pkgver 4 + 100
pkgver=104
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a330
	linux-postmarketos-qcom-msm8226
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8226
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	s3ve3g-wcnss-nv.sh
	s3ve3g-wcnss-nv.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# nura-builds: Samsung's bootloader appends ~840 characters to the boot image's command line
	# and doesn't boot more than 1024 in total: the device options are built into the kernel
	# (CONFIG_CMDLINE), and quiet and plymouth's options (00-base.conf, 20-plymouth.conf in
	# /usr/lib/kernel-cmdline.d) are overridden with empty files, so the boot image only has
	# pmOS's pmos_boot_uuid, pmos_root_uuid and pmos_rootfsopts (about 130 characters)
	install -Dm644 /dev/null "$pkgdir"/etc/kernel-cmdline.d/00-base.conf
	install -Dm644 /dev/null "$pkgdir"/etc/kernel-cmdline.d/20-plymouth.conf

	# nura-builds: the Wi-Fi NV calibration file from the stock system partition, once, before
	# msm-firmware-loader (which doesn't look there)
	install -Dm755 "$srcdir"/s3ve3g-wcnss-nv.sh "$pkgdir"/usr/libexec/s3ve3g-wcnss-nv
	install -Dm644 "$srcdir"/s3ve3g-wcnss-nv.service \
		"$pkgdir"/usr/lib/systemd/system/s3ve3g-wcnss-nv.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../s3ve3g-wcnss-nv.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/s3ve3g-wcnss-nv.service

	# nura-builds: services masked for a faster boot (their packages are dependencies of
	# postmarketos-base-ui): systemd-nsresourced and -mountfsd (their BPF programs don't load on
	# this kernel; nsresourced held up udevd, and so every device, for 32 s), nftables (the
	# firewall: NetworkManager and the login prompt waited for it), plymouth (no splash with the
	# console UI; the kernel command line has no "splash")
	local unit
	for unit in systemd-nsresourced.service systemd-nsresourced.socket \
		systemd-mountfsd.service systemd-mountfsd.socket nftables.service \
		plymouth-start.service plymouth-read-write.service plymouth-quit.service \
		plymouth-quit-wait.service plymouth-switch-root.service; do
		mkdir -p "$pkgdir"/etc/systemd/system
		ln -s /dev/null "$pkgdir"/etc/systemd/system/$unit
	done
}

sha512sums="

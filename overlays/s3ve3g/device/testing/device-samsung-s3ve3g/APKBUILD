# nura-builds overlay (targets/s3ve3g.sh): pmaports' archived device package
# (downstream kernel 3.4, too old for systemd), moved to the mainline kernel and to device/testing
# (setup.sh removes the archived one: pmbootstrap init doesn't take an archived device unasked)
# linux-postmarketos-qcom-msm8226, whose s3ve3g device tree is ours (the kernel's overlay).
# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-samsung-s3ve3g
pkgdesc="Samsung Galaxy S III Neo"
# nura-builds: pmaports' pkgver 4 + 100
pkgver=104
pkgrel=7
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a330
	linux-postmarketos-qcom-msm8226
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8226
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# nura-builds: Samsung's bootloader appends ~840 characters to the boot image's command line
	# and doesn't boot more than 1024 in total: the device options are built into the kernel
	# (CONFIG_CMDLINE), and quiet and plymouth's options (00-base.conf, 20-plymouth.conf in
	# /usr/lib/kernel-cmdline.d) are overridden with empty files, so the boot image only has
	# pmOS's pmos_boot_uuid, pmos_root_uuid and pmos_rootfsopts (about 130 characters)
	install -Dm644 /dev/null "$pkgdir"/etc/kernel-cmdline.d/00-base.conf
	install -Dm644 /dev/null "$pkgdir"/etc/kernel-cmdline.d/20-plymouth.conf
}

sha512sums="
2ff0d9ad3c17b479100be68ac1b9b2275ce56c2da55a11b6ef959c56f5c03855d093caf173eeab005c590ca3aaaddf56688825a6528e3775b205042d4d065805  deviceinfo
44d0a4f26340925c01894e61b05b6c84628c8425742b21cc11d3183269655734f5fcb70cfda601048ab1106155e3bf3f6ed8068c8d476647963173b081be9ff2  modules-initfs
"

# Samsung Galaxy S III Neo: MicroDexed-touch as the session (s3ve3g-mdt; "s3ve3g-session mdt" to
# switch to it, "s3ve3g-session zynthian" back)
# the user MDT runs as (default: the phone's user, uid 10000)
#MDT_USER=user
# JACK and MDT's audio thread: real-time priority and locked memory, as the audio group's limits
# (/etc/security/limits.d/95-s3ve3g-audio-rt.conf) give a login
rc_ulimit="-r 95 -l unlimited"
# settings read by the launcher (see /usr/bin/s3ve3g-mdt)
# the options (default "--audio --rotate $MDT_ROTATE"; "--headless --audio": no display)
#export MDT_ARGS="--audio --rotate 90"
# the panel rotation of MDT's landscape UI (90: upright as tested; 270, 0, 180)
#export MDT_ROTATE=90
# pipewire (default: PipeWire + WirePlumber, MDT through pw-jack) or jackd (needs Alpine's jack
# instead of pipewire-jack)
#export MDT_AUDIO=pipewire
# the period/quantum in frames (both)
#export JACK_PERIOD=480

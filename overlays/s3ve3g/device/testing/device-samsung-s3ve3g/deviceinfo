# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.
# nura-builds overlay: the mainline kernel (linux-postmarketos-qcom-msm8226) instead of the
# downstream 3.4 one, booted by Samsung's bootloader (no lk2nd) with the device tree in a QCDT
# table (dt.img, made by boot-deploy with dtbTool from qcom,msm-id): the bootloader ignored an
# appended device tree (straight back to download mode), and lk2nd also uses QCDT on Samsung's
# msm8226 devices

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy S III Neo"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-s3ve3g"
deviceinfo_year="2014"
deviceinfo_arch="armv7"

# Device related
deviceinfo_chassis="handset"
deviceinfo_drm="true"
deviceinfo_external_storage="true"
deviceinfo_getty="ttyMSM0;115200"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1280"

# Bootloader related
deviceinfo_flash_method="heimdall-bootimg"
deviceinfo_generate_bootimg="true"
deviceinfo_dtb="qcom-msm8226-samsung-s3ve3g"
deviceinfo_bootimg_qcdt="true"
deviceinfo_bootimg_qcdt_type="qcom"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_heimdall_partition_kernel="BOOT"
# The rootfs to USERDATA: SYSTEM is too small for the zynthian image
deviceinfo_flash_heimdall_partition_rootfs="USERDATA"
deviceinfo_flash_sparse="true"
# BOOT is about 10 MB: the large parts of the initramfs (filesystem tools, udev, the FDE unlocker)
# in initramfs-extra on the boot partition of the rootfs, the rest compressed best
deviceinfo_create_initfs_extra="true"
deviceinfo_initfs_compression="lzma"

From 8830818b97406a5921ac7a22c3c5c68469d1533b Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Fri, 20 Nov 2026 12:23:00 +0100
Subject: [PATCH] ARM: dts: qcom: msm8226-samsung-s3ve3g: charger, LED, light
 sensor, touch keys, vibrator

From the downstream device tree (msm8226-sec-s3ve3geur-r04):
- the PM8226 charger (SMBB) with downstream's limits for the 2100 mAh battery: 4.2 V,
  recharge below 4.1 V, input minimum 4.3 V, 1.5 A;
- bit-banged I2C on GPIO 23/16 with the AN30259A RGB notification LED and the CM36651
  light/proximity sensor (interrupt GPIO 65, supply switched by GPIO 110);
- bit-banged I2C on GPIO 114/66 with the Cypress touch key controller of the menu and back
  keys (Samsung's Galaxy S III firmware protocol: cypress,midas-touchkey; interrupt GPIO 49,
  supply GPIO 67, key light GPIO 56);
- the DRV2603 vibrator: enable GPIO 111, its PWM input (GPIO 33) held high.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/qcom-msm8226-samsung-s3ve3g.dts  | 187 ++++++++++++++++++
 1 file changed, 187 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts b/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts
index 166a580873f3..171b38a05cb7 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts
@@ -12,6 +12,7 @@
 /dts-v1/;
 
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/soc/qcom,apr.h>
 #include <dt-bindings/sound/qcom,q6afe.h>
@@ -144,6 +145,129 @@ muic: usb-switch@25 {
 		};
 	};
 
+	/*
+	 * The notification LED and the light/proximity sensor on bit-banged I2C, as downstream
+	 * (i2c@23: SDA GPIO 23, SCL GPIO 16)
+	 */
+	i2c-sensors {
+		compatible = "i2c-gpio";
+		sda-gpios = <&tlmm 23 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+
+		pinctrl-0 = <&sensors_i2c_default>;
+		pinctrl-names = "default";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		light-sensor@18 {
+			compatible = "capella,cm36651";
+			reg = <0x18>;
+
+			interrupts-extended = <&tlmm 65 IRQ_TYPE_EDGE_FALLING>;
+
+			/* downstream cm36651,vdd_en-gpio (the sensor's and its IR LED's supply) */
+			vled-supply = <&reg_prox_en>;
+
+			pinctrl-0 = <&prox_int_default>;
+			pinctrl-names = "default";
+		};
+
+		led-controller@30 {
+			compatible = "panasonic,an30259a";
+			reg = <0x30>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			led@1 {
+				reg = <1>;
+				function = LED_FUNCTION_STATUS;
+				color = <LED_COLOR_ID_RED>;
+			};
+
+			led@2 {
+				reg = <2>;
+				function = LED_FUNCTION_STATUS;
+				color = <LED_COLOR_ID_GREEN>;
+			};
+
+			led@3 {
+				reg = <3>;
+				function = LED_FUNCTION_STATUS;
+				color = <LED_COLOR_ID_BLUE>;
+			};
+		};
+	};
+
+	/* The capacitive menu and back keys: Cypress, on bit-banged I2C (downstream i2c@21) */
+	i2c-touchkey {
+		compatible = "i2c-gpio";
+		sda-gpios = <&tlmm 114 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 66 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+
+		pinctrl-0 = <&touchkey_i2c_default>;
+		pinctrl-names = "default";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		touchkey@20 {
+			/* Samsung's Cypress touch key firmware, as on the Galaxy S III (downstream S3) */
+			compatible = "cypress,midas-touchkey";
+			reg = <0x20>;
+
+			interrupts-extended = <&tlmm 49 IRQ_TYPE_EDGE_FALLING>;
+
+			vcc-supply = <&reg_touchkey_vcc>;
+			vdd-supply = <&reg_touchkey_led>;
+			vddio-supply = <&pm8226_lvs1>;
+
+			/* downstream cypress,tkey-keycodes = <158 139> */
+			linux,keycodes = <KEY_BACK KEY_MENU>;
+
+			pinctrl-0 = <&touchkey_int_default>;
+			pinctrl-names = "default";
+		};
+	};
+
+	reg_prox_en: regulator-prox-en {
+		compatible = "regulator-fixed";
+		regulator-name = "prox_en";
+		gpio = <&tlmm 110 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8226_l19>;
+	};
+
+	/* downstream vdd_en-gpio of the touch key controller */
+	reg_touchkey_vcc: regulator-touchkey-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "touchkey_vcc";
+		gpio = <&tlmm 67 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/* downstream vdd_led-gpio: the keys' backlight, switched with the LED */
+	reg_touchkey_led: regulator-touchkey-led {
+		compatible = "regulator-fixed";
+		regulator-name = "touchkey_led";
+		gpio = <&tlmm 56 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/*
+	 * The vibrator: a DRV2603 haptic driver, enabled by GPIO 111. Downstream feeds its PWM input
+	 * with 25 kHz at 90 % on GPIO 33; held high here (full strength).
+	 */
+	vibrator {
+		compatible = "gpio-vibrator";
+		enable-gpios = <&tlmm 111 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&vibrator_default>;
+		pinctrl-names = "default";
+	};
+
 	reg_vdd_tsp: regulator-vdd-tsp {
 		compatible = "regulator-fixed";
 		regulator-name = "tsp_3p3v";
@@ -703,6 +827,53 @@ &sdhc_2 {
 };
 
 &tlmm {
+	sensors_i2c_default: sensors-i2c-default-state {
+		pins = "gpio16", "gpio23";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	prox_int_default: prox-int-default-state {
+		pins = "gpio65";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	touchkey_i2c_default: touchkey-i2c-default-state {
+		pins = "gpio66", "gpio114";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	touchkey_int_default: touchkey-int-default-state {
+		pins = "gpio49";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	vibrator_default: vibrator-default-state {
+		enable-pins {
+			pins = "gpio111";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+			output-low;
+		};
+
+		/* the DRV2603's PWM input: high, full strength */
+		pwm-pins {
+			pins = "gpio33";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+			output-high;
+		};
+	};
+
 	gpio_hall_sensor_default: gpio-hall-sensor-default-state {
 		pins = "gpio50";
 		function = "gpio";
@@ -1021,3 +1192,19 @@ codec {
 		};
 	};
 };
+
+/*
+ * The PM8226 charger: limits as downstream (msm-pm8226.dtsi qcom,charger, not overridden for the
+ * s3ve3g: vddmax 4200 mV, vbatdet delta 100 mV, vinmin 4300 mV, ibatmax 1500 mA) for its 2100 mAh
+ * battery
+ */
+&smbb {
+	qcom,fast-charge-safe-current = <1500000>;
+	qcom,fast-charge-current-limit = <1500000>;
+	qcom,fast-charge-safe-voltage = <4200000>;
+	qcom,fast-charge-high-threshold-voltage = <4200000>;
+	qcom,auto-recharge-threshold-voltage = <4100000>;
+	qcom,minimum-input-voltage = <4300000>;
+
+	status = "okay";
+};
-- 
2.56.0


From 7c56be5e032383d4de2772431a043fb6cfc49cf6 Mon Sep 17 00:00:00 2001
From: David Wales <daviewales@disroot.org>
Date: Wed, 22 Jul 2026 00:00:20 +1000
Subject: [PATCH 42/43] ARM: dts: qcom: msm8226-motorola-titan: Enable WiFi

Enable WiFi for motorola-titan, supported by existing driver for
WCN3620.

regulator-always-on for l8 prevents bootloops.
Downstream, l8 is the vdd_pronto_pll-supply property of the
qcom,pil-pronto node, but it's not clear how this fits into the mainline
qcom,pronto-v2-pil schema, so using regulator-always-on for now.

Signed-off-by: David Wales <daviewales@disroot.org>
(cherry picked from commit f010028b7cad2307d1283d7066611ee50c7f18e3)
---
 .../boot/dts/qcom/msm8226-motorola-titan.dts  | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts b/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts
index 79cc5704aa09..e59e6c73c64c 100644
--- a/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts
+++ b/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts
@@ -209,6 +209,7 @@ pm8226_l7: l7 {
 		pm8226_l8: l8 {
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
 		};
 
 		pm8226_l9: l9 {
@@ -354,6 +355,30 @@ &usb_hs_phy {
 	v3p3-supply = <&pm8226_l20>;
 };
 
+&pronto {
+	vddmx-supply = <&pm8226_l3>;
+	vddpx-supply = <&pm8226_l6>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&wcnss_pin_a>;
+
+	status = "okay";
+
+	iris {
+		compatible = "qcom,wcn3620";
+		vddxo-supply = <&pm8226_l10>;
+		vddrfa-supply = <&pm8226_l24>;
+		vddpa-supply = <&pm8226_l16>;
+		vdddig-supply = <&pm8226_l24>;
+	};
+
+	smd-edge {
+		wcnss {
+			status = "okay";
+		};
+	};
+};
+
 &tlmm {
 	reg_lcd_default: reg-lcd-default-state {
 		pins = "gpio12", "gpio13";
@@ -369,4 +394,11 @@ sdhc2_cd_default: sdhc2-cd-default-state {
 		drive-strength = <2>;
 		bias-pull-up;
 	};
+
+	wcnss_pin_a: wcnss-pin-active-state {
+		pins =  "gpio40", "gpio41", "gpio42", "gpio43", "gpio44";
+		function = "wlan";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
 };
-- 
2.56.1


From 49a12dccd1ec3c517fa2508b6e333bb0185f52d1 Mon Sep 17 00:00:00 2001
From: David Wales <daviewales@disroot.org>
Date: Sun, 2 Aug 2026 23:05:50 +1000
Subject: [PATCH 43/43] ARM: dts: qcom: msm8226-motorola-titan: Enable
 touchscreen

Enable the Synaptics RMI4 I2C touchscreen for motorola-titan.

Signed-off-by: David Wales <daviewales@disroot.org>
(cherry picked from commit 57a693c8bfc6ba8dd9f737b10b8fff2c6d3484c8)
---
 .../boot/dts/qcom/msm8226-motorola-titan.dts  | 62 +++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts b/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts
index e59e6c73c64c..78355f7df367 100644
--- a/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts
+++ b/arch/arm/boot/dts/qcom/msm8226-motorola-titan.dts
@@ -84,6 +84,19 @@ vddio_disp_vreg: regulator-vddio-disp {
 		regulator-boot-on;
 	};
 
+	vdd_touch_vreg: regulator-vdd-touch {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_touch";
+
+		gpio = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <300>;
+		enable-active-high;
+		regulator-pull-down;
+
+		pinctrl-0 = <&tp_avdd_en_default_state>;
+		pinctrl-names = "default";
+	};
+
 	reserved-memory {
 		#address-cells = <1>;
 		#size-cells = <1>;
@@ -146,6 +159,39 @@ reg_lcd_neg: outn {
 	};
 };
 
+&blsp1_i2c5 {
+	status = "okay";
+
+	touchscreen@20 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x20>;
+
+		interrupts-extended = <&tlmm 17 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
+
+		vdd-supply = <&vdd_touch_vreg>;
+		vio-supply = <&pm8226_lvs1>;
+
+		pinctrl-0 = <&touch_pin>;
+		pinctrl-names = "default";
+
+		syna,startup-delay-ms = <100>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f01@1 {
+			reg = <0x1>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f11@11 {
+			reg = <0x11>;
+			syna,sensor-type = <1>;
+		};
+	};
+};
+
 &pm8226_vib {
 	status = "okay";
 };
@@ -388,6 +434,14 @@ reg_lcd_default: reg-lcd-default-state {
 		output-high;
 	};
 
+	touch_pin: touch-state {
+		pins = "gpio17";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	sdhc2_cd_default: sdhc2-cd-default-state {
 		pins = "gpio38";
 		function = "gpio";
@@ -401,4 +455,12 @@ wcnss_pin_a: wcnss-pin-active-state {
 		drive-strength = <2>;
 		bias-pull-up;
 	};
+
+	tp_avdd_en_default_state: touch-avdd-en-pin-default-state {
+		pins = "gpio73";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		output-high;
+	};
 };
-- 
2.56.1


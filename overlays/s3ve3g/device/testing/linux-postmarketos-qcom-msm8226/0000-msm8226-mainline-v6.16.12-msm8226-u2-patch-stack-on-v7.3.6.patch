+static uint64_t getMsTime(void)
+{
+	struct timespec ts;
+	uint64_t ret;
+
+	getnstimeofday(&ts);
+
+	/* convert nsec to msec */
+	ret = ts.tv_nsec;
+	do_div(ret, 1000000UL);
+
+	/* add in sec */
+	return ret + ts.tv_sec * 1000ULL;
+}

From: nura-builds
Subject: [PATCH] soc: qcom: spm: CPU rail regulator through the MSM8226 L2 SAW2 v2.1

On MSM8226 the four Cortex-A7 cores share one rail, PM8226 S2 (FTS2), and only
the L2/APCS SAW2 has the PMIC arbiter port (SAW2_ID bit 2; the CPU SAWs don't):
a write to its VCTL (port 0) sends the voltage, PMIC_STS shows what was sent.
Data: mV / 10 (S2 in its 10 mV range, 700-2040 mV), as downstream's
spm-regulator. Being shared, the rail is set from any CPU.

Also: don't copy a sequence for SAWs without a sequence RAM offset (it wrote
zeros from offset 0 on, over VCTL), and drop a volt_sel computed with an unset
uV_step (a division by zero, overwritten right after).
---
diff --git a/drivers/soc/qcom/spm.c b/drivers/soc/qcom/spm.c
index f75659f..ef80797 100644
--- a/drivers/soc/qcom/spm.c
+++ b/drivers/soc/qcom/spm.c
@@ -77,6 +77,8 @@ struct spm_reg_data {
 	struct linear_range *range;
 	unsigned int ramp_delay;
 	unsigned int init_uV;
+	/* the SAW drives a rail shared by all CPUs: VCTL can be written from any of them */
+	bool shared_rail;
 };
 
 struct spm_driver_data {
@@ -85,6 +87,7 @@ struct spm_driver_data {
 	struct device *dev;
 	unsigned int volt_sel;
 	int reg_cpu;
+	int vdd_err;
 };
 
 static const u16 spm_reg_offset_v4_1[SPM_REG_NR] = {
@@ -194,6 +197,33 @@ static const u16 spm_reg_offset_v2_1[SPM_REG_NR] = {
 	[SPM_REG_SEQ_ENTRY]	= 0x80,
 };
 
+static void spm_set_vdd_v2_1(void *data);
+
+/*
+ * The 8226 L2/APCS SAW: the only SAW2 with the PMIC arbiter port (SAW2_ID bit 2), driving
+ * the CPU rail, PM8226 S2 (FTS2) in its 10 mV range (700-2040 mV, data = mV / 10).
+ * The SPM sequencer stays off; VCTL alone sends the voltage.
+ */
+static const u16 spm_reg_offset_v2_1_l2[SPM_REG_NR] = {
+	[SPM_REG_PMIC_STS]	= 0x14,
+	[SPM_REG_RST]		= 0x18,
+	[SPM_REG_VCTL]		= 0x1c,
+};
+
+static struct linear_range spm_8226_l2_regulator_range =
+	REGULATOR_LINEAR_RANGE(700000, 70, 135, 10000);
+
+static const struct spm_reg_data spm_reg_8226_l2 = {
+	.reg_offset = spm_reg_offset_v2_1_l2,
+	.set_vdd = spm_set_vdd_v2_1,
+	.range = &spm_8226_l2_regulator_range,
+	/* the bootloader's S2 voltage */
+	.init_uV = 1150000,
+	/* S2 step control 0x81: 19.2 MHz * 10 mV / (8 << 1), 80 % margin (downstream) */
+	.ramp_delay = 9600,
+	.shared_rail = true,
+};
+
 /* SPM register data for 8974, 8084 */
 static const struct spm_reg_data spm_reg_8974_8084_cpu  = {
 	.reg_offset = spm_reg_offset_v2_1,
@@ -308,6 +338,11 @@ static int spm_set_voltage_sel(struct regulator_dev *rdev, unsigned int selector
 
 	drv->volt_sel = selector;
 
+	if (drv->reg_data->shared_rail) {
+		drv->reg_data->set_vdd(drv);
+		return drv->vdd_err;
+	}
+
 	/* Always do the SAW register writes on the corresponding CPU */
 	return smp_call_function_single(drv->reg_cpu, drv->reg_data->set_vdd, drv, true);
 }
@@ -385,6 +420,29 @@ static void smp_set_vdd_v1_1(void *data)
 	}
 }
 
+/* SAW2 v2.1 with the PMIC arbiter (8226 L2): VCTL, port 0; PMIC_STS shows what was sent */
+static void spm_set_vdd_v2_1(void *data)
+{
+	struct spm_driver_data *drv = data;
+	unsigned int vlevel = drv->volt_sel;
+	u32 vctl, sts;
+
+	/* Kick the state machine back to idle */
+	spm_register_write(drv, SPM_REG_RST, 1);
+
+	vctl = spm_register_read(drv, SPM_REG_VCTL);
+	vctl &= ~(GENMASK(18, 16) | SPM_VCTL_VLVL);
+	vctl |= FIELD_PREP(SPM_VCTL_VLVL, vlevel);
+	spm_register_write(drv, SPM_REG_VCTL, vctl);
+
+	drv->vdd_err = read_poll_timeout_atomic(spm_register_read, sts,
+						(sts & 0xff) == vlevel, 1, 200, false,
+						drv, SPM_REG_PMIC_STS);
+	if (drv->vdd_err)
+		dev_err_ratelimited(drv->dev, "timeout setting the voltage (%x %x)!\n",
+				    sts, vlevel);
+}
+
 static int spm_get_cpu(struct device *dev)
 {
 	int cpu;
@@ -440,19 +498,21 @@ static int spm_register_regulator(struct device *dev, struct spm_driver_data *dr
 	rdesc->n_voltages = rdesc->linear_ranges[rdesc->n_linear_ranges - 1].max_sel + 1;
 	rdesc->ramp_delay = drv->reg_data->ramp_delay;
 
-	ret = spm_get_cpu(dev);
-	if (ret < 0)
-		return ret;
+	if (drv->reg_data->shared_rail) {
+		drv->reg_cpu = -1;
+	} else {
+		ret = spm_get_cpu(dev);
+		if (ret < 0)
+			return ret;
 
-	drv->reg_cpu = ret;
-	dev_dbg(dev, "SAW2 bound to CPU %d\n", drv->reg_cpu);
+		drv->reg_cpu = ret;
+		dev_dbg(dev, "SAW2 bound to CPU %d\n", drv->reg_cpu);
+	}
 
 	/*
 	 * Program initial voltage, otherwise registration will also try
 	 * setting the voltage, which might result in undervolting the CPU.
 	 */
-	drv->volt_sel = DIV_ROUND_UP(drv->reg_data->init_uV - rdesc->min_uV,
-				     rdesc->uV_step);
 	ret = linear_range_get_selector_high(drv->reg_data->range,
 					     drv->reg_data->init_uV,
 					     &drv->volt_sel,
@@ -463,7 +523,10 @@ static int spm_register_regulator(struct device *dev, struct spm_driver_data *dr
 	}
 
 	/* Always do the SAW register writes on the corresponding CPU */
-	smp_call_function_single(drv->reg_cpu, drv->reg_data->set_vdd, drv, true);
+	if (drv->reg_data->shared_rail)
+		drv->reg_data->set_vdd(drv);
+	else
+		smp_call_function_single(drv->reg_cpu, drv->reg_data->set_vdd, drv, true);
 
 	rdev = devm_regulator_register(dev, rdesc, &config);
 	if (IS_ERR(rdev)) {
@@ -481,6 +544,8 @@ static const struct of_device_id spm_match_table[] = {
 	  .data = &spm_reg_660_silver_l2 },
 	{ .compatible = "qcom,msm8226-saw2-v2.1-cpu",
 	  .data = &spm_reg_8226_cpu },
+	{ .compatible = "qcom,msm8226-saw2-v2.1-l2",
+	  .data = &spm_reg_8226_l2 },
 	{ .compatible = "qcom,msm8909-saw2-v3.0-cpu",
 	  .data = &spm_reg_8909_cpu },
 	{ .compatible = "qcom,msm8916-saw2-v3.0-cpu",
@@ -527,10 +592,15 @@ static int spm_dev_probe(struct platform_device *pdev)
 	drv->dev = &pdev->dev;
 	platform_set_drvdata(pdev, drv);
 
-	/* Write the SPM sequences first.. */
-	addr = drv->reg_base + drv->reg_data->reg_offset[SPM_REG_SEQ_ENTRY];
-	__iowrite32_copy(addr, drv->reg_data->seq,
-			ARRAY_SIZE(drv->reg_data->seq) / 4);
+	/*
+	 * Write the SPM sequences first.. (not without a sequence RAM offset: that would write
+	 * zeros to the registers from 0, VCTL among them)
+	 */
+	if (drv->reg_data->reg_offset[SPM_REG_SEQ_ENTRY]) {
+		addr = drv->reg_base + drv->reg_data->reg_offset[SPM_REG_SEQ_ENTRY];
+		__iowrite32_copy(addr, drv->reg_data->seq,
+				 ARRAY_SIZE(drv->reg_data->seq) / 4);
+	}
 
 	/*
 	 * ..and then the control registers.

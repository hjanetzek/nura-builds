From a7feeebb8a5fc6220e2e873403786f6236f3ddfd Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Fri, 20 Nov 2026 14:25:32 +0100
Subject: [PATCH] iio: adc: qcom-spmi-iadc: microamperes, and the sign

The raw value is the sense voltage in microvolts over the sense resistor in
micro-ohms: amperes, reported as microamperes, so every current below 1 A
read 0. Scale it to microamperes. The offset-corrected value was unsigned
16 bits: a current the other way wrapped. Keep it signed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/iio/adc/qcom-spmi-iadc.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/iio/adc/qcom-spmi-iadc.c b/drivers/iio/adc/qcom-spmi-iadc.c
index 0ec3a0c4b1de..d560660d3294 100644
--- a/drivers/iio/adc/qcom-spmi-iadc.c
+++ b/drivers/iio/adc/qcom-spmi-iadc.c
@@ -10,6 +10,7 @@
 #include <linux/iio/iio.h>
 #include <linux/interrupt.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
 #include <linux/mutex.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -312,7 +313,8 @@ static int iadc_read_raw(struct iio_dev *indio_dev,
 {
 	struct iadc_chip *iadc = iio_priv(indio_dev);
 	s32 isense_ua, vsense_uv;
-	u16 adc_raw, vsense_raw;
+	u16 adc_raw;
+	s32 vsense_raw;
 	int ret;
 
 	switch (mask) {
@@ -323,12 +325,14 @@ static int iadc_read_raw(struct iio_dev *indio_dev,
 		if (ret < 0)
 			return ret;
 
-		vsense_raw = adc_raw - iadc->offset[chan->channel];
+		/* signed: the current flows both ways */
+		vsense_raw = (s32)adc_raw - iadc->offset[chan->channel];
 
 		vsense_uv = vsense_raw * IADC_REF_GAIN_MICRO_VOLTS;
 		vsense_uv /= (s32)iadc->gain - iadc->offset[chan->channel];
 
-		isense_ua = vsense_uv / iadc->rsense[chan->channel];
+		/* microvolts over micro-ohms are amperes: scale to microamperes */
+		isense_ua = div_s64((s64)vsense_uv * 1000000, iadc->rsense[chan->channel]);
 
 		dev_dbg(iadc->dev, "off %d gain %d adc %d %duV I %duA\n",
 			iadc->offset[chan->channel], iadc->gain,
-- 
2.56.0


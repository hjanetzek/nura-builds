aae5e5c50beb1df5629215b441473925b2a9ad504035a26a708ddcd04e7ed4866b3dea89c56ae56f9507356c0bfa716302dafdf05414d869eb5336ace348a501  config-postmarketos-qcom-msm8226.armv7
0cd11621cda8960afc55d25af73b778fffcf3321168ff8b5e51e82455682baa71f5867f365e3698ef8f2d79ccb1c474ef1faf59bece147c9b0b5595a47bd6be3  0001-ARM-dts-qcom-msm8226-samsung-s3ve3g-full-device-tree.patch

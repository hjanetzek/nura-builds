# nura-builds overlay (targets/s3ve3g.sh): pmaports' recipe at 6b904fc480
# (6.16.12-r4), copied over the pmaports recipe by scripts/setup.sh. Changes are marked
# "nura-builds:": the Samsung Galaxy S III Neo's device tree (eMMC, SD card, USB, keys, touch,
# sensors, Wi-Fi, splash framebuffer; it had the serial port only), the ALSA sequencer, the
# YAS532 magnetometer and the Terminus 16x32 console font in the config; an early console into
# a RAM buffer (earlycon=ramcon,<address>: the log until a reset, read from TWRP as /proc/last_kmsg).
# The device options are built in (CONFIG_CMDLINE, appended to the bootloader's): Samsung's
# bootloader adds ~840 characters and refuses more than 1024 in total. Only for the S III Neo:
# earlycon=ramcon writes to RAM at 0x1FB00000.
# Co-Maintainer: Luca Weiss <luca@lucaweiss.eu>
maintainer="Stefan Hansson <newbyte@postmarketos.org>"
_flavor="postmarketos-qcom-msm8226"
pkgname=linux-$_flavor
pkgver=6.16.12
# nura-builds: pmaports' pkgrel + 100, above the published package (+1: Terminus 16x32 font, +1: reserved memory as downstream,
# +1: ramoops, +1: earlycon ramcon, +1: dt.img with soc_rev,
# +1: debug boot markers, +1: free space in the DTB,
# +1: built-in command line)
pkgrel=112
pkgdesc="Mainline Kernel fork for APQ8026/MSM8226/MSM8926 devices"
arch="armv7"
_carch="arm"
url="https://github.com/msm8226-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"

_config="config-$_flavor.$arch"
_tag="v${pkgver/_/-}-msm8226-u2"

# Source
source="
	https://github.com/msm8226-mainline/linux/archive/$_tag/linux-$_tag.tar.gz
	$_config
	0001-ARM-dts-qcom-msm8226-samsung-s3ve3g-full-device-tree.patch
	0002-serial-earlycon-ramcon-early-console-into-a-RAM-buffer.patch
	0003-ARM-s3ve3g-debug-boot-markers-in-the-RAM-log-buffer.patch
	0004-ARM-COMMAND_LINE_SIZE-2048.patch
	mkqcdt-v1.py
"
builddir="$srcdir/linux-${_tag#v}"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
	# nura-builds: the options added to the config with their dependencies resolved
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm "$pkgdir"/usr/lib/modules/*/build

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release

	# nura-builds: the S III Neo's QCDT table (deviceinfo_bootimg_qcdt without a type: boot-deploy
	# takes /boot/dt.img), version 1 with soc_rev as the downstream build makes it
	python3 "$srcdir"/mkqcdt-v1.py "$pkgdir"/boot/dt.img \
		"$pkgdir"/boot/dtbs/qcom-msm8226-samsung-s3ve3g.dtb
}


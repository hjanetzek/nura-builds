b02d9b82668ce9090c089f9a584e96e024346ad100c9efb4849bebf9d407c80b339352601d703d1584f50c8f2860a5d9486d7e13bf6c53ae515c92f6b2c2d7c9  config-postmarketos-qcom-msm8226.armv7
c89106dad68c6028036f491dae22eed36bbe8bcf6175068a5ca24f3bc244729c63be33f59473f02e693efb810514025b22c2bc31cb53085440dfa2e39e61c9a9  0001-ARM-dts-qcom-msm8226-samsung-s3ve3g-full-device-tree.patch

# nura-builds overlay (targets/s3ve3g.sh): pmaports' recipe at 6b904fc480
# (6.16.12-r4), copied over the pmaports recipe by scripts/setup.sh. Since 7.3.4: mainline (kernel.org)
# with msm8226-mainline's patch stack (its 56 commits on top of v6.16.12 in tag v6.16.12-msm8226-u2,
# ported to v7.3.4: patch 0000, one mbox with the commits), as msm8226-mainline has no newer branch. Changes are marked
# "nura-builds:": the Samsung Galaxy S III Neo's device tree (eMMC, SD card, USB, keys, touch,
# sensors, Wi-Fi, splash framebuffer; it had the serial port only), the ALSA sequencer, the
# YAS532 magnetometer and the Terminus 16x32 console font in the config; an early console into
# a RAM buffer (earlycon=ramcon,<address>: the log until a reset, read from TWRP as /proc/last_kmsg).
# The device options are built in (CONFIG_CMDLINE, appended to the bootloader's): Samsung's
# bootloader adds ~840 characters and refuses more than 1024 in total. Only for the S III Neo:
# earlycon=ramcon writes to RAM at 0x1FB00000. The USB switch (extcon-sm5502 on i2c-gpio) is built in:
# as modules it probed after the initramfs's USB gadget setup, which found no UDC and gave up.
# MODULE_ALLOW_BTF_MISMATCH: rebuilt kernels (pmbootstrap build --force, same version) load the
# modules installed with an earlier build. simpledrm built in: it holds the splash framebuffer's
# clocks and power domain from early on, and the console is on the screen before the initramfs.
# Co-Maintainer: Luca Weiss <luca@lucaweiss.eu>
maintainer="Stefan Hansson <newbyte@postmarketos.org>"
_flavor="postmarketos-qcom-msm8226"
pkgname=linux-$_flavor
pkgver=7.3.4
# nura-builds: pkgrel + 100 as for pmaports' 6.16.12 (pmaports has no 7.3.4 yet)
pkgrel=100
pkgdesc="Mainline Kernel fork for APQ8026/MSM8226/MSM8926 devices"
arch="armv7"
_carch="arm"
url="https://github.com/msm8226-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"

_config="config-$_flavor.$arch"

# Source
source="
	https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$pkgver.tar.xz
	$_config
	0000-msm8226-mainline-v6.16.12-msm8226-u2-patch-stack-on-v7.3.4.patch
	0001-ARM-dts-qcom-msm8226-samsung-s3ve3g-full-device-tree.patch
	0002-serial-earlycon-ramcon-early-console-into-a-RAM-buffer.patch
	0004-ARM-COMMAND_LINE_SIZE-2048.patch
	0007-ARM-dts-qcom-msm8226-samsung-s3ve3g-level-wcnss-wifi-IRQs.patch
	mkqcdt-v1.py
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
	# nura-builds: the options added to the config with their dependencies resolved
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"

	# nura-builds: the zImage is loaded at 0x8000, where the kernel goes; its decompressor first
	# copies itself past the end of the decompressed kernel, and that copy must end below the device
	# tree, which the bootloader puts at 0x01e00000 (deviceinfo_flash_offset_tags). 7.3.4 with BTF
	# (4.3 MB more) ran over it and hung at the boot logo; 6.16.12 had 0.7 MB to spare.
	local _end=$((0x8000 + $(stat -c %s arch/arm/boot/Image) + $(stat -c %s arch/arm/boot/zImage) + 0x40000))
	if [ $_end -ge $((0x01e00000)) ]; then
		printf "zImage relocation would end at %#x, over the DTB at 0x01e00000\n" $_end >&2
		return 1
	fi
	printf "zImage relocation ends at %#x (DTB at 0x01e00000)\n" $_end
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm "$pkgdir"/usr/lib/modules/*/build

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release

	# nura-builds: the S III Neo's QCDT table (deviceinfo_bootimg_qcdt without a type: boot-deploy
	# takes /boot/dt.img), version 1 with soc_rev as the downstream build makes it
	python3 "$srcdir"/mkqcdt-v1.py "$pkgdir"/boot/dt.img \
		"$pkgdir"/boot/dtbs/qcom-msm8226-samsung-s3ve3g.dtb
}


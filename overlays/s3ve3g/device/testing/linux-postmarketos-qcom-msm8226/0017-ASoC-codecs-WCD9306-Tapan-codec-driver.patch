+
+static int slim_rx_mux_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *w = snd_soc_dapm_kcontrol_widget(kc);
+	struct tapan_priv *tapan = dev_get_drvdata(w->dapm->dev);
+
+	ucontrol->value.enumerated.item[0] = tapan->rx_port_value[w->shift];
+
+	return 0;
+}
+
+static int slim_rx_mux_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *w = snd_soc_dapm_kcontrol_widget(kc);
+	struct tapan_priv *tapan = dev_get_drvdata(w->dapm->dev);
+	struct soc_enum *e = (struct soc_enum *)kc->private_value;
+	u32 port_id = w->shift;
+	unsigned int val = ucontrol->value.enumerated.item[0];
+
+	if (port_id >= TAPAN_RX_MAX || val >= e->items)
+		return -EINVAL;
+
+	/* a write that changes nothing must not add the channel to a list twice */
+	if (tapan->rx_port_value[port_id] == val)
+		return 0;
+
+	tapan->rx_port_value[port_id] = val;
+
+	/* a port belongs to one interface at a time */
+	list_del_init(&tapan->rx_chs[port_id].list);
+
+	switch (val) {
+	case 0:
+		break;
+	case 1:
+		list_add_tail(&tapan->rx_chs[port_id].list, &tapan->dai[AIF1_PB].wcd9xxx_ch_list);
+		break;
+	case 2:
+		list_add_tail(&tapan->rx_chs[port_id].list, &tapan->dai[AIF2_PB].wcd9xxx_ch_list);
+		break;
+	case 3:
+		list_add_tail(&tapan->rx_chs[port_id].list, &tapan->dai[AIF3_PB].wcd9xxx_ch_list);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	snd_soc_dapm_mux_update_power(w->dapm, kc, val, e, NULL);
+
+	return 1;
+}

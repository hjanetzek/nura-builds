From: s3ve3g bring-up
Subject: [PATCH] ASoC: codecs: WCD9306 (Tapan) codec driver

Ported from the downstream msm-3.4 wcd9306.c (as Samsung built it, without MBHC), wcd9xxx-resmgr.c,
wcd9xxx-common.c (class H) and wcd9xxx-core.c; SLIMbus streams in the style of wcd9335.c and the
Xperia Z2 project's WCD9320 port.
---
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -2227,6 +2227,15 @@ config SND_SOC_UDA1380
 config SND_SOC_WCD_CLASSH
 	tristate
 
+config SND_SOC_WCD9306
+	tristate "WCD9306 (Tapan) Codec"
+	depends on SLIMBUS
+	select REGMAP_SLIMBUS
+	select REGMAP_IRQ
+	help
+	  The WCD9306 (Tapan) is the SLIMbus audio codec of MSM8226 phones
+	  such as the Samsung Galaxy S III Neo.
+
 config SND_SOC_WCD9335
 	tristate "WCD9335 Codec"
 	depends on SLIMBUS
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -339,6 +339,7 @@ snd-soc-uda1342-y := uda1342.o
 snd-soc-uda1380-y := uda1380.o
 snd-soc-wcd-classh-y := wcd-clsh-v2.o
 snd-soc-wcd-mbhc-y := wcd-mbhc-v2.o
+snd-soc-wcd9306-y := wcd9306.o wcd9306-clsh.o
 snd-soc-wcd9335-y := wcd9335.o
 snd-soc-wcd934x-y := wcd934x.o
 snd-soc-wcd937x-y := wcd937x.o
@@ -760,6 +761,7 @@ obj-$(CONFIG_SND_SOC_UDA1342)	+= snd-soc-uda1342.o
 obj-$(CONFIG_SND_SOC_UDA1380)	+= snd-soc-uda1380.o
 obj-$(CONFIG_SND_SOC_WCD_CLASSH)	+= snd-soc-wcd-classh.o
 obj-$(CONFIG_SND_SOC_WCD_MBHC)	+= snd-soc-wcd-mbhc.o
+obj-$(CONFIG_SND_SOC_WCD9306)	+= snd-soc-wcd9306.o
 obj-$(CONFIG_SND_SOC_WCD9335)	+= snd-soc-wcd9335.o
 obj-$(CONFIG_SND_SOC_WCD934X)	+= snd-soc-wcd934x.o
 obj-$(CONFIG_SND_SOC_WCD937X)	+= snd-soc-wcd937x.o
--- /dev/null
+++ b/sound/soc/codecs/wcd9306-clsh.c
@@ -0,0 +1,703 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Class-H controller, buck and charge pump (NCP) state machine of the WCD9306 (Tapan).
+ *
+ * Ported from the downstream msm-3.4 sound/soc/codecs/wcd9xxx-common.c,
+ * Copyright (c) 2012-2014, The Linux Foundation. All rights reserved.
+ * The register sequences and delays are downstream's; left out are the headphone impedance
+ * tables (MBHC) and the register save/restore helpers, which Tapan's class-H doesn't use.
+ */
+
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <sound/soc.h>
+
+#include "wcd9306-clsh.h"
+#include "wcd9306-regs.h"
+
+#define CLSH_COMPUTE_EAR	0x01
+#define CLSH_COMPUTE_HPH_L	0x02
+#define CLSH_COMPUTE_HPH_R	0x03
+
+#define BUCK_VREF_2V		0xFF
+#define BUCK_VREF_1P8V		0xE6
+
+#define BUCK_SETTLE_TIME_US	50
+#define NCP_SETTLE_TIME_US	50
+
+struct wcd9306_clsh_reg_mask_val {
+	u16 reg;
+	u8 mask;
+	u8 val;
+};
+
+typedef void (*wcd9306_clsh_state_fn)(struct snd_soc_component *,
+				      struct wcd9306_clsh_data *, u8 req_state, bool is_enable);
+
+static void wcd9306_clsh_write_set(struct snd_soc_component *c,
+				   const struct wcd9306_clsh_reg_mask_val *set, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		snd_soc_component_update_bits(c, set[i].reg, set[i].mask, set[i].val);
+}
+
+static void wcd9xxx_enable_clsh_block(struct snd_soc_component *c,
+				      struct wcd9306_clsh_data *clsh_d, bool enable)
+{
+	if ((enable && ++clsh_d->clsh_users == 1) ||
+	    (!enable && --clsh_d->clsh_users == 0))
+		snd_soc_component_update_bits(c, WCD9XXX_A_CDC_CLSH_B1_CTL, 0x01,
+					      enable ? 0x01 : 0x00);
+	dev_dbg(c->dev, "%s: clsh_users %d, enable %d", __func__, clsh_d->clsh_users, enable);
+}
+
+static void wcd9xxx_enable_anc_delay(struct snd_soc_component *c, bool on)
+{
+	snd_soc_component_update_bits(c, WCD9XXX_A_CDC_CLSH_B1_CTL, 0x02, on ? 0x02 : 0x00);
+}
+
+static void wcd9xxx_enable_buck(struct snd_soc_component *c,
+				struct wcd9306_clsh_data *clsh_d, bool enable)
+{
+	if ((enable && ++clsh_d->buck_users == 1) ||
+	    (!enable && --clsh_d->buck_users == 0))
+		snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_1, 0x80,
+					      enable ? 0x80 : 0x00);
+	dev_dbg(c->dev, "%s: buck_users %d, enable %d", __func__, clsh_d->buck_users, enable);
+}
+
+static void wcd9xxx_cfg_clsh_param_common(struct snd_soc_component *c)
+{
+	static const struct wcd9306_clsh_reg_mask_val reg_set[] = {
+		{WCD9XXX_A_CDC_CLSH_BUCK_NCP_VARS, 0x3 << 0, 0},
+		{WCD9XXX_A_CDC_CLSH_BUCK_NCP_VARS, 0x3 << 2, 1 << 2},
+		{WCD9XXX_A_CDC_CLSH_BUCK_NCP_VARS, (0x1 << 4), 0},
+		{WCD9XXX_A_CDC_CLSH_B2_CTL, (0x3 << 0), 0x01},
+		{WCD9XXX_A_CDC_CLSH_B2_CTL, (0x3 << 2), (0x01 << 2)},
+		{WCD9XXX_A_CDC_CLSH_B2_CTL, (0xf << 4), (0x03 << 4)},
+		{WCD9XXX_A_CDC_CLSH_B3_CTL, (0xf << 4), (0x03 << 4)},
+		{WCD9XXX_A_CDC_CLSH_B3_CTL, (0xf << 0), (0x0B)},
+		{WCD9XXX_A_CDC_CLSH_B1_CTL, (0x1 << 5), (0x01 << 5)},
+		{WCD9XXX_A_CDC_CLSH_B1_CTL, (0x1 << 1), (0x01 << 1)},
+	};
+
+	wcd9306_clsh_write_set(c, reg_set, ARRAY_SIZE(reg_set));
+}
+
+/* downstream counted the charge pump users in a function static; here in the clsh data */
+static void wcd9xxx_chargepump_request(struct snd_soc_component *c,
+				       struct wcd9306_clsh_data *clsh_d, bool on)
+{
+	if (on && (++clsh_d->cp_users == 1)) {
+		snd_soc_component_update_bits(c, WCD9XXX_A_CDC_CLK_OTHR_CTL, 0x01, 0x01);
+		dev_dbg(c->dev, "%s: charge pump enabled\n", __func__);
+	} else if (!on) {
+		if (--clsh_d->cp_users < 0) {
+			dev_warn(c->dev, "%s: unbalanced disable of the charge pump\n", __func__);
+			clsh_d->cp_users = 0;
+		}
+		if (clsh_d->cp_users == 0) {
+			snd_soc_component_update_bits(c, WCD9XXX_A_CDC_CLK_OTHR_CTL, 0x01, 0x00);
+			dev_dbg(c->dev, "%s: charge pump disabled\n", __func__);
+		}
+	}
+}
+
+/*
+ * Downstream set the HPH compute bits through the resource manager's conditional update list
+ * (WCD9XXX_COND_HPH), which MBHC registers to hold them off while it measures. Without MBHC
+ * the condition is never registered and the resource manager writes the bit straight away
+ * (set on add, cleared on remove): the same as a plain update here.
+ */
+static void wcd9xxx_clsh_comp_req(struct snd_soc_component *c,
+				  struct wcd9306_clsh_data *clsh_d, int compute_pa, bool on)
+{
+	u8 shift;
+
+	if (compute_pa == CLSH_COMPUTE_EAR) {
+		snd_soc_component_update_bits(c, WCD9XXX_A_CDC_CLSH_B1_CTL, 0x10, on ? 0x10 : 0);
+		return;
+	}
+
+	if (compute_pa == CLSH_COMPUTE_HPH_L) {
+		shift = 3;
+	} else if (compute_pa == CLSH_COMPUTE_HPH_R) {
+		shift = 2;
+	} else {
+		dev_dbg(c->dev, "%s: classh computation request is incorrect\n", __func__);
+		return;
+	}
+
+	snd_soc_component_update_bits(c, WCD9XXX_A_CDC_CLSH_B1_CTL, 1 << shift,
+				      on ? 1 << shift : 0);
+}
+
+static void wcd9xxx_dynamic_bypass_buck_ctrl_lo(struct snd_soc_component *c, bool enable)
+{
+	const struct wcd9306_clsh_reg_mask_val reg_set[] = {
+		{WCD9XXX_A_BUCK_MODE_3, (0x1 << 3), (enable << 3)},
+		{WCD9XXX_A_BUCK_MODE_5, enable ? 0xFF : 0x02, 0x02},
+		{WCD9XXX_A_BUCK_MODE_5, 0x1, 0x01}
+	};
+
+	if (!enable) {
+		snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_1, (0x1 << 3), 0x00);
+		snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_4, 0xFF, BUCK_VREF_2V);
+	}
+	wcd9306_clsh_write_set(c, reg_set, ARRAY_SIZE(reg_set));
+
+	/* 50us sleep is required as per the class H HW design sequence */
+	usleep_range(BUCK_SETTLE_TIME_US, BUCK_SETTLE_TIME_US + 10);
+}
+
+static void wcd9xxx_dynamic_bypass_buck_ctrl(struct snd_soc_component *c, bool enable)
+{
+	const struct wcd9306_clsh_reg_mask_val reg_set[] = {
+		{WCD9XXX_A_BUCK_MODE_3, (0x1 << 3), (enable << 3)},
+		{WCD9XXX_A_BUCK_MODE_5, (0x1 << 1), ((!enable) << 1)},
+		{WCD9XXX_A_BUCK_MODE_5, 0x1, !enable}
+	};
+
+	if (!enable) {
+		snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_1, (0x1 << 3), 0x00);
+		snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_4, 0xFF, BUCK_VREF_2V);
+	}
+	wcd9306_clsh_write_set(c, reg_set, ARRAY_SIZE(reg_set));
+
+	/* 50us sleep is required as per the class H HW design sequence */
+	usleep_range(BUCK_SETTLE_TIME_US, BUCK_SETTLE_TIME_US + 10);
+}
+
+static void wcd9xxx_set_buck_mode(struct snd_soc_component *c, u8 buck_vref)
+{
+	const struct wcd9306_clsh_reg_mask_val reg_set[] = {
+		{WCD9XXX_A_BUCK_MODE_5, 0x02, 0x02},
+		{WCD9XXX_A_BUCK_MODE_4, 0xFF, buck_vref},
+		{WCD9XXX_A_BUCK_MODE_1, 0x04, 0x04},
+		{WCD9XXX_A_BUCK_MODE_3, 0x04, 0x00},
+		{WCD9XXX_A_BUCK_MODE_3, 0x08, 0x00},
+	};
+
+	wcd9306_clsh_write_set(c, reg_set, ARRAY_SIZE(reg_set));
+	usleep_range(BUCK_SETTLE_TIME_US, BUCK_SETTLE_TIME_US + 10);
+}
+
+/* called for all states except lineout */
+static void wcd9xxx_clsh_enable_post_pa(struct snd_soc_component *c,
+					struct wcd9306_clsh_data *clsh_d)
+{
+	static const struct wcd9306_clsh_reg_mask_val reg_set[] = {
+		{WCD9XXX_A_BUCK_MODE_5, 0x02, 0x00},
+		{WCD9XXX_A_NCP_STATIC, 0x20, 0x00},
+		{WCD9XXX_A_BUCK_MODE_3, 0x04, 0x04},
+	};
+
+	wcd9306_clsh_write_set(c, reg_set, ARRAY_SIZE(reg_set));
+
+	if (!clsh_d->is_dynamic_vdd_cp)
+		snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_3, 0x08, 0x08);
+}
+
+static void wcd9xxx_set_fclk_get_ncp(struct snd_soc_component *c,
+				     struct wcd9306_clsh_data *clsh_d,
+				     enum wcd9306_ncp_fclk_level fclk_level)
+{
+	clsh_d->ncp_users[fclk_level]++;
+
+	snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x10, 0x00);
+	/* fclk level 8 dominates level 5 */
+	if (clsh_d->ncp_users[NCP_FCLK_LEVEL_8] > 0)
+		snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x0F, 0x08);
+	else if (clsh_d->ncp_users[NCP_FCLK_LEVEL_5] > 0)
+		snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x0F, 0x05);
+	else
+		WARN_ONCE(1, "Unexpected users %d,%d\n", clsh_d->ncp_users[NCP_FCLK_LEVEL_8],
+			  clsh_d->ncp_users[NCP_FCLK_LEVEL_5]);
+	snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x20, 0x20);
+
+	/* enable NCP and wait until it settles */
+	if (snd_soc_component_update_bits(c, WCD9XXX_A_NCP_EN, 0x01, 0x01) > 0)
+		usleep_range(NCP_SETTLE_TIME_US, NCP_SETTLE_TIME_US + 10);
+}
+
+static void wcd9xxx_set_fclk_put_ncp(struct snd_soc_component *c,
+				     struct wcd9306_clsh_data *clsh_d,
+				     enum wcd9306_ncp_fclk_level fclk_level)
+{
+	clsh_d->ncp_users[fclk_level]--;
+
+	if (clsh_d->ncp_users[NCP_FCLK_LEVEL_8] == 0 &&
+	    clsh_d->ncp_users[NCP_FCLK_LEVEL_5] == 0)
+		snd_soc_component_update_bits(c, WCD9XXX_A_NCP_EN, 0x01, 0x00);
+	else if (clsh_d->ncp_users[NCP_FCLK_LEVEL_8] == 0)
+		/* if dominating level 8 has gone, switch to 5 */
+		snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x0F, 0x05);
+}
+
+static void wcd9xxx_cfg_clsh_param_ear(struct snd_soc_component *c)
+{
+	static const struct wcd9306_clsh_reg_mask_val reg_set[] = {
+		{WCD9XXX_A_CDC_CLSH_B1_CTL, (0x1 << 7), 0},
+		{WCD9XXX_A_CDC_CLSH_V_PA_HD_EAR, (0x3f << 0), 0x0D},
+		{WCD9XXX_A_CDC_CLSH_V_PA_MIN_EAR, (0x3f << 0), 0x3A},
+
+		/* Under assumption that EAR load is 10.7ohm */
+		{WCD9XXX_A_CDC_CLSH_IDLE_EAR_THSD, (0x3f << 0), 0x26},
+		{WCD9XXX_A_CDC_CLSH_FCLKONLY_EAR_THSD, (0x3f << 0), 0x2C},
+		{WCD9XXX_A_CDC_CLSH_I_PA_FACT_EAR_L, 0xff, 0xA9},
+		{WCD9XXX_A_CDC_CLSH_I_PA_FACT_EAR_U, 0xff, 0x07},
+		{WCD9XXX_A_CDC_CLSH_K_ADDR, (0x1 << 7), 0},
+		{WCD9XXX_A_CDC_CLSH_K_ADDR, (0xf << 0), 0x08},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x1b},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x00},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x2d},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x00},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x36},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x00},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x37},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x00},
+	};
+
+	wcd9306_clsh_write_set(c, reg_set, ARRAY_SIZE(reg_set));
+}
+
+static void wcd9xxx_cfg_clsh_param_hph(struct snd_soc_component *c)
+{
+	static const struct wcd9306_clsh_reg_mask_val reg_set[] = {
+		{WCD9XXX_A_CDC_CLSH_B1_CTL, (0x1 << 6), 0},
+		{WCD9XXX_A_CDC_CLSH_V_PA_HD_HPH, 0x3f, 0x0D},
+		{WCD9XXX_A_CDC_CLSH_V_PA_MIN_HPH, 0x3f, 0x1D},
+
+		/* Under assumption that HPH load is 16ohm per channel */
+		{WCD9XXX_A_CDC_CLSH_IDLE_HPH_THSD, 0x3f, 0x13},
+		{WCD9XXX_A_CDC_CLSH_FCLKONLY_HPH_THSD, 0x1f, 0x19},
+		{WCD9XXX_A_CDC_CLSH_I_PA_FACT_HPH_L, 0xff, 0x97},
+		{WCD9XXX_A_CDC_CLSH_I_PA_FACT_HPH_U, 0xff, 0x05},
+		{WCD9XXX_A_CDC_CLSH_K_ADDR, (0x1 << 7), 0},
+		{WCD9XXX_A_CDC_CLSH_K_ADDR, 0x0f, 0},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0xAE},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x01},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x1C},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x00},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x24},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x00},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x25},
+		{WCD9XXX_A_CDC_CLSH_K_DATA, 0xff, 0x00},
+	};
+
+	wcd9306_clsh_write_set(c, reg_set, ARRAY_SIZE(reg_set));
+}
+
+static void wcd9xxx_ncp_bypass_enable(struct snd_soc_component *c, bool enable)
+{
+	snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x10, (enable << 4));
+	/* 50us sleep is required as per the class H HW design sequence */
+	usleep_range(BUCK_SETTLE_TIME_US, BUCK_SETTLE_TIME_US + 10);
+}
+
+static void wcd9xxx_clsh_set_Iest(struct snd_soc_component *c, u8 value)
+{
+	snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_5, 0x01, (0x01 & 0x03));
+	snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_5, 0xFC, (value << 2));
+}
+
+static int wcd9xxx_compute_pa(u8 req_state)
+{
+	switch (req_state) {
+	case WCD9XXX_CLSH_STATE_HPHL:
+		return CLSH_COMPUTE_HPH_L;
+	case WCD9XXX_CLSH_STATE_HPHR:
+		return CLSH_COMPUTE_HPH_R;
+	case WCD9XXX_CLSH_STATE_EAR:
+		return CLSH_COMPUTE_EAR;
+	default:
+		return 0;
+	}
+}
+
+static void wcd9xxx_clsh_state_hph_ear(struct snd_soc_component *c,
+				       struct wcd9306_clsh_data *clsh_d,
+				       u8 req_state, bool is_enable)
+{
+	int compute_pa = wcd9xxx_compute_pa(req_state);
+
+	if (!compute_pa)
+		dev_dbg(c->dev, "%s: invalid state 0x%x, enable %d\n", __func__, req_state,
+			is_enable);
+
+	if (is_enable) {
+		/* only once: when EAR is the state or the request */
+		if ((clsh_d->state == WCD9XXX_CLSH_STATE_EAR) ||
+		    (req_state == WCD9XXX_CLSH_STATE_EAR)) {
+			wcd9xxx_dynamic_bypass_buck_ctrl(c, false);
+			wcd9xxx_ncp_bypass_enable(c, true);
+		}
+		wcd9xxx_clsh_comp_req(c, clsh_d, compute_pa, true);
+	} else {
+		wcd9xxx_clsh_comp_req(c, clsh_d, compute_pa, false);
+
+		if (((clsh_d->state & (~req_state)) == WCD9XXX_CLSH_STATE_EAR) ||
+		    (req_state == WCD9XXX_CLSH_STATE_EAR)) {
+			wcd9xxx_ncp_bypass_enable(c, false);
+			wcd9xxx_dynamic_bypass_buck_ctrl(c, true);
+		}
+	}
+}
+
+static void wcd9xxx_clsh_state_hph_lo(struct snd_soc_component *c,
+				      struct wcd9306_clsh_data *clsh_d,
+				      u8 req_state, bool is_enable)
+{
+	if (is_enable) {
+		if ((clsh_d->state == WCD9XXX_CLSH_STATE_LO) ||
+		    (req_state == WCD9XXX_CLSH_STATE_LO)) {
+			wcd9xxx_dynamic_bypass_buck_ctrl_lo(c, false);
+			wcd9xxx_set_fclk_get_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+			if (req_state & WCD9XXX_CLSH_STATE_HPH_ST) {
+				wcd9xxx_ncp_bypass_enable(c, true);
+				wcd9xxx_enable_clsh_block(c, clsh_d, true);
+				wcd9xxx_chargepump_request(c, clsh_d, true);
+				wcd9xxx_enable_anc_delay(c, true);
+			}
+		}
+		if (req_state == WCD9XXX_CLSH_STATE_HPHL)
+			wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_L, true);
+		if (req_state == WCD9XXX_CLSH_STATE_HPHR)
+			wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_R, true);
+	} else {
+		switch (req_state) {
+		case WCD9XXX_CLSH_STATE_LO:
+			snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x20, 0x00);
+			wcd9xxx_dynamic_bypass_buck_ctrl_lo(c, true);
+			break;
+		case WCD9XXX_CLSH_STATE_HPHL:
+			wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_L, false);
+			break;
+		case WCD9XXX_CLSH_STATE_HPHR:
+			wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_R, false);
+			break;
+		default:
+			dev_dbg(c->dev, "%s: invalid state 0x%x, enable %d\n", __func__,
+				req_state, is_enable);
+			break;
+		}
+		if ((req_state == WCD9XXX_CLSH_STATE_LO) ||
+		    ((clsh_d->state & (~req_state)) == WCD9XXX_CLSH_STATE_LO)) {
+			wcd9xxx_set_fclk_put_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+			wcd9xxx_ncp_bypass_enable(c, false);
+
+			if (req_state & WCD9XXX_CLSH_STATE_HPH_ST) {
+				usleep_range(BUCK_SETTLE_TIME_US, BUCK_SETTLE_TIME_US + 10);
+				if (clsh_d->buck_mv == WCD9XXX_CDC_BUCK_MV_1P8) {
+					wcd9xxx_enable_buck(c, clsh_d, false);
+					wcd9xxx_ncp_bypass_enable(c, true);
+				} else {
+					/* NCP settle time recommended by the codec spec */
+					usleep_range(NCP_SETTLE_TIME_US, NCP_SETTLE_TIME_US + 10);
+					wcd9xxx_clsh_set_Iest(c, 0x02);
+				}
+				snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_1, 0x04, 0x00);
+				snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_4, 0xFF,
+							      BUCK_VREF_1P8V);
+			}
+		}
+	}
+}
+
+static void wcd9xxx_clsh_state_ear_lo(struct snd_soc_component *c,
+				      struct wcd9306_clsh_data *clsh_d,
+				      u8 req_state, bool is_enable)
+{
+	if (is_enable) {
+		wcd9xxx_dynamic_bypass_buck_ctrl(c, false);
+		wcd9xxx_enable_buck(c, clsh_d, true);
+		if (req_state & WCD9XXX_CLSH_STATE_EAR) {
+			wcd9xxx_set_fclk_get_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+			wcd9xxx_ncp_bypass_enable(c, true);
+			wcd9xxx_enable_clsh_block(c, clsh_d, true);
+			wcd9xxx_chargepump_request(c, clsh_d, true);
+			wcd9xxx_enable_anc_delay(c, true);
+			wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_EAR, true);
+		}
+	} else {
+		wcd9xxx_set_fclk_put_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+		wcd9xxx_ncp_bypass_enable(c, false);
+		if (req_state & WCD9XXX_CLSH_STATE_LO) {
+			snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x20, 0x00);
+			wcd9xxx_dynamic_bypass_buck_ctrl(c, true);
+		} else if (req_state & WCD9XXX_CLSH_STATE_EAR) {
+			wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_EAR, false);
+			if (clsh_d->buck_mv == WCD9XXX_CDC_BUCK_MV_1P8) {
+				wcd9xxx_enable_buck(c, clsh_d, false);
+				wcd9xxx_ncp_bypass_enable(c, true);
+			} else {
+				/* NCP settle time recommended by the codec spec */
+				usleep_range(NCP_SETTLE_TIME_US, NCP_SETTLE_TIME_US + 10);
+				wcd9xxx_clsh_set_Iest(c, 0x02);
+			}
+			snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_1, 0x04, 0x00);
+			snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_4, 0xFF,
+						      BUCK_VREF_1P8V);
+		}
+	}
+}
+
+static void wcd9xxx_clsh_state_hph_ear_lo(struct snd_soc_component *c,
+					  struct wcd9306_clsh_data *clsh_d,
+					  u8 req_state, bool is_enable)
+{
+	if (req_state & WCD9XXX_CLSH_STATE_HPHL)
+		wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_L, is_enable);
+	if (req_state & WCD9XXX_CLSH_STATE_HPHR)
+		wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_R, is_enable);
+	if (req_state & WCD9XXX_CLSH_STATE_EAR)
+		wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_EAR, is_enable);
+}
+
+static void wcd9xxx_clsh_state_ear(struct snd_soc_component *c,
+				   struct wcd9306_clsh_data *clsh_d,
+				   u8 req_state, bool is_enable)
+{
+	if (is_enable) {
+		wcd9xxx_cfg_clsh_param_common(c);
+		wcd9xxx_cfg_clsh_param_ear(c);
+		wcd9xxx_enable_clsh_block(c, clsh_d, true);
+		wcd9xxx_chargepump_request(c, clsh_d, true);
+		wcd9xxx_enable_anc_delay(c, true);
+		wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_EAR, true);
+		wcd9xxx_set_buck_mode(c, BUCK_VREF_2V);
+		wcd9xxx_enable_buck(c, clsh_d, true);
+		wcd9xxx_set_fclk_get_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+	} else {
+		wcd9xxx_set_fclk_put_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+		wcd9xxx_enable_buck(c, clsh_d, false);
+		/*
+		 * Downstream requests the EAR computation on (true) here, on the way down; kept
+		 * as it is (the class-H block is disabled right after when it was the last user).
+		 */
+		wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_EAR, true);
+		wcd9xxx_chargepump_request(c, clsh_d, false);
+		wcd9xxx_enable_clsh_block(c, clsh_d, false);
+	}
+}
+
+static void wcd9xxx_clsh_set_hs_performance_mode(struct snd_soc_component *c,
+						 struct wcd9306_clsh_data *clsh_d)
+{
+	clsh_d->ncp_users[NCP_FCLK_LEVEL_8]++;
+
+	if (clsh_d->ncp_users[NCP_FCLK_LEVEL_8] > 0)
+		snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x0F, 0x08);
+
+	snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 0x30, 0x30);
+
+	/* enable NCP and wait until it settles */
+	if (snd_soc_component_update_bits(c, WCD9XXX_A_NCP_EN, 0x01, 0x01) > 0)
+		usleep_range(NCP_SETTLE_TIME_US, NCP_SETTLE_TIME_US + 10);
+}
+
+static void wcd9xxx_clsh_state_hph(struct snd_soc_component *c,
+				   struct wcd9306_clsh_data *clsh_d, bool is_enable,
+				   int compute_pa)
+{
+	if (is_enable) {
+		wcd9xxx_cfg_clsh_param_common(c);
+		wcd9xxx_cfg_clsh_param_hph(c);
+		wcd9xxx_enable_clsh_block(c, clsh_d, true);
+		wcd9xxx_chargepump_request(c, clsh_d, true);
+		wcd9xxx_enable_anc_delay(c, true);
+		wcd9xxx_clsh_comp_req(c, clsh_d, compute_pa, true);
+
+		if (clsh_d->hs_perf_mode_enabled) {
+			wcd9xxx_clsh_set_hs_performance_mode(c, clsh_d);
+		} else {
+			wcd9xxx_set_buck_mode(c, BUCK_VREF_2V);
+			wcd9xxx_enable_buck(c, clsh_d, true);
+			wcd9xxx_set_fclk_get_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+		}
+	} else {
+		wcd9xxx_set_fclk_put_ncp(c, clsh_d, NCP_FCLK_LEVEL_8);
+		if (!clsh_d->hs_perf_mode_enabled)
+			wcd9xxx_enable_buck(c, clsh_d, false);
+		wcd9xxx_clsh_comp_req(c, clsh_d, compute_pa, false);
+		wcd9xxx_chargepump_request(c, clsh_d, false);
+		wcd9xxx_enable_clsh_block(c, clsh_d, false);
+	}
+}
+
+static void wcd9xxx_clsh_state_hph_l(struct snd_soc_component *c,
+				     struct wcd9306_clsh_data *clsh_d,
+				     u8 req_state, bool is_enable)
+{
+	wcd9xxx_clsh_state_hph(c, clsh_d, is_enable, CLSH_COMPUTE_HPH_L);
+}
+
+static void wcd9xxx_clsh_state_hph_r(struct snd_soc_component *c,
+				     struct wcd9306_clsh_data *clsh_d,
+				     u8 req_state, bool is_enable)
+{
+	wcd9xxx_clsh_state_hph(c, clsh_d, is_enable, CLSH_COMPUTE_HPH_R);
+}
+
+static void wcd9xxx_clsh_state_hph_st(struct snd_soc_component *c,
+				      struct wcd9306_clsh_data *clsh_d,
+				      u8 req_state, bool is_enable)
+{
+	if (req_state == WCD9XXX_CLSH_STATE_HPHL)
+		wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_L, is_enable);
+	if (req_state == WCD9XXX_CLSH_STATE_HPHR)
+		wcd9xxx_clsh_comp_req(c, clsh_d, CLSH_COMPUTE_HPH_R, is_enable);
+}
+
+static void wcd9xxx_clsh_state_lo(struct snd_soc_component *c,
+				  struct wcd9306_clsh_data *clsh_d,
+				  u8 req_state, bool is_enable)
+{
+	dev_dbg(c->dev, "%s: %s, buck_mv %d\n", __func__, is_enable ? "enable" : "disable",
+		clsh_d->buck_mv);
+
+	if (is_enable) {
+		wcd9xxx_set_buck_mode(c, BUCK_VREF_1P8V);
+		wcd9xxx_enable_buck(c, clsh_d, true);
+		wcd9xxx_set_fclk_get_ncp(c, clsh_d, NCP_FCLK_LEVEL_5);
+
+		if (clsh_d->buck_mv == WCD9XXX_CDC_BUCK_MV_1P8) {
+			wcd9xxx_enable_buck(c, clsh_d, false);
+			snd_soc_component_update_bits(c, WCD9XXX_A_NCP_STATIC, 1 << 4, 1 << 4);
+			/* NCP settle time recommended by the codec spec */
+			usleep_range(NCP_SETTLE_TIME_US, NCP_SETTLE_TIME_US + 10);
+		} else {
+			/* NCP settle time recommended by the codec spec */
+			usleep_range(NCP_SETTLE_TIME_US, NCP_SETTLE_TIME_US + 10);
+			snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_5, 0x01,
+						      (0x01 & 0x03));
+			/* downstream: (0xFC & 0xB), i.e. 0x08 */
+			snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_5, 0xFC,
+						      (0xFC & 0xB));
+		}
+		snd_soc_component_update_bits(c, WCD9XXX_A_BUCK_MODE_1, 0x04, 0x00);
+	} else {
+		wcd9xxx_set_fclk_put_ncp(c, clsh_d, NCP_FCLK_LEVEL_5);
+		if (clsh_d->buck_mv != WCD9XXX_CDC_BUCK_MV_1P8)
+			wcd9xxx_enable_buck(c, clsh_d, false);
+	}
+}
+
+static void wcd9xxx_clsh_state_err(struct snd_soc_component *c,
+				   struct wcd9306_clsh_data *clsh_d,
+				   u8 req_state, bool is_enable)
+{
+	dev_warn(c->dev, "%s: wrong class H request: %s 0x%x (state 0x%x)\n", __func__,
+		 is_enable ? "enable" : "disable", req_state, clsh_d->state);
+}
+
+/* the valid states and their handlers (downstream fills this table in wcd9xxx_clsh_init) */
+static const wcd9306_clsh_state_fn clsh_state_fp[WCD9XXX_NUM_CLSH_STATES] = {
+	[WCD9XXX_CLSH_STATE_EAR] = wcd9xxx_clsh_state_ear,
+	[WCD9XXX_CLSH_STATE_HPHL] = wcd9xxx_clsh_state_hph_l,
+	[WCD9XXX_CLSH_STATE_HPHR] = wcd9xxx_clsh_state_hph_r,
+	[WCD9XXX_CLSH_STATE_HPH_ST] = wcd9xxx_clsh_state_hph_st,
+	[WCD9XXX_CLSH_STATE_LO] = wcd9xxx_clsh_state_lo,
+	[WCD9XXX_CLSH_STATE_HPHL_EAR] = wcd9xxx_clsh_state_hph_ear,
+	[WCD9XXX_CLSH_STATE_HPHR_EAR] = wcd9xxx_clsh_state_hph_ear,
+	[WCD9XXX_CLSH_STATE_HPH_ST_EAR] = wcd9xxx_clsh_state_hph_ear,
+	[WCD9XXX_CLSH_STATE_HPHL_LO] = wcd9xxx_clsh_state_hph_lo,
+	[WCD9XXX_CLSH_STATE_HPHR_LO] = wcd9xxx_clsh_state_hph_lo,
+	[WCD9XXX_CLSH_STATE_HPH_ST_LO] = wcd9xxx_clsh_state_hph_lo,
+	[WCD9XXX_CLSH_STATE_EAR_LO] = wcd9xxx_clsh_state_ear_lo,
+	[WCD9XXX_CLSH_STATE_HPHL_EAR_LO] = wcd9xxx_clsh_state_hph_ear_lo,
+	[WCD9XXX_CLSH_STATE_HPHR_EAR_LO] = wcd9xxx_clsh_state_hph_ear_lo,
+	[WCD9XXX_CLSH_STATE_HPH_ST_EAR_LO] = wcd9xxx_clsh_state_hph_ear_lo,
+};
+
+/* IDLE is valid too, but has no handler */
+static bool wcd9xxx_clsh_is_state_valid(u8 state)
+{
+	return state == WCD9XXX_CLSH_STATE_IDLE ||
+	       (state < WCD9XXX_NUM_CLSH_STATES && clsh_state_fp[state]);
+}
+
+static void wcd9xxx_clsh_call(struct snd_soc_component *c, struct wcd9306_clsh_data *clsh_d,
+			      u8 state, u8 req_state, bool req_type)
+{
+	wcd9306_clsh_state_fn fn = state < WCD9XXX_NUM_CLSH_STATES ? clsh_state_fp[state] : NULL;
+
+	(fn ? fn : wcd9xxx_clsh_state_err)(c, clsh_d, req_state, req_type);
+}
+
+/*
+ * PRE_DAC (enable only) and POST_PA (disable, or the post-PA settings on enable) events of
+ * the outputs; moves the class H configuration to the combination of active outputs.
+ */
+void wcd9306_clsh_fsm(struct snd_soc_component *c, struct wcd9306_clsh_data *clsh_d,
+		      u8 req_state, bool req_type, u8 clsh_event)
+{
+	u8 old_state, new_state;
+
+	switch (clsh_event) {
+	case WCD9XXX_CLSH_EVENT_PRE_DAC:
+		/* PRE_DAC only for enable (downstream: BUG_ON) */
+		if (WARN_ON(req_type != WCD9XXX_CLSH_REQ_ENABLE))
+			return;
+
+		old_state = clsh_d->state;
+		new_state = old_state | req_state;
+
+		if (!wcd9xxx_clsh_is_state_valid(new_state)) {
+			dev_dbg(c->dev, "%s: not a valid new state 0x%x\n", __func__, new_state);
+			return;
+		}
+		if (new_state == old_state) {
+			dev_dbg(c->dev, "%s: already in state 0x%x\n", __func__, new_state);
+			return;
+		}
+		wcd9xxx_clsh_call(c, clsh_d, new_state, req_state, req_type);
+		clsh_d->state = new_state;
+		dev_dbg(c->dev, "%s: class H state 0x%x -> 0x%x\n", __func__, old_state,
+			new_state);
+		break;
+	case WCD9XXX_CLSH_EVENT_POST_PA:
+		if (req_type == WCD9XXX_CLSH_REQ_DISABLE) {
+			old_state = clsh_d->state;
+			new_state = old_state & (~req_state);
+
+			if (new_state >= WCD9XXX_NUM_CLSH_STATES) {
+				dev_dbg(c->dev, "%s: wrong new state 0x%x\n", __func__, new_state);
+				return;
+			}
+			if (!wcd9xxx_clsh_is_state_valid(old_state)) {
+				dev_dbg(c->dev, "%s: invalid old state 0x%x\n", __func__,
+					old_state);
+				return;
+			}
+			if (new_state == old_state) {
+				dev_dbg(c->dev, "%s: already in state 0x%x\n", __func__,
+					new_state);
+				return;
+			}
+			wcd9xxx_clsh_call(c, clsh_d, old_state, req_state, req_type);
+			clsh_d->state = new_state;
+			dev_dbg(c->dev, "%s: class H state 0x%x -> 0x%x\n", __func__, old_state,
+				new_state);
+		} else if (!(clsh_d->state & WCD9XXX_CLSH_STATE_LO)) {
+			if (!clsh_d->hs_perf_mode_enabled)
+				wcd9xxx_clsh_enable_post_pa(c, clsh_d);
+		}
+		break;
+	}
+}
+EXPORT_SYMBOL_GPL(wcd9306_clsh_fsm);
+
+void wcd9306_clsh_init(struct wcd9306_clsh_data *clsh)
+{
+	clsh->state = WCD9XXX_CLSH_STATE_IDLE;
+	clsh->clsh_users = 0;
+	clsh->buck_users = 0;
+	clsh->cp_users = 0;
+	clsh->ncp_users[NCP_FCLK_LEVEL_8] = 0;
+	clsh->ncp_users[NCP_FCLK_LEVEL_5] = 0;
+}
+EXPORT_SYMBOL_GPL(wcd9306_clsh_init);

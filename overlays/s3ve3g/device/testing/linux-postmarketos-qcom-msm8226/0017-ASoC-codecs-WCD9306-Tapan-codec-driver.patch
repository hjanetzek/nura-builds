+static int tapan_set_channel_map(struct snd_soc_dai *dai,
+				 unsigned int tx_num, const unsigned int *tx_slot,
+				 unsigned int rx_num, const unsigned int *rx_slot)
+{
+	struct tapan_priv *tapan = snd_soc_component_get_drvdata(dai->component);
+	int i;
+
+	if (!tx_slot || !rx_slot) {
+		dev_err(tapan->dev, "Invalid tx_slot=%p, rx_slot=%p\n", tx_slot, rx_slot);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < rx_num && i < TAPAN_RX_MAX; i++)
+		tapan->rx_chs[i].ch_num = rx_slot[i];
+	for (i = 0; i < tx_num && i < TAPAN_TX_MAX; i++)
+		tapan->tx_chs[i].ch_num = tx_slot[i];
+
+	return 0;
+}
+
+static int tapan_get_channel_map(const struct snd_soc_dai *dai,
+				 unsigned int *tx_num, unsigned int *tx_slot,
+				 unsigned int *rx_num, unsigned int *rx_slot)
+{
+	struct tapan_priv *tapan = snd_soc_component_get_drvdata(dai->component);
+	struct wcd9xxx_ch *ch;
+	int i = 0;
+
+	switch (dai->id) {
+	case AIF1_PB:
+	case AIF2_PB:
+	case AIF3_PB:
+		if (!rx_slot || !rx_num)
+			return -EINVAL;
+		list_for_each_entry(ch, &tapan->dai[dai->id].wcd9xxx_ch_list, list) {
+			if (i == TAPAN_RX_MAX)
+				break;
+			rx_slot[i++] = ch->ch_num;
+		}
+		*rx_num = i;
+		break;
+	case AIF1_CAP:
+	case AIF2_CAP:
+	case AIF3_CAP:
+		if (!tx_slot || !tx_num)
+			return -EINVAL;
+		list_for_each_entry(ch, &tapan->dai[dai->id].wcd9xxx_ch_list, list) {
+			if (i == TAPAN_TX_MAX)
+				break;
+			tx_slot[i++] = ch->ch_num;
+		}
+		*tx_num = i;
+		break;
+	default:
+		dev_err(tapan->dev, "Invalid DAI ID %x\n", dai->id);
+		return -EINVAL;
+	}
+
+	return 0;
+}

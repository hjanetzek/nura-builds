+++ b/sound/soc/codecs/wcd9306-clsh.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Class-H controller, buck and charge pump (NCP) state machine of the WCD9306 (Tapan).
+ * Ported from the downstream msm-3.4 wcd9xxx-common.h,
+ * Copyright (c) 2012-2014, The Linux Foundation. All rights reserved.
+ */
+#ifndef __WCD9306_CLSH_H__
+#define __WCD9306_CLSH_H__
+
+#include <linux/types.h>
+
+struct snd_soc_component;
+
+#define WCD9XXX_CLSH_REQ_ENABLE		true
+#define WCD9XXX_CLSH_REQ_DISABLE	false
+
+#define WCD9XXX_CLSH_EVENT_PRE_DAC	0x01
+#define WCD9XXX_CLSH_EVENT_POST_PA	0x02
+
+/* basic states, a bit mask: EAR, HPH left, HPH right, lineout */
+#define WCD9XXX_CLSH_STATE_IDLE		0x00
+#define WCD9XXX_CLSH_STATE_EAR		(0x01 << 0)
+#define WCD9XXX_CLSH_STATE_HPHL		(0x01 << 1)
+#define WCD9XXX_CLSH_STATE_HPHR		(0x01 << 2)
+#define WCD9XXX_CLSH_STATE_LO		(0x01 << 3)
+#define WCD9XXX_NUM_CLSH_STATES		(0x01 << 4)
+
+/* derived states */
+#define WCD9XXX_CLSH_STATE_HPH_ST	(WCD9XXX_CLSH_STATE_HPHL | WCD9XXX_CLSH_STATE_HPHR)
+#define WCD9XXX_CLSH_STATE_HPHL_EAR	(WCD9XXX_CLSH_STATE_HPHL | WCD9XXX_CLSH_STATE_EAR)
+#define WCD9XXX_CLSH_STATE_HPHR_EAR	(WCD9XXX_CLSH_STATE_HPHR | WCD9XXX_CLSH_STATE_EAR)
+#define WCD9XXX_CLSH_STATE_HPH_ST_EAR	(WCD9XXX_CLSH_STATE_HPH_ST | WCD9XXX_CLSH_STATE_EAR)
+#define WCD9XXX_CLSH_STATE_HPHL_LO	(WCD9XXX_CLSH_STATE_HPHL | WCD9XXX_CLSH_STATE_LO)
+#define WCD9XXX_CLSH_STATE_HPHR_LO	(WCD9XXX_CLSH_STATE_HPHR | WCD9XXX_CLSH_STATE_LO)
+#define WCD9XXX_CLSH_STATE_HPH_ST_LO	(WCD9XXX_CLSH_STATE_HPH_ST | WCD9XXX_CLSH_STATE_LO)
+#define WCD9XXX_CLSH_STATE_EAR_LO	(WCD9XXX_CLSH_STATE_EAR | WCD9XXX_CLSH_STATE_LO)
+#define WCD9XXX_CLSH_STATE_HPHL_EAR_LO	(WCD9XXX_CLSH_STATE_HPHL | WCD9XXX_CLSH_STATE_EAR | \
+					 WCD9XXX_CLSH_STATE_LO)
+#define WCD9XXX_CLSH_STATE_HPHR_EAR_LO	(WCD9XXX_CLSH_STATE_HPHR | WCD9XXX_CLSH_STATE_EAR | \
+					 WCD9XXX_CLSH_STATE_LO)
+#define WCD9XXX_CLSH_STATE_HPH_ST_EAR_LO (WCD9XXX_CLSH_STATE_HPH_ST | WCD9XXX_CLSH_STATE_EAR | \
+					 WCD9XXX_CLSH_STATE_LO)
+
+enum wcd9306_ncp_fclk_level {
+	NCP_FCLK_LEVEL_8,
+	NCP_FCLK_LEVEL_5,
+	NCP_FCLK_LEVEL_MAX,
+};
+
+/* vdd_buck in microvolts */
+enum wcd9xxx_buck_volt {
+	WCD9XXX_CDC_BUCK_UNSUPPORTED = 0,
+	WCD9XXX_CDC_BUCK_MV_1P8 = 1800000,
+	WCD9XXX_CDC_BUCK_MV_2P15 = 2150000,
+};
+
+/* class-H state the codec driver keeps (downstream struct wcd9xxx_clsh_cdc_data) */
+struct wcd9306_clsh_data {
+	u8 state;
+	int buck_mv;			/* enum wcd9xxx_buck_volt */
+	bool is_dynamic_vdd_cp;		/* set when buck_mv is 1.8 V */
+	int clsh_users;
+	int buck_users;
+	int cp_users;			/* downstream: a static in wcd9xxx_chargepump_request() */
+	int ncp_users[NCP_FCLK_LEVEL_MAX];
+	bool hs_perf_mode_enabled;
+};
+
+void wcd9306_clsh_init(struct wcd9306_clsh_data *clsh);
+void wcd9306_clsh_fsm(struct snd_soc_component *component, struct wcd9306_clsh_data *clsh,
+		      u8 req_state, bool req_type, u8 clsh_event);
+
+#endif

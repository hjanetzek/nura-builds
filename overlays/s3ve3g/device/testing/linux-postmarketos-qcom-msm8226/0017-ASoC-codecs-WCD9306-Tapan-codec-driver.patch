+static void tapan_update_reg_defaults(struct snd_soc_component *codec)
+{
+	u32 i;
+	struct tapan_priv *tapan_v = snd_soc_component_get_drvdata(codec);
+
+	if (!TAPAN_IS_1_0(tapan_v->version)) {
+		for (i = 0; i < ARRAY_SIZE(tapan_2_x_reg_reset_values); i++)
+			snd_soc_component_write(codec, tapan_2_x_reg_reset_values[i].reg,
+				tapan_2_x_reg_reset_values[i].val);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(tapan_reg_defaults); i++)
+		snd_soc_component_write(codec, tapan_reg_defaults[i].reg,
+				tapan_reg_defaults[i].val);
+
+	if (TAPAN_IS_1_0(tapan_v->version)) {
+		for (i = 0; i < ARRAY_SIZE(tapan_1_0_reg_defaults); i++)
+			snd_soc_component_write(codec, tapan_1_0_reg_defaults[i].reg,
+				tapan_1_0_reg_defaults[i].val);
+	}
+
+	if (!TAPAN_IS_1_0(tapan_v->version))
+		spkr_drv_wrnd = -1;
+	else if (spkr_drv_wrnd == 1)
+		snd_soc_component_write(codec, TAPAN_A_SPKR_DRV_EN, 0xEF);
+}

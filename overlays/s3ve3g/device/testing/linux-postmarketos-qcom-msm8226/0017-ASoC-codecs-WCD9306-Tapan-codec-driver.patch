+/*
+ * Conditional bits (downstream resmgr cond_update_bits): the condition (HPH_MIC) is only
+ * registered by MBHC, so the bit is set on add and cleared on remove
+ */
+enum wcd9xxx_resmgr_cond {
+	WCD9XXX_COND_HPH = 0x01,
+	WCD9XXX_COND_HPH_MIC = 0x02,
+};
+
+static int wcd9xxx_resmgr_add_cond_update_bits(struct wcd9xxx_resmgr *resmgr,
+					       enum wcd9xxx_resmgr_cond cond,
+					       unsigned short reg, int shift, bool invert)
+{
+	return snd_soc_component_update_bits(resmgr->codec, reg, 1 << shift, (!invert) << shift);
+}
+
+static int wcd9xxx_resmgr_rm_cond_update_bits(struct wcd9xxx_resmgr *resmgr,
+					      enum wcd9xxx_resmgr_cond cond,
+					      unsigned short reg, int shift, bool invert)
+{
+	return snd_soc_component_update_bits(resmgr->codec, reg, 1 << shift, invert << shift);
+}
+
+#define wcd9xxx_clsh_fsm wcd9306_clsh_fsm
+
+static void wcd9xxx_disable_bg(struct wcd9xxx_resmgr *resmgr)
+{
+	snd_soc_component_update_bits(resmgr->codec, WCD9XXX_A_BIAS_CENTRAL_BG_CTL, 0x03, 0x00);
+	usleep_range(100, 110);
+}
+
+/* BG enablement should always enable in slow mode */
+static void wcd9xxx_enable_bg(struct wcd9xxx_resmgr *resmgr)
+{
+	struct snd_soc_component *codec = resmgr->codec;
+
+	/* Enable BG in slow mode and precharge */
+	snd_soc_component_update_bits(codec, WCD9XXX_A_BIAS_CENTRAL_BG_CTL, 0x80, 0x80);
+	snd_soc_component_update_bits(codec, WCD9XXX_A_BIAS_CENTRAL_BG_CTL, 0x04, 0x04);
+	snd_soc_component_update_bits(codec, WCD9XXX_A_BIAS_CENTRAL_BG_CTL, 0x01, 0x01);
+	usleep_range(1000, 1100);
+	snd_soc_component_update_bits(codec, WCD9XXX_A_BIAS_CENTRAL_BG_CTL, 0x80, 0x00);
+}
+
+static void wcd9xxx_resmgr_get_bandgap(struct wcd9xxx_resmgr *resmgr,
+				       enum wcd9xxx_bandgap_type choice)
+{
+	lockdep_assert_held(&resmgr->codec_bg_clk_lock);
+	if (choice != WCD9XXX_BANDGAP_AUDIO_MODE)
+		return;
+	if (++resmgr->bg_audio_users == 1)
+		wcd9xxx_enable_bg(resmgr);
+	resmgr->bandgap_type = WCD9XXX_BANDGAP_AUDIO_MODE;
+}
+
+static void wcd9xxx_resmgr_put_bandgap(struct wcd9xxx_resmgr *resmgr,
+				       enum wcd9xxx_bandgap_type choice)
+{
+	lockdep_assert_held(&resmgr->codec_bg_clk_lock);
+	if (choice != WCD9XXX_BANDGAP_AUDIO_MODE)
+		return;
+	if (WARN_ON(!resmgr->bg_audio_users))
+		return;
+	if (--resmgr->bg_audio_users == 0) {
+		wcd9xxx_disable_bg(resmgr);
+		resmgr->bandgap_type = WCD9XXX_BANDGAP_OFF;
+	}
+}
+
+static void wcd9xxx_resmgr_enable_rx_bias(struct wcd9xxx_resmgr *resmgr, u32 enable)
+{
+	struct snd_soc_component *codec = resmgr->codec;
+
+	if (enable) {
+		if (++resmgr->rx_bias_count == 1)
+			snd_soc_component_update_bits(codec, WCD9XXX_A_RX_COM_BIAS, 0x80, 0x80);
+	} else {
+		if (WARN_ON(!resmgr->rx_bias_count))
+			return;
+		if (--resmgr->rx_bias_count == 0)
+			snd_soc_component_update_bits(codec, WCD9XXX_A_RX_COM_BIAS, 0x80, 0x00);
+	}
+}
+
+static int wcd9xxx_resmgr_enable_config_mode(struct wcd9xxx_resmgr *resmgr, int enable)
+{
+	struct snd_soc_component *codec = resmgr->codec;
+
+	if (enable) {
+		snd_soc_component_update_bits(codec, WCD9XXX_A_RC_OSC_FREQ, 0x10, 0);
+		/* bandgap mode to fast */
+		snd_soc_component_write(codec, WCD9XXX_A_BIAS_OSC_BG_CTL, 0x17);
+		usleep_range(5, 10);
+		snd_soc_component_update_bits(codec, WCD9XXX_A_RC_OSC_FREQ, 0x80, 0x80);
+		snd_soc_component_update_bits(codec, WCD9XXX_A_RC_OSC_TEST, 0x80, 0x80);
+		usleep_range(10, 20);
+		snd_soc_component_update_bits(codec, WCD9XXX_A_RC_OSC_TEST, 0x80, 0);
+		usleep_range(10000, 10100);
+		snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN1, 0x08, 0x08);
+	} else {
+		snd_soc_component_update_bits(codec, WCD9XXX_A_BIAS_OSC_BG_CTL, 0x1, 0);
+		snd_soc_component_update_bits(codec, WCD9XXX_A_RC_OSC_FREQ, 0x80, 0);
+	}
+
+	return 0;
+}
+
+static void wcd9xxx_enable_clock_block(struct wcd9xxx_resmgr *resmgr, int config_mode)
+{
+	struct snd_soc_component *codec = resmgr->codec;
+
+	/* transit to RCO requires mclk off */
+	WARN_ON(snd_soc_component_read(codec, WCD9XXX_A_CLK_BUFF_EN2) & (1 << 2));
+
+	if (config_mode) {
+		/* enable RCO and switch to it */
+		wcd9xxx_resmgr_enable_config_mode(resmgr, 1);
+		snd_soc_component_write(codec, WCD9XXX_A_CLK_BUFF_EN2, 0x02);
+		usleep_range(1000, 1100);
+	} else {
+		/* switch to MCLK */
+		snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN1, 0x08, 0x00);
+		/* if RCO is enabled, switch from it */
+		if (snd_soc_component_read(codec, WCD9XXX_A_RC_OSC_FREQ) & 0x80) {
+			snd_soc_component_write(codec, WCD9XXX_A_CLK_BUFF_EN2, 0x02);
+			wcd9xxx_resmgr_enable_config_mode(resmgr, 0);
+		}
+		/* clk source to ext clk and clk buff ref to VBG */
+		snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN1, 0x0C, 0x04);
+	}
+
+	snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN1, 0x01, 0x01);
+	/* sleep required by codec hardware to enable clock buffer */
+	usleep_range(1000, 1200);
+	snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN2, 0x02, 0x00);
+	/* on MCLK */
+	snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN2, 0x04, 0x04);
+	snd_soc_component_update_bits(codec, WCD9XXX_A_CDC_CLK_MCLK_CTL, 0x01, 0x01);
+	usleep_range(50, 60);
+}
+
+static void wcd9xxx_disable_clock_block(struct wcd9xxx_resmgr *resmgr)
+{
+	struct snd_soc_component *codec = resmgr->codec;
+
+	snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN2, 0x04, 0x00);
+	usleep_range(50, 60);
+	snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN2, 0x02, 0x02);
+	snd_soc_component_update_bits(codec, WCD9XXX_A_CLK_BUFF_EN1, 0x05, 0x00);
+	usleep_range(50, 60);
+}
+
+static void wcd9xxx_resmgr_get_clk_block(struct wcd9xxx_resmgr *resmgr,
+					 enum wcd9xxx_clock_type type)
+{
+	lockdep_assert_held(&resmgr->codec_bg_clk_lock);
+	switch (type) {
+	case WCD9XXX_CLK_RCO:
+		if (++resmgr->clk_rco_users == 1 && resmgr->clk_type == WCD9XXX_CLK_OFF) {
+			/* enable RCO and switch to it */
+			wcd9xxx_enable_clock_block(resmgr, 1);
+			resmgr->clk_type = WCD9XXX_CLK_RCO;
+		}
+		break;
+	case WCD9XXX_CLK_MCLK:
+		if (++resmgr->clk_mclk_users == 1 && resmgr->clk_type == WCD9XXX_CLK_OFF) {
+			/* switch to MCLK */
+			wcd9xxx_enable_clock_block(resmgr, 0);
+			resmgr->clk_type = WCD9XXX_CLK_MCLK;
+		} else if (resmgr->clk_mclk_users == 1 && resmgr->clk_type == WCD9XXX_CLK_RCO) {
+			/* if RCO is enabled, switch from it */
+			WARN_ON(!(snd_soc_component_read(resmgr->codec,
+							 WCD9XXX_A_RC_OSC_FREQ) & 0x80));
+			wcd9xxx_disable_clock_block(resmgr);
+			wcd9xxx_enable_clock_block(resmgr, 0);
+			resmgr->clk_type = WCD9XXX_CLK_MCLK;
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+static void wcd9xxx_resmgr_put_clk_block(struct wcd9xxx_resmgr *resmgr,
+					 enum wcd9xxx_clock_type type)
+{
+	struct snd_soc_component *codec = resmgr->codec;
+
+	lockdep_assert_held(&resmgr->codec_bg_clk_lock);
+	switch (type) {
+	case WCD9XXX_CLK_RCO:
+		if (WARN_ON(!resmgr->clk_rco_users))
+			break;
+		if (--resmgr->clk_rco_users == 0 && resmgr->clk_type == WCD9XXX_CLK_RCO) {
+			wcd9xxx_disable_clock_block(resmgr);
+			/* if RCO is enabled, switch from it */
+			if (snd_soc_component_read(codec, WCD9XXX_A_RC_OSC_FREQ) & 0x80) {
+				snd_soc_component_write(codec, WCD9XXX_A_CLK_BUFF_EN2, 0x02);
+				wcd9xxx_resmgr_enable_config_mode(resmgr, 0);
+			}
+			resmgr->clk_type = WCD9XXX_CLK_OFF;
+		}
+		break;
+	case WCD9XXX_CLK_MCLK:
+		if (WARN_ON(!resmgr->clk_mclk_users))
+			break;
+		if (--resmgr->clk_mclk_users == 0 && resmgr->clk_rco_users == 0) {
+			wcd9xxx_disable_clock_block(resmgr);
+			resmgr->clk_type = WCD9XXX_CLK_OFF;
+		} else if (resmgr->clk_mclk_users == 0 && resmgr->clk_rco_users) {
+			/* disable clock, switch to RCO */
+			wcd9xxx_disable_clock_block(resmgr);
+			wcd9xxx_enable_clock_block(resmgr, 1);
+			resmgr->clk_type = WCD9XXX_CLK_RCO;
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+static void wcd9xxx_resmgr_update_cfilt_usage(struct wcd9xxx_resmgr *resmgr,
+					      enum wcd9xxx_cfilt_sel cfilt_sel, bool inc)
+{
+	static const u16 micb_cfilt_reg[WCD9XXX_NUM_OF_CFILT] = {
+		WCD9XXX_A_MICB_CFILT_1_CTL, WCD9XXX_A_MICB_CFILT_2_CTL, WCD9XXX_A_MICB_CFILT_3_CTL,
+	};
+	struct snd_soc_component *codec = resmgr->codec;
+
+	if (WARN_ON(cfilt_sel >= WCD9XXX_NUM_OF_CFILT))
+		return;
+
+	if (inc) {
+		if (resmgr->cfilt_users[cfilt_sel]++ == 0)
+			snd_soc_component_update_bits(codec, micb_cfilt_reg[cfilt_sel], 0x80, 0x80);
+	} else {
+		if (WARN(resmgr->cfilt_users[cfilt_sel] == 0, "Invalid CFILT use count 0\n"))
+			return;
+		if (--resmgr->cfilt_users[cfilt_sel] == 0)
+			snd_soc_component_update_bits(codec, micb_cfilt_reg[cfilt_sel], 0x80, 0);
+	}
+}
+
+static void wcd9xxx_resmgr_cfilt_get(struct wcd9xxx_resmgr *resmgr,
+				     enum wcd9xxx_cfilt_sel cfilt_sel)
+{
+	wcd9xxx_resmgr_update_cfilt_usage(resmgr, cfilt_sel, true);
+}
+
+static void wcd9xxx_resmgr_cfilt_put(struct wcd9xxx_resmgr *resmgr,
+				     enum wcd9xxx_cfilt_sel cfilt_sel)
+{
+	wcd9xxx_resmgr_update_cfilt_usage(resmgr, cfilt_sel, false);
+}
+
+static int wcd9xxx_resmgr_get_k_val(struct wcd9xxx_resmgr *resmgr, unsigned int cfilt_mv)
+{
+	int rc = -EINVAL;
+	unsigned int ldoh_v = resmgr->pdata->micbias.ldoh_v;
+	unsigned int min_mv, max_mv;
+
+	switch (ldoh_v) {
+	case WCD9XXX_LDOH_1P95_V:
+		min_mv = 160;
+		max_mv = 1800;
+		break;
+	case WCD9XXX_LDOH_2P35_V:
+		min_mv = 200;
+		max_mv = 2200;
+		break;
+	case WCD9XXX_LDOH_2P75_V:
+		min_mv = 240;
+		max_mv = 2600;
+		break;
+	case WCD9XXX_LDOH_3P0_V:
+		min_mv = 260;
+		max_mv = 2875;
+		break;
+	default:
+		return rc;
+	}
+
+	if (cfilt_mv < min_mv || cfilt_mv > max_mv)
+		return rc;
+
+	for (rc = 4; rc <= 44; rc++) {
+		min_mv = max_mv * (rc) / 44;
+		if (min_mv >= cfilt_mv) {
+			rc -= 4;
+			break;
+		}
+	}
+
+	return rc;
+}

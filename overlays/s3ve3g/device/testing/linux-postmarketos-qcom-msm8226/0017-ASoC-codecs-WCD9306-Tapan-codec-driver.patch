+static void tapan_parse_pdata(struct tapan_priv *tapan)
+{
+	struct device_node *np = tapan->dev->of_node;
+	struct wcd9xxx_pdata *pdata = &tapan->pdata;
+	u32 v;
+
+	/* defaults: the downstream msm8226.dtsi tapan_codec node, MCLK 9.6 MHz */
+	pdata->micbias.ldoh_v = WCD9XXX_LDOH_3P0_V;
+	pdata->micbias.cfilt1_mv = 1800;
+	pdata->micbias.cfilt2_mv = 2700;
+	pdata->micbias.cfilt3_mv = 1800;
+	pdata->micbias.bias1_cfilt_sel = WCD9XXX_CFILT1_SEL;
+	pdata->micbias.bias2_cfilt_sel = WCD9XXX_CFILT2_SEL;
+	pdata->micbias.bias3_cfilt_sel = WCD9XXX_CFILT3_SEL;
+	pdata->micbias.bias1_cap_mode = MICBIAS_NO_EXT_BYP_CAP;
+	pdata->micbias.bias2_cap_mode = MICBIAS_NO_EXT_BYP_CAP;
+	pdata->micbias.bias3_cap_mode = MICBIAS_NO_EXT_BYP_CAP;
+	pdata->mclk_rate = TAPAN_MCLK_CLK_9P6MHZ;
+	pdata->dmic_sample_rate = WCD9XXX_DMIC_SAMPLE_RATE_UNDEFINED;
+
+	if (!of_property_read_u32(np, "qcom,ldoh-v", &v))
+		pdata->micbias.ldoh_v = v;
+	if (!of_property_read_u32(np, "qcom,micbias-cfilt1-mv", &v))
+		pdata->micbias.cfilt1_mv = v;
+	if (!of_property_read_u32(np, "qcom,micbias-cfilt2-mv", &v))
+		pdata->micbias.cfilt2_mv = v;
+	if (!of_property_read_u32(np, "qcom,micbias-cfilt3-mv", &v))
+		pdata->micbias.cfilt3_mv = v;
+	/* downstream qcom,cdc-micbias1-ext-cap (s3ve3g): MICBIAS1 with an external capacitor */
+	if (of_property_read_bool(np, "qcom,micbias1-ext-cap"))
+		pdata->micbias.bias1_cap_mode = MICBIAS_EXT_BYP_CAP;
+	if (of_property_read_bool(np, "qcom,micbias2-ext-cap"))
+		pdata->micbias.bias2_cap_mode = MICBIAS_EXT_BYP_CAP;
+	if (of_property_read_bool(np, "qcom,micbias3-ext-cap"))
+		pdata->micbias.bias3_cap_mode = MICBIAS_EXT_BYP_CAP;
+}
+
+static int tapan_parse_dt(struct tapan_priv *tapan)
+{
+	struct device *dev = tapan->dev;
+	int i, ret;
+
+	tapan->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(tapan->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(tapan->reset_gpio), "Reset GPIO missing\n");
+
+	tapan->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(tapan->mclk))
+		return dev_err_probe(dev, PTR_ERR(tapan->mclk), "MCLK missing\n");
+
+	for (i = 0; i < WCD9306_NUM_SUPPLIES; i++)
+		tapan->supplies[i].supply = wcd9306_supplies[i];
+
+	ret = devm_regulator_bulk_get(dev, WCD9306_NUM_SUPPLIES, tapan->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get supplies\n");
+
+	tapan_parse_pdata(tapan);
+
+	return 0;
+}
+
+static void tapan_power_off(void *data)
+{
+	struct tapan_priv *tapan = data;
+
+	gpiod_set_value_cansleep(tapan->reset_gpio, 1);
+	regulator_bulk_disable(WCD9306_SUPPLY_BUCK, tapan->supplies);
+}
+
+/* downstream wcd9xxx_slim_probe(): the static supplies, then reset (active low) */
+static int tapan_power_on_reset(struct tapan_priv *tapan)
+{
+	int ret;
+
+	/* vdd-h, vdd-px, vdd-cx; the charge pump's buck and buck helper go with its widget */
+	ret = regulator_bulk_enable(WCD9306_SUPPLY_BUCK, tapan->supplies);
+	if (ret)
+		return dev_err_probe(tapan->dev, ret, "Failed to enable supplies\n");
+
+	ret = devm_add_action_or_reset(tapan->dev, tapan_power_off, tapan);
+	if (ret)
+		return ret;
+
+	usleep_range(5, 10);
+
+	gpiod_set_value_cansleep(tapan->reset_gpio, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(tapan->reset_gpio, 0);
+	msleep(20);
+
+	return 0;
+}
+
+/* downstream wcd9xxx_check_codec_type() and wcd9xxx_bring_up() */
+static int tapan_bring_up(struct tapan_priv *tapan)
+{
+	struct regmap *rm = tapan->regmap;
+	unsigned int id[4], ver;
+	int ret, i;
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_read(rm, WCD9XXX_A_CHIP_ID_BYTE_0 + i, &id[i]);
+		if (ret) {
+			u8 v = 0;
+			int r2 = slim_read(tapan->slim, WCD9306_SLIM_REG_BASE + WCD9XXX_A_CHIP_ID_BYTE_0 + i, 1, &v);
+
+			return dev_err_probe(tapan->dev, ret, "Failed to read the chip id (byte %d; slim_read %d: %#x)\n",
+					     i, r2, v);
+		}
+	}
+	ret = regmap_read(rm, WCD9XXX_A_CHIP_VERSION, &ver);
+	if (ret)
+		return ret;
+	tapan->version = ver & 0x1f;
+
+	/* Tapan: major 0x0103 (bytes 2, 3), minor 0 or 1 (bytes 0, 1) */
+	if (id[2] != 0x03 || id[3] != 0x01)
+		return dev_err_probe(tapan->dev, -ENODEV, "not a Tapan: chip id %02x %02x %02x %02x\n",
+				     id[0], id[1], id[2], id[3]);
+
+	regmap_write(rm, WCD9XXX_A_LEAKAGE_CTL, 0x04);
+	regmap_write(rm, WCD9XXX_A_CDC_CTL, 0x00);
+	usleep_range(5000, 5500);
+	regmap_write(rm, WCD9XXX_A_CDC_CTL, 0x03);
+	regmap_write(rm, WCD9XXX_A_LEAKAGE_CTL, 0x03);
+
+	/* the interrupt lines, unused: all masked (downstream wcd9xxx_irq_init()) */
+	for (i = 0; i < 4; i++) {
+		regmap_write(rm, WCD9XXX_A_INTR_LEVEL0 + i, i == 0 ? 1 : 0);
+		regmap_write(rm, WCD9XXX_A_INTR_MASK0 + i, 0xff);
+	}
+
+	tapan->codec_ver = tapan_check_wcd9306(tapan, false) ? WCD9306 : WCD9302;
+	dev_info(tapan->dev, "%s, chip id %02x %02x %02x %02x, version %u\n",
+		 tapan->codec_ver == WCD9306 ? "WCD9306" : "WCD9302",
+		 id[0], id[1], id[2], id[3], tapan->version);
+
+	return 0;
+}
+
+static int tapan_slim_probe(struct slim_device *slim)
+{
+	struct device *dev = &slim->dev;
+	struct tapan_priv *tapan;
+	int ret;
+
+	tapan = devm_kzalloc(dev, sizeof(*tapan), GFP_KERNEL);
+	if (!tapan)
+		return -ENOMEM;
+
+	tapan->dev = dev;
+	tapan->resmgr.pdata = &tapan->pdata;
+	mutex_init(&tapan->resmgr.codec_bg_clk_lock);
+	mutex_init(&tapan->resmgr.codec_resource_lock);
+	memcpy(tapan->rx_chs, tapan_rx_chs, sizeof(tapan_rx_chs));
+	memcpy(tapan->tx_chs, tapan_tx_chs, sizeof(tapan_tx_chs));
+	for (int i = 0; i < TAPAN_RX_MAX; i++)
+		INIT_LIST_HEAD(&tapan->rx_chs[i].list);
+	for (int i = 0; i < TAPAN_TX_MAX; i++)
+		INIT_LIST_HEAD(&tapan->tx_chs[i].list);
+
+	ret = tapan_parse_dt(tapan);
+	if (ret)
+		return ret;
+
+	ret = tapan_power_on_reset(tapan);
+	if (ret)
+		return ret;
+
+	dev_set_drvdata(dev, tapan);
+
+	/*
+	 * The codec was just reset: have the core report it up again after the probe (on a rebind
+	 * the device's status is still up from before, and the status callback wouldn't come)
+	 */
+	slim->status = SLIM_DEVICE_STATUS_DOWN;
+
+	return 0;
+}
+
+static void tapan_regmap_exit(void *data)
+{
+	regmap_exit(data);
+}
+
+static int tapan_slim_status(struct slim_device *sdev, enum slim_device_status status)
+{
+	struct device *dev = &sdev->dev;
+	struct tapan_priv *tapan = dev_get_drvdata(dev);
+	struct device_node *ifc_dev_np;
+	int ret, i;
+
+	dev_dbg(dev, "status %d, logical address %#x\n", status, sdev->laddr);
+	if (!tapan || status != SLIM_DEVICE_STATUS_UP || tapan->regmap)
+		return 0;
+
+	ifc_dev_np = of_parse_phandle(dev->of_node, "slim-ifc-dev", 0);
+	if (!ifc_dev_np)
+		return dev_err_probe(dev, -EINVAL, "No interface device\n");
+
+	tapan->slim = sdev;
+	tapan->slim_ifc_dev = of_slim_get_device(sdev->ctrl, ifc_dev_np);
+	of_node_put(ifc_dev_np);
+	if (!tapan->slim_ifc_dev)
+		return dev_err_probe(dev, -EINVAL, "Unable to get the SLIMbus interface device\n");
+
+	/* without a logical address the interface device's messages are NACKed */
+	ret = slim_get_logical_addr(tapan->slim_ifc_dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "No logical address for the interface device\n");
+
+	/* the power-on values (downstream tapan_reset_reg_defaults) as the cache's defaults */
+	tapan_regmap_config.num_reg_defaults = 0;
+	for (i = 0; i < TAPAN_NUM_REGISTERS; i++) {
+		if (!tapan_reg_readable[i] || tapan_regmap_volatile(dev, i))
+			continue;
+		tapan_reg_defaults_cache[tapan_regmap_config.num_reg_defaults].reg = i;
+		tapan_reg_defaults_cache[tapan_regmap_config.num_reg_defaults].def =
+			tapan_reset_reg_defaults[i];
+		tapan_regmap_config.num_reg_defaults++;
+	}
+	tapan_regmap_config.reg_defaults = tapan_reg_defaults_cache;
+
+	/*
+	 * Not devm_regmap_init_slimbus(): __devm_regmap_init_slimbus() passes the address of its
+	 * local pointer as the bus context (&slimbus), so every access goes through a stale stack
+	 * address (-EINVAL or an oops in slim_do_transfer()); wcd9335 avoids it the same way
+	 */
+	tapan->regmap = regmap_init_slimbus(sdev, &tapan_regmap_config);
+	if (IS_ERR(tapan->regmap))
+		return dev_err_probe(dev, PTR_ERR(tapan->regmap),
+				     "Failed to allocate the register map\n");
+	ret = devm_add_action_or_reset(dev, tapan_regmap_exit, tapan->regmap);
+	if (ret)
+		return ret;
+
+	tapan->if_regmap = regmap_init_slimbus(tapan->slim_ifc_dev, &tapan_ifc_regmap_config);
+	if (IS_ERR(tapan->if_regmap))
+		return dev_err_probe(dev, PTR_ERR(tapan->if_regmap),
+				     "Failed to allocate the interface register map\n");
+	ret = devm_add_action_or_reset(dev, tapan_regmap_exit, tapan->if_regmap);
+	if (ret)
+		return ret;
+
+	ret = tapan_bring_up(tapan);
+	if (ret)
+		return ret;
+
+	return devm_snd_soc_register_component(dev, &tapan_component_drv, tapan_dai,
+					       ARRAY_SIZE(tapan_dai));
+}
+
+static const struct slim_device_id tapan_slim_id[] = {
+	{ WCD9306_SLIM_MANF_ID, WCD9306_SLIM_PROD_CODE, 0x1, 0x0 },
+	{}
+};
+MODULE_DEVICE_TABLE(slim, tapan_slim_id);
+
+static struct slim_driver tapan_slim_driver = {
+	.driver = {
+		.name = "wcd9306-slim",
+	},
+	.probe = tapan_slim_probe,
+	.device_status = tapan_slim_status,
+	.id_table = tapan_slim_id,
+};
+module_slim_driver(tapan_slim_driver);
+
+MODULE_DESCRIPTION("WCD9306 (Tapan) audio codec driver");
+MODULE_LICENSE("GPL");

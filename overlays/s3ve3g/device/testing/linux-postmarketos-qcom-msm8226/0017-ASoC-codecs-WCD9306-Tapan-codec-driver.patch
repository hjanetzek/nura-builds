+static int slim_tx_mixer_put(struct snd_kcontrol *kc, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *w = snd_soc_dapm_kcontrol_widget(kc);
+	struct tapan_priv *tapan = dev_get_drvdata(w->dapm->dev);
+	struct soc_mixer_control *mixer = (struct soc_mixer_control *)kc->private_value;
+	int enable = ucontrol->value.integer.value[0];
+	int dai_id = w->shift;
+	int port_id = mixer->shift;
+
+	if (port_id >= TAPAN_TX_MAX)
+		return -EINVAL;
+
+	switch (dai_id) {
+	case AIF1_CAP:
+	case AIF2_CAP:
+	case AIF3_CAP:
+		/* a port can only be on one capture interface */
+		if (enable && !(tapan->tx_port_value & BIT(port_id))) {
+			tapan->tx_port_value |= BIT(port_id);
+			list_add_tail(&tapan->tx_chs[port_id].list,
+				      &tapan->dai[dai_id].wcd9xxx_ch_list);
+		} else if (!enable && (tapan->tx_port_value & BIT(port_id))) {
+			tapan->tx_port_value &= ~BIT(port_id);
+			list_del_init(&tapan->tx_chs[port_id].list);
+		} else {
+			return 0;
+		}
+		break;
+	default:
+		dev_err(tapan->dev, "Unknown AIF %d\n", dai_id);
+		return -EINVAL;
+	}
+
+	snd_soc_dapm_mixer_update_power(w->dapm, kc, enable, NULL);
+
+	return 1;
+}

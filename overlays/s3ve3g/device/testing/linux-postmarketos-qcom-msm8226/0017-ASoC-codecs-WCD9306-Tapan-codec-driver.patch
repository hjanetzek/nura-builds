+static int tapan_codec_probe(struct snd_soc_component *codec)
+{
+	struct tapan_priv *tapan = snd_soc_component_get_drvdata(codec);
+	struct snd_soc_dapm_context *dapm = snd_soc_component_get_dapm(codec);
+	int ret, i;
+
+	snd_soc_component_init_regmap(codec, tapan->regmap);
+	tapan->codec = codec;
+	tapan->resmgr.codec = codec;
+
+	for (i = 0; i < NUM_DECIMATORS; i++) {
+		tx_hpf_work[i].tapan = tapan;
+		tx_hpf_work[i].decimator = i + 1;
+		INIT_DELAYED_WORK(&tx_hpf_work[i].dwork, tx_hpf_corner_freq_callback);
+	}
+
+	tapan->ldo_h_count = 0;
+	tapan->cp_regulators[CP_REG_BUCK] = tapan->supplies[WCD9306_SUPPLY_BUCK].consumer;
+	tapan->cp_regulators[CP_REG_BHELPER] = tapan->supplies[WCD9306_SUPPLY_BHELPER].consumer;
+
+	/*
+	 * The S4 voltage requested downstream (qcom,cdc-vdd-buck-voltage = <1800000 2150000>):
+	 * 1.8 V, so S4 is taken as switchable between 1.8 and 2.15 V
+	 */
+	tapan->clsh_d.buck_mv = WCD9XXX_CDC_BUCK_MV_1P8;
+	tapan->clsh_d.is_dynamic_vdd_cp = true;
+	wcd9306_clsh_init(&tapan->clsh_d);
+
+	tapan->micb_2_ref_cnt = 0;
+	for (i = 0; i < COMPANDER_MAX; i++) {
+		tapan->comp_enabled[i] = 0;
+		tapan->comp_fs[i] = COMPANDER_FS_48KHZ;
+	}
+	tapan->aux_pga_cnt = 0;
+	tapan->aux_l_gain = 0x1F;
+	tapan->aux_r_gain = 0x1F;
+	tapan->ldo_h_users = 0;
+	tapan->micb_2_users = 0;
+	tapan_update_reg_defaults(codec);
+	tapan_update_reg_mclk_rate(codec);
+	tapan_codec_init_reg(codec);
+	ret = tapan_handle_pdata(tapan);
+	if (ret < 0) {
+		dev_err(codec->dev, "%s: bad pdata\n", __func__);
+		return ret;
+	}
+
+	if (spkr_drv_wrnd > 0) {
+		WCD9XXX_BG_CLK_LOCK(&tapan->resmgr);
+		wcd9xxx_resmgr_get_bandgap(&tapan->resmgr, WCD9XXX_BANDGAP_AUDIO_MODE);
+		WCD9XXX_BG_CLK_UNLOCK(&tapan->resmgr);
+	}
+
+	for (i = 0; i < NUM_CODEC_DAIS; i++)
+		INIT_LIST_HEAD(&tapan->dai[i].wcd9xxx_ch_list);
+
+	if (tapan->codec_ver == WCD9306) {
+		snd_soc_add_component_controls(codec, tapan_9306_snd_controls,
+					       ARRAY_SIZE(tapan_9306_snd_controls));
+		snd_soc_dapm_new_controls(dapm, tapan_9306_dapm_widgets,
+					  ARRAY_SIZE(tapan_9306_dapm_widgets));
+		snd_soc_dapm_add_routes(dapm, wcd9306_map, ARRAY_SIZE(wcd9306_map));
+	}
+
+	snd_soc_dapm_new_controls(dapm, tapan_mclk_widgets, ARRAY_SIZE(tapan_mclk_widgets));
+	snd_soc_dapm_add_routes(dapm, tapan_mclk_routes, ARRAY_SIZE(tapan_mclk_routes));
+
+	/* the SLIMbus port interrupts, unused (no interrupt handler), enabled as downstream */
+	tapan_slim_interface_init_reg(codec);
+
+	return 0;
+}
+
+static void tapan_codec_remove(struct snd_soc_component *codec)
+{
+	struct tapan_priv *tapan = snd_soc_component_get_drvdata(codec);
+	int i;
+
+	for (i = 0; i < NUM_DECIMATORS; i++)
+		cancel_delayed_work_sync(&tx_hpf_work[i].dwork);
+
+	WCD9XXX_BG_CLK_LOCK(&tapan->resmgr);
+	if (spkr_drv_wrnd > 0)
+		wcd9xxx_resmgr_put_bandgap(&tapan->resmgr, WCD9XXX_BANDGAP_AUDIO_MODE);
+	WCD9XXX_BG_CLK_UNLOCK(&tapan->resmgr);
+
+	for (i = 0; i < NUM_CODEC_DAIS; i++)
+		if (tapan->dai[i].sruntime)
+			slim_stream_free(tapan->dai[i].sruntime);
+}

+static bool tapan_check_wcd9306(struct tapan_priv *tapan, bool sensed)
+{
+	struct device *cdc_dev = tapan->dev;
+	u8 reg_val;
+	bool ret = true;
+	unsigned long timeout;
+	bool timedout;
+
+	tapan_enable_config_rco(tapan, 1);
+
+	if (sensed == false) {
+		reg_val = tapan_reg_read(tapan, TAPAN_A_QFUSE_CTL);
+		regmap_write(tapan->regmap, TAPAN_A_QFUSE_CTL,
+					(reg_val | 0x03));
+	}
+
+	timeout = jiffies + HZ;
+	do {
+		if ((tapan_reg_read(tapan, TAPAN_A_QFUSE_STATUS)))
+			break;
+	} while (!(timedout = time_after(jiffies, timeout)));
+
+	if (tapan_reg_read(tapan, TAPAN_A_QFUSE_DATA_OUT1) ||
+	    tapan_reg_read(tapan, TAPAN_A_QFUSE_DATA_OUT2)) {
+		dev_info(cdc_dev, "%s: wcd9302 detected\n", __func__);
+		ret = false;
+	} else
+		dev_info(cdc_dev, "%s: wcd9306 detected\n", __func__);
+
+	tapan_enable_config_rco(tapan, 0);
+	return ret;
+}

+static int slim_tx_mixer_get(struct snd_kcontrol *kc, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_widget *w = snd_soc_dapm_kcontrol_widget(kc);
+	struct tapan_priv *tapan = dev_get_drvdata(w->dapm->dev);
+	struct soc_mixer_control *mixer = (struct soc_mixer_control *)kc->private_value;
+	int dai_id = w->shift;
+	int port_id = mixer->shift;
+	struct wcd9xxx_ch *ch;
+
+	/* this port's own bit on this interface, not the whole set */
+	ucontrol->value.integer.value[0] = 0;
+	if (dai_id < NUM_CODEC_DAIS && (tapan->tx_port_value & BIT(port_id)))
+		list_for_each_entry(ch, &tapan->dai[dai_id].wcd9xxx_ch_list, list)
+			if (ch->port == port_id)
+				ucontrol->value.integer.value[0] = 1;
+
+	return 0;
+}

+/* the slave ports' channel mapping, watermark and enable; the stream runtime */
+static int tapan_slim_set_hw_params(struct tapan_priv *tapan,
+				    struct wcd9xxx_codec_dai_data *dai_data, int direction)
+{
+	struct list_head *slim_ch_list = &dai_data->wcd9xxx_ch_list;
+	struct slim_stream_config *cfg = &dai_data->sconfig;
+	struct wcd9xxx_ch *ch;
+	u16 payload = 0;
+	int ret, i;
+
+	cfg->ch_count = 0;
+	cfg->direction = direction;
+	cfg->port_mask = 0;
+
+	list_for_each_entry(ch, slim_ch_list, list) {
+		cfg->ch_count++;
+		payload |= 1 << ch->shift;
+		cfg->port_mask |= BIT(ch->port);
+	}
+
+	if (!cfg->ch_count) {
+		dev_err(tapan->dev, "no SLIMbus channels routed to this interface\n");
+		return -EINVAL;
+	}
+
+	kfree(cfg->chs);
+	cfg->chs = kcalloc(cfg->ch_count, sizeof(unsigned int), GFP_KERNEL);
+	if (!cfg->chs)
+		return -ENOMEM;
+
+	i = 0;
+	list_for_each_entry(ch, slim_ch_list, list) {
+		cfg->chs[i++] = ch->ch_num;
+		if (direction == SNDRV_PCM_STREAM_PLAYBACK) {
+			ret = regmap_write(tapan->if_regmap,
+					   SB_PGD_RX_PORT_MULTI_CHANNEL_0(ch->port), payload);
+			if (ret < 0)
+				goto err;
+			ret = regmap_write(tapan->if_regmap, SB_PGD_PORT_RX_CFG(ch->port),
+					   SB_PGD_PORT_WATERMARK_EN);
+			if (ret < 0)
+				goto err;
+		} else {
+			ret = regmap_write(tapan->if_regmap,
+					   SB_PGD_TX_PORT_MULTI_CHANNEL_0(ch->port), payload & 0xff);
+			if (ret < 0)
+				goto err;
+			ret = regmap_write(tapan->if_regmap,
+					   SB_PGD_TX_PORT_MULTI_CHANNEL_1(ch->port),
+					   (payload & 0xff00) >> 8);
+			if (ret < 0)
+				goto err;
+			ret = regmap_write(tapan->if_regmap, SB_PGD_PORT_TX_CFG(ch->port),
+					   SB_PGD_PORT_WATERMARK_EN);
+			if (ret < 0)
+				goto err;
+		}
+	}
+
+	/* one runtime per interface, allocated once */
+	if (!dai_data->sruntime) {
+		dai_data->sruntime = slim_stream_allocate(tapan->slim, "WCD9306-SLIM");
+		if (IS_ERR(dai_data->sruntime)) {
+			ret = PTR_ERR(dai_data->sruntime);
+			dai_data->sruntime = NULL;
+			goto err;
+		}
+	}
+
+	return 0;
+
+err:
+	dev_err(tapan->dev, "Error setting the SLIMbus parameters: %d\n", ret);
+	kfree(cfg->chs);
+	cfg->chs = NULL;
+
+	return ret;
+}
+
+static void tapan_slim_ports_disable(struct tapan_priv *tapan,
+				     struct wcd9xxx_codec_dai_data *dai_data, int direction)
+{
+	struct wcd9xxx_ch *ch;
+
+	list_for_each_entry(ch, &dai_data->wcd9xxx_ch_list, list) {
+		if (direction == SNDRV_PCM_STREAM_PLAYBACK)
+			regmap_write(tapan->if_regmap, SB_PGD_PORT_RX_CFG(ch->port), 0);
+		else
+			regmap_write(tapan->if_regmap, SB_PGD_PORT_TX_CFG(ch->port), 0);
+	}
+}
+
+static int tapan_slim_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params, struct snd_soc_dai *dai)
+{
+	struct tapan_priv *tapan = snd_soc_component_get_drvdata(dai->component);
+	struct wcd9xxx_codec_dai_data *dai_data = &tapan->dai[dai->id];
+	int ret;
+
+	ret = tapan_hw_params(substream, params, dai);
+	if (ret)
+		return ret;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		dai_data->sconfig.bps = 16;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+		dai_data->sconfig.bps = 24;
+		break;
+	default:
+		return -EINVAL;
+	}
+	dai_data->sconfig.rate = params_rate(params);
+
+	/* before the trigger: the slave ports must be set up when the stream starts */
+	return tapan_slim_set_hw_params(tapan, dai_data, substream->stream);
+}
+
+static int tapan_trigger(struct snd_pcm_substream *substream, int cmd, struct snd_soc_dai *dai)
+{
+	struct tapan_priv *tapan = snd_soc_component_get_drvdata(dai->component);
+	struct wcd9xxx_codec_dai_data *dai_data = &tapan->dai[dai->id];
+	int ret = 0;
+
+	if (!dai_data->sruntime)
+		return 0;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		ret = slim_stream_prepare(dai_data->sruntime, &dai_data->sconfig);
+		if (ret) {
+			dev_err(tapan->dev, "Cannot prepare the SLIMbus stream: %d\n", ret);
+			break;
+		}
+		ret = slim_stream_enable(dai_data->sruntime);
+		if (ret)
+			dev_err(tapan->dev, "Cannot enable the SLIMbus stream: %d\n", ret);
+		else
+			dai_data->stream_up = true;
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		if (!dai_data->stream_up)
+			break;
+		/* the DSP has to be told the port is done, or it refuses the next start */
+		slim_stream_disable(dai_data->sruntime);
+		slim_stream_unprepare(dai_data->sruntime);
+		dai_data->stream_up = false;
+		tapan_slim_ports_disable(tapan, dai_data, substream->stream);
+		break;
+	default:
+		break;
+	}
+
+	return ret;
+}

+/* ---- mainline: the codec's master clock (downstream: the machine driver's MCLK widget) ---- */
+
+/*
+ * The 9.6 MHz MCLK is the PMIC's divided crystal clock on PM8226 GPIO1 (function 1), switched by
+ * the RPM (div_clk1, downstream "osr_clk"); the pin's function comes from the device tree
+ */
+static int tapan_codec_mclk(struct snd_soc_component *codec, bool enable)
+{
+	struct tapan_priv *tapan = snd_soc_component_get_drvdata(codec);
+	int ret = 0;
+
+	/* reference counted, as downstream msm_snd_enable_codec_ext_clk(): DAPM and micbias */
+	mutex_lock(&tapan->resmgr.codec_resource_lock);
+	if (enable) {
+		if (tapan->mclk_users++ == 0) {
+			ret = clk_prepare_enable(tapan->mclk);
+			if (ret) {
+				dev_err(codec->dev, "Failed to enable MCLK: %d\n", ret);
+				tapan->mclk_users--;
+				goto out;
+			}
+			tapan_mclk_enable(codec, 1, true);
+		}
+	} else {
+		if (WARN_ON(!tapan->mclk_users))
+			goto out;
+		if (--tapan->mclk_users == 0) {
+			tapan_mclk_enable(codec, 0, true);
+			clk_disable_unprepare(tapan->mclk);
+		}
+	}
+out:
+	mutex_unlock(&tapan->resmgr.codec_resource_lock);
+	return ret;
+}
+
+static int tapan_codec_enable_mclk(struct snd_soc_dapm_widget *w,
+				   struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *codec = snd_soc_dapm_to_component(w->dapm);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		return tapan_codec_mclk(codec, true);
+	case SND_SOC_DAPM_POST_PMD:
+		return tapan_codec_mclk(codec, false);
+	}
+
+	return 0;
+}

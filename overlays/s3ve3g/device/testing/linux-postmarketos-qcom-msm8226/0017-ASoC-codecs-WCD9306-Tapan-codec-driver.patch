+++ b/sound/soc/codecs/wcd9306-regs.h
@@ -0,0 +1,1295 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * WCD9306 (Tapan) registers, from the downstream msm-3.4 wcd9xxx_registers.h and
+ * wcd9306_registers.h (Copyright (c) 2012-2013, The Linux Foundation), names kept.
+ * Over SLIMbus they are the value elements from 0x800 on (the regmap's reg_base).
+ */
+#ifndef __WCD9306_REGS_H__
+#define __WCD9306_REGS_H__
+
+#define WCD9XXX_A_CHIP_CTL                        0x00
+#define WCD9XXX_A_CHIP_STATUS                     0x01
+#define WCD9XXX_A_CHIP_ID_BYTE_0                  0x04

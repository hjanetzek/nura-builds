+static bool tapan_regmap_readable(struct device *dev, unsigned int reg)
+{
+	return reg < TAPAN_NUM_REGISTERS && tapan_reg_readable[reg];
+}
+
+/* downstream tapan_volatile() */
+static bool tapan_regmap_volatile(struct device *dev, unsigned int reg)
+{
+	/* top level registers, also written by the core; MBHC */
+	if (reg >= TAPAN_A_CDC_MBHC_EN_CTL || reg < 0x100)
+		return true;
+
+	/* IIR coefficient registers */
+	if (reg >= TAPAN_A_CDC_IIR1_COEF_B1_CTL && reg <= TAPAN_A_CDC_IIR2_COEF_B2_CTL)
+		return true;
+
+	/* ANC filter registers */
+	if (reg >= TAPAN_A_CDC_ANC1_IIR_B1_CTL && reg <= TAPAN_A_CDC_ANC1_LPF_B2_CTL)
+		return true;
+	if (reg >= TAPAN_A_CDC_ANC2_IIR_B1_CTL && reg <= TAPAN_A_CDC_ANC2_LPF_B2_CTL)
+		return true;
+
+	/* digital gains: written even when unchanged */
+	if (tapan_is_digital_gain_register(reg))
+		return true;
+
+	/* HPH status registers */
+	if (reg == TAPAN_A_RX_HPH_L_STATUS || reg == TAPAN_A_RX_HPH_R_STATUS)
+		return true;
+
+	if (reg == TAPAN_A_MBHC_INSERT_DET_STATUS)
+		return true;
+
+	/* the AFE's codec register configuration (downstream audio_reg_cfg) */
+	if (reg == TAPAN_A_CDC_ANC1_IIR_B1_CTL || reg == TAPAN_A_CDC_ANC1_GAIN_CTL)
+		return true;
+
+	return false;
+}

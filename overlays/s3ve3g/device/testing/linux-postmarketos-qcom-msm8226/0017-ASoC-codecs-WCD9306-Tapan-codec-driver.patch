+static void tapan_enable_config_rco(struct tapan_priv *tapan, bool enable)
+{
+
+	if (enable) {
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_BIAS_CENTRAL_BG_CTL,
+				   0x80, 0x80);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_BIAS_CENTRAL_BG_CTL,
+				   0x04, 0x04);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_BIAS_CENTRAL_BG_CTL,
+				   0x01, 0x01);
+		usleep_range(1000, 1000 + 10);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_BIAS_CENTRAL_BG_CTL,
+				   0x80, 0x00);
+
+		/* Enable RC Oscillator */
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_RC_OSC_FREQ, 0x10, 0x00);
+		regmap_write(tapan->regmap, WCD9XXX_A_BIAS_OSC_BG_CTL, 0x17);
+		usleep_range(5, 5 + 10);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_RC_OSC_FREQ, 0x80, 0x80);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_RC_OSC_TEST, 0x80, 0x80);
+		usleep_range(10, 10 + 10);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_RC_OSC_TEST, 0x80, 0x00);
+		usleep_range(20, 20 + 10);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN1, 0x08, 0x08);
+		/* Enable MCLK and wait 1ms till it gets enabled */
+		regmap_write(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN2, 0x02);
+		usleep_range(1000, 1000 + 10);
+		/* Enable CLK BUFF and wait for 1.2ms */
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN1, 0x01, 0x01);
+		usleep_range(1000, 1200);
+
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN2, 0x02, 0x00);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN2, 0x04, 0x04);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CDC_CLK_MCLK_CTL,
+				   0x01, 0x01);
+		usleep_range(50, 50 + 10);
+	} else {
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN2, 0x04, 0x00);
+		usleep_range(50, 50 + 10);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN2, 0x02, 0x02);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_CLK_BUFF_EN1, 0x05, 0x00);
+		usleep_range(50, 50 + 10);
+
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_RC_OSC_FREQ, 0x80, 0x00);
+		usleep_range(10, 10 + 10);
+		regmap_write(tapan->regmap, WCD9XXX_A_BIAS_OSC_BG_CTL, 0x16);
+		regmap_update_bits(tapan->regmap, WCD9XXX_A_BIAS_CENTRAL_BG_CTL,
+				   0x03, 0x00);
+		usleep_range(100, 100 + 10);
+	}
+
+}

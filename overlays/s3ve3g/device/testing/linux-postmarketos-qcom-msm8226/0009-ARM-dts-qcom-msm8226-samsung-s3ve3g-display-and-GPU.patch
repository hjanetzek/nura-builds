From: nura-builds
Subject: [PATCH] ARM: dts: qcom: msm8226-samsung-s3ve3g: display (MDSS, DSI, panel) and GPU

MDSS with DSI0 and the S6E8AA0A panel (supplies L4/L15/L8, reset on
GPIO 25, power on GPIO 73, 4 lanes), and the Adreno 305B (no IOMMU:
msm.allow_vram_carveout).
---
diff --git a/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts b/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts
--- a/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8226-samsung-s3ve3g.dts
@@ -402,6 +402,45 @@
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&mdss {
+	status = "okay";
+};
+
+/* the panel: S6E8AA0A AMOLED, 720x1280 video mode, 4 lanes (downstream msm8226-sec-s3ve3geur-r04) */
+&mdss_dsi0 {
+	vdda-supply = <&pm8226_l4>;
+	vdd-supply = <&pm8226_l15>;
+	vddio-supply = <&pm8226_l8>;
+
+	panel@0 {
+		compatible = "samsung,s3ve3g-panel-s6e8aa0a";
+		reg = <0>;
+
+		reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+		/* qcom,disp-on-gpio */
+		enable-gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vddio-supply = <&pm8226_l8>;
+};
+
 &pronto {
 	vddmx-supply = <&pm8226_l3>;
 	vddpx-supply = <&pm8226_l6>;

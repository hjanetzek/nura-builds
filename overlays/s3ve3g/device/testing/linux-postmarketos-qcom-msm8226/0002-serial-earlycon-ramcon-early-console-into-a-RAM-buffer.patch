From: nura-builds
Subject: [PATCH] serial: earlycon: ramcon, an early console into a RAM buffer

For boards whose UART is not usable: the kernel log from the first
moments of boot until a crash or reset, in RAM the bootloader keeps, in
the format of pstore ram_core / Android persistent_ram ("DBGC"), so a
downstream kernel shows it as /proc/last_kmsg after a warm reset.
earlycon=ramcon,<physical address>; one page (the fixmap), as a ring.
---
diff --git a/drivers/tty/serial/Makefile b/drivers/tty/serial/Makefile
index d58d9f7..cb7e332 100644
--- a/drivers/tty/serial/Makefile
+++ b/drivers/tty/serial/Makefile
@@ -6,7 +6,7 @@
 obj-$(CONFIG_SERIAL_CORE) += serial_base.o
 serial_base-y := serial_core.o serial_base_bus.o serial_ctrl.o serial_port.o
 
-obj-$(CONFIG_SERIAL_EARLYCON) += earlycon.o
+obj-$(CONFIG_SERIAL_EARLYCON) += earlycon.o earlycon-ramcon.o
 obj-$(CONFIG_SERIAL_EARLYCON_SEMIHOST) += earlycon-semihost.o
 obj-$(CONFIG_SERIAL_EARLYCON_RISCV_SBI) += earlycon-riscv-sbi.o
 
diff --git a/drivers/tty/serial/earlycon-ramcon.c b/drivers/tty/serial/earlycon-ramcon.c
new file mode 100644
index 0000000..f99c063
--- /dev/null
+++ b/drivers/tty/serial/earlycon-ramcon.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Early console into a RAM buffer, for boards whose UART isn't usable: the kernel log from the
+ * first moments of boot (earlycon) until a crash or reset, kept in RAM that the bootloader leaves
+ * alone, in the format of pstore's ram_core and Android's persistent_ram (header "DBGC", write
+ * position, size), so that a downstream kernel's ram_console shows it as /proc/last_kmsg after a
+ * warm reset.
+ *
+ *	earlycon=ramcon,<physical address>
+ *
+ * The fixmap maps one page: the last PAGE_SIZE - 12 bytes of the log, as a ring.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/serial_core.h>
+
+#define RAMCON_SIG	0x43474244	/* "DBGC" */
+#define RAMCON_HDR	12		/* sig, start, size */
+#define RAMCON_DATA	(PAGE_SIZE - RAMCON_HDR)
+
+static void ramcon_write(struct console *con, const char *s, unsigned int n)
+{
+	struct earlycon_device *dev = con->data;
+	void __iomem *base = dev->port.membase;
+	u32 start = readl(base + 4);
+	u32 size = readl(base + 8);
+
+	if (start >= RAMCON_DATA || size > RAMCON_DATA)
+		start = size = 0;
+	while (n--) {
+		writeb(*s++, base + RAMCON_HDR + start);
+		if (++start == RAMCON_DATA)
+			start = 0;
+		if (size < RAMCON_DATA)
+			size++;
+	}
+	writel(start, base + 4);
+	writel(size, base + 8);
+}
+
+static int __init ramcon_setup(struct earlycon_device *dev, const char *opt)
+{
+	void __iomem *base = dev->port.membase;
+
+	if (!base || offset_in_page(dev->port.mapbase))
+		return -ENODEV;
+	writel(RAMCON_SIG, base);
+	writel(0, base + 4);
+	writel(0, base + 8);
+	dev->con->write = ramcon_write;
+	return 0;
+}
+EARLYCON_DECLARE(ramcon, ramcon_setup);

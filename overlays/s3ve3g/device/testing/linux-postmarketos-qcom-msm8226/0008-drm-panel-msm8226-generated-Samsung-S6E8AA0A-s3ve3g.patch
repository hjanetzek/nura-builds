+/* bring-up: leave the panel as the bootloader set it up (no reset, no init sequence) */
+static bool skip_init;
+module_param(skip_init, bool, 0644);
+MODULE_PARM_DESC(skip_init, "Don't reset and initialize the panel (keep the bootloader's setup)");
+
+/* bring-up: send the init sequence without power cycle and reset, logging the power mode */
+static bool no_reset;
+module_param(no_reset, bool, 0644);
+MODULE_PARM_DESC(no_reset, "Init sequence without power cycle/reset, power mode after each command");
+
+struct s6e8aa0a {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enable_gpio;
+	bool on;
+};

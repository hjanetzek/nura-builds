From: nura-builds
Subject: [PATCH] drm/panel: msm8226-generated: Samsung S6E8AA0A of the Galaxy S III Neo

The S III Neo's 720x1280 AMOLED in video mode, 4 lanes, as the generated
MSM8226 panel drivers: the init sequence and fixed gamma from the vendor
device tree (dsi-panel-s6e8aa0a-720p-video.dtsi), the power (disp-on)
and reset lines and reset sequence from the board's. No smart dimming,
so no brightness control yet.
---
diff --git a/drivers/gpu/drm/panel/msm8226-generated/Kconfig b/drivers/gpu/drm/panel/msm8226-generated/Kconfig
index 52de0ad..cff4558 100644
--- a/drivers/gpu/drm/panel/msm8226-generated/Kconfig
+++ b/drivers/gpu/drm/panel/msm8226-generated/Kconfig
@@ -13,4 +13,8 @@ config DRM_PANEL_LG_LENOK_LG4237
 	tristate "Lg LENOK LG4237"
 	default DRM_PANEL_MSM8226_GENERATED
 
+config DRM_PANEL_SAMSUNG_S3VE3G_S6E8AA0A
+	tristate "Samsung S3VE3G S6E8AA0A"
+	default DRM_PANEL_MSM8226_GENERATED
+
 endmenu
diff --git a/drivers/gpu/drm/panel/msm8226-generated/Makefile b/drivers/gpu/drm/panel/msm8226-generated/Makefile
index 4228332..7b9e933 100644
--- a/drivers/gpu/drm/panel/msm8226-generated/Makefile
+++ b/drivers/gpu/drm/panel/msm8226-generated/Makefile
@@ -1,2 +1,3 @@
 obj-$(CONFIG_DRM_PANEL_HTC_MEMUL_NOVATEK35521) += panel-htc-memul-novatek35521.o
 obj-$(CONFIG_DRM_PANEL_LG_LENOK_LG4237) += panel-lg-lenok-lg4237.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_S3VE3G_S6E8AA0A) += panel-samsung-s3ve3g-s6e8aa0a.o
diff --git a/drivers/gpu/drm/panel/msm8226-generated/panel-samsung-s3ve3g-s6e8aa0a.c b/drivers/gpu/drm/panel/msm8226-generated/panel-samsung-s3ve3g-s6e8aa0a.c
new file mode 100644
index 0000000..bbde019
--- /dev/null
+++ b/drivers/gpu/drm/panel/msm8226-generated/panel-samsung-s3ve3g-s6e8aa0a.c
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Samsung S6E8AA0A 720x1280 AMOLED (video mode) of the Samsung Galaxy S III Neo (s3ve3g).
+// In the style of linux-mdss-dsi-panel-driver-generator's drivers, written from the vendor device
+// tree (LineageOS android_kernel_samsung_msm8226, dsi-panel-s6e8aa0a-720p-video.dtsi):
+// the init sequence and fixed gamma (no smart dimming, so no brightness control yet).
+//   Copyright (c) 2013, The Linux Foundation. All rights reserved.
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+/* bring-up: leave the panel as the bootloader set it up (no reset, no init sequence) */
+static bool skip_init;
+module_param(skip_init, bool, 0644);
+MODULE_PARM_DESC(skip_init, "Don't reset and initialize the panel (keep the bootloader's setup)");
+
+/* bring-up: send the init sequence without power cycle and reset, logging the power mode */
+static bool no_reset;
+module_param(no_reset, bool, 0644);
+MODULE_PARM_DESC(no_reset, "Init sequence without power cycle/reset, power mode after each command");
+
+struct s6e8aa0a {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enable_gpio;
+};
+
+static inline struct s6e8aa0a *to_s6e8aa0a(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e8aa0a, panel);
+}
+
+/* qcom,platform-reset-sequence = <1 20 0 20 1 20>, the reset line active low */
+static void s6e8aa0a_reset(struct s6e8aa0a *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+}
+
+/* The vendor kernel's init sequence (dsi-panel-s6e8aa0a-720p-video.dtsi) */
+static int s6e8aa0a_on(struct s6e8aa0a *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf1, 0x5a, 0x5a);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf8, 0x59, 0x35, 0x00, 0x00, 0x00,
+				     0x94, 0x00, 0x3c, 0x7d, 0x10, 0x27, 0x08, 0x6e, 0x00, 0x00, 0x00,
+				     0x00, 0x42, 0x08, 0x6e, 0x00, 0x00, 0x00, 0x00, 0x08, 0x08, 0x23,
+				     0x37, 0xc0, 0xc1, 0x01, 0x81, 0xc1, 0x00, 0xc3, 0xf6, 0xf6, 0xc1);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x80, 0x03, 0x0d);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfa, 0x01, 0x3f, 0x12, 0x41, 0xb6,
+				     0xca, 0xb6, 0xb5, 0xc6, 0xb5, 0xc6, 0xd0, 0xc4, 0x9d, 0xa9, 0x9a,
+				     0xb5, 0xbd, 0xb4, 0x00, 0x9a, 0x00, 0x91, 0x00, 0xb0);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0x00, 0x02, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb6, 0x0c, 0x02, 0x03, 0x32, 0xc0,
+				     0x44, 0x44, 0xc0, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd9, 0x14, 0x40, 0x0c, 0xcb, 0xce,
+				     0x6e, 0xc4, 0x07, 0xc0, 0x41, 0xc1, 0x00, 0x60, 0x19);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf4, 0xcf, 0x0a, 0x15, 0x10, 0x19,
+				     0x33, 0x02);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1, 0x04, 0x65);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc1, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc0, 0x01, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	/* display on: in enable, with the video stream running */
+
+	return dsi_ctx.accum_err;
+}
+
+
+/* the manufacturer id (downstream samsung,panel-manufacture-id-read-cmds; lcd_id= of the bootloader) */
+static void s6e8aa0a_read_id(struct s6e8aa0a *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	u8 id[3] = { 0 };
+	int ret[3], i;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	for (i = 0; i < 3; i++)
+		ret[i] = mipi_dsi_dcs_read(ctx->dsi, 0xda + i, &id[i], 1);
+	dev_info(dev, "panel id %02x %02x %02x (read: %d %d %d)\n",
+		 id[0], id[1], id[2], ret[0], ret[1], ret[2]);
+}
+
+static int s6e8aa0a_prepare(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (skip_init) {
+		dev_info(dev, "skip_init: keeping the bootloader's panel setup\n");
+		s6e8aa0a_read_id(ctx);
+		return 0;
+	}
+
+	/* qcom,disp-on-gpio: the panel's power */
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	msleep(20);
+
+	if (!no_reset)
+		s6e8aa0a_reset(ctx);
+
+	ret = s6e8aa0a_on(ctx);
+	dev_info(dev, "init sequence sent: %d\n", ret);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void s6e8aa0a_log_power_mode(struct s6e8aa0a *ctx, const char *when)
+{
+	u8 mode = 0;
+	int ret;
+
+	ret = mipi_dsi_dcs_get_power_mode(ctx->dsi, &mode);
+	dev_info(&ctx->dsi->dev, "power mode %s: %#04x (%d)%s%s\n", when, mode, ret,
+		 mode & BIT(4) ? " sleep-out" : "",
+		 mode & BIT(2) ? " display-on" : "");
+}
+
+static int s6e8aa0a_enable(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	s6e8aa0a_log_power_mode(ctx, "before display on");
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	s6e8aa0a_log_power_mode(ctx, "after display on");
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8aa0a_disable(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+	/* sleep in here, with the video stream still running: in unprepare msm waits for a video done */
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8aa0a_unprepare(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+
+	/* display off and sleep in were sent in disable */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+
+	return 0;
+}
+
+/* 60 Hz; porches from the vendor device tree; 60 x 106 mm */
+static const struct drm_display_mode s6e8aa0a_mode = {
+	.clock = (720 + 315 + 2 + 25) * (1280 + 13 + 1 + 2) * 60 / 1000,
+	.hdisplay = 720,
+	.hsync_start = 720 + 315,
+	.hsync_end = 720 + 315 + 2,
+	.htotal = 720 + 315 + 2 + 25,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 13,
+	.vsync_end = 1280 + 13 + 1,
+	.vtotal = 1280 + 13 + 1 + 2,
+	.width_mm = 60,
+	.height_mm = 106,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int s6e8aa0a_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &s6e8aa0a_mode);
+}
+
+static const struct drm_panel_funcs s6e8aa0a_panel_funcs = {
+	.prepare = s6e8aa0a_prepare,
+	.enable = s6e8aa0a_enable,
+	.disable = s6e8aa0a_disable,
+	.unprepare = s6e8aa0a_unprepare,
+	.get_modes = s6e8aa0a_get_modes,
+};
+
+static int s6e8aa0a_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e8aa0a *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e8aa0a, panel,
+				   &s6e8aa0a_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	/* as the bootloader left them (splash on): reset deasserted, power on */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	/*
+	 * 4 lanes, burst video mode (qcom,mdss-dsi-traffic-mode = <2>), continuous clock
+	 * (qcom,mdss-force-clk-lane-hs), no EOT packet (no qcom,mdss-dsi-tx-eot-append), no sync
+	 * pulses (qcom,mdss-dsi-h-sync-pulse = <0>)
+	 */
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* continuous clock (qcom,mdss-force-clk-lane-hs); msm keeps it in LP-11 until after prepare */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_NO_EOT_PACKET;
+
+	ctx->panel.prepare_prev_first = true;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void s6e8aa0a_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e8aa0a *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e8aa0a_of_match[] = {
+	{ .compatible = "samsung,s3ve3g-panel-s6e8aa0a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e8aa0a_of_match);
+
+static struct mipi_dsi_driver s6e8aa0a_driver = {
+	.probe = s6e8aa0a_probe,
+	.remove = s6e8aa0a_remove,
+	.driver = {
+		.name = "panel-samsung-s3ve3g-s6e8aa0a",
+		.of_match_table = s6e8aa0a_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e8aa0a_driver);
+
+MODULE_DESCRIPTION("DRM driver for the Samsung Galaxy S III Neo's S6E8AA0A video mode DSI panel");
+MODULE_LICENSE("GPL");

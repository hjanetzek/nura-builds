+
+static inline struct s6e8aa0a *to_s6e8aa0a(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e8aa0a, panel);
+}
+
+/* qcom,platform-reset-sequence = <1 20 0 20 1 20>, the reset line active low */
+static void s6e8aa0a_reset(struct s6e8aa0a *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+}
+
+/* The vendor kernel's init sequence (dsi-panel-s6e8aa0a-720p-video.dtsi) */
+static int s6e8aa0a_on(struct s6e8aa0a *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf1, 0x5a, 0x5a);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf8, 0x59, 0x35, 0x00, 0x00, 0x00,
+				     0x94, 0x00, 0x3c, 0x7d, 0x10, 0x27, 0x08, 0x6e, 0x00, 0x00, 0x00,
+				     0x00, 0x42, 0x08, 0x6e, 0x00, 0x00, 0x00, 0x00, 0x08, 0x08, 0x23,
+				     0x37, 0xc0, 0xc1, 0x01, 0x81, 0xc1, 0x00, 0xc3, 0xf6, 0xf6, 0xc1);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x80, 0x03, 0x0d);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfa, 0x01, 0x3f, 0x12, 0x41, 0xb6,
+				     0xca, 0xb6, 0xb5, 0xc6, 0xb5, 0xc6, 0xd0, 0xc4, 0x9d, 0xa9, 0x9a,
+				     0xb5, 0xbd, 0xb4, 0x00, 0x9a, 0x00, 0x91, 0x00, 0xb0);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf6, 0x00, 0x02, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb6, 0x0c, 0x02, 0x03, 0x32, 0xc0,
+				     0x44, 0x44, 0xc0, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd9, 0x14, 0x40, 0x0c, 0xcb, 0xce,
+				     0x6e, 0xc4, 0x07, 0xc0, 0x41, 0xc1, 0x00, 0x60, 0x19);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf4, 0xcf, 0x0a, 0x15, 0x10, 0x19,
+				     0x33, 0x02);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1, 0x04, 0x65);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc1, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc0, 0x01, 0x00);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	/* display on: in enable, with the video stream running */
+
+	return dsi_ctx.accum_err;
+}

+
+/* the manufacturer id (downstream samsung,panel-manufacture-id-read-cmds; lcd_id= of the bootloader) */
+static void s6e8aa0a_read_id(struct s6e8aa0a *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	u8 id[3] = { 0 };
+	int ret[3], i;
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	for (i = 0; i < 3; i++)
+		ret[i] = mipi_dsi_dcs_read(ctx->dsi, 0xda + i, &id[i], 1);
+	dev_info(dev, "panel id %02x %02x %02x (read: %d %d %d)\n",
+		 id[0], id[1], id[2], ret[0], ret[1], ret[2]);
+}
+
+static int s6e8aa0a_set_brightness(struct s6e8aa0a *ctx, int level)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, s6e8aa0a_gamma_tables[level], GAMMA_TABLE_LEN);
+	/* gamma update */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8aa0a_bl_update_status(struct backlight_device *bl)
+{
+	struct s6e8aa0a *ctx = bl_get_data(bl);
+
+	/* sent with the panel on only; enable applies the current level */
+	if (!ctx->on)
+		return 0;
+
+	return s6e8aa0a_set_brightness(ctx, backlight_get_brightness(bl));
+}
+
+static const struct backlight_ops s6e8aa0a_bl_ops = {
+	.update_status = s6e8aa0a_bl_update_status,
+};
+
+static int s6e8aa0a_prepare(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (skip_init) {
+		dev_info(dev, "skip_init: keeping the bootloader's panel setup\n");
+		s6e8aa0a_read_id(ctx);
+		return 0;
+	}
+
+	/* qcom,disp-on-gpio: the panel's power */
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	msleep(20);
+
+	if (!no_reset)
+		s6e8aa0a_reset(ctx);
+
+	ret = s6e8aa0a_on(ctx);
+	dev_info(dev, "init sequence sent: %d\n", ret);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void s6e8aa0a_log_power_mode(struct s6e8aa0a *ctx, const char *when)
+{
+	u8 mode = 0;
+	int ret;
+
+	ret = mipi_dsi_dcs_get_power_mode(ctx->dsi, &mode);
+	dev_info(&ctx->dsi->dev, "power mode %s: %#04x (%d)%s%s\n", when, mode, ret,
+		 mode & BIT(4) ? " sleep-out" : "",
+		 mode & BIT(2) ? " display-on" : "");
+}
+
+static int s6e8aa0a_enable(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	s6e8aa0a_log_power_mode(ctx, "before display on");
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	s6e8aa0a_log_power_mode(ctx, "after display on");
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	/* drm_panel_enable() then calls backlight_enable(), which sends the current level */
+	ctx->on = true;
+
+	return 0;
+}
+
+static int s6e8aa0a_disable(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* drm_panel_disable() called backlight_disable() before */
+	ctx->on = false;
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+	/* sleep in here, with the video stream still running: in unprepare msm waits for a video done */
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8aa0a_unprepare(struct drm_panel *panel)
+{
+	struct s6e8aa0a *ctx = to_s6e8aa0a(panel);
+
+	/* display off and sleep in were sent in disable */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+
+	return 0;
+}
+
+/* 60 Hz; porches from the vendor device tree; 60 x 106 mm */
+static const struct drm_display_mode s6e8aa0a_mode = {
+	.clock = (720 + 315 + 2 + 25) * (1280 + 13 + 1 + 2) * 60 / 1000,
+	.hdisplay = 720,
+	.hsync_start = 720 + 315,
+	.hsync_end = 720 + 315 + 2,
+	.htotal = 720 + 315 + 2 + 25,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 13,
+	.vsync_end = 1280 + 13 + 1,
+	.vtotal = 1280 + 13 + 1 + 2,
+	.width_mm = 60,
+	.height_mm = 106,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int s6e8aa0a_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &s6e8aa0a_mode);
+}
+
+static const struct drm_panel_funcs s6e8aa0a_panel_funcs = {
+	.prepare = s6e8aa0a_prepare,
+	.enable = s6e8aa0a_enable,
+	.disable = s6e8aa0a_disable,
+	.unprepare = s6e8aa0a_unprepare,
+	.get_modes = s6e8aa0a_get_modes,
+};
+
+static int s6e8aa0a_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e8aa0a *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e8aa0a, panel,
+				   &s6e8aa0a_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	/* as the bootloader left them (splash on): reset deasserted, power on */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+				&s6e8aa0a_bl_ops, &(const struct backlight_properties) {
+					.type = BACKLIGHT_RAW,
+					.brightness = GAMMA_LEVEL_NUM - 1,
+					.max_brightness = GAMMA_LEVEL_NUM - 1,
+				});
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to register backlight device\n");
+
+	/*
+	 * 4 lanes, burst video mode (qcom,mdss-dsi-traffic-mode = <2>), continuous clock
+	 * (qcom,mdss-force-clk-lane-hs), no EOT packet (no qcom,mdss-dsi-tx-eot-append), no sync
+	 * pulses (qcom,mdss-dsi-h-sync-pulse = <0>)
+	 */
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* continuous clock (qcom,mdss-force-clk-lane-hs); msm keeps it in LP-11 until after prepare */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_NO_EOT_PACKET;
+
+	ctx->panel.prepare_prev_first = true;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void s6e8aa0a_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e8aa0a *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e8aa0a_of_match[] = {
+	{ .compatible = "samsung,s3ve3g-panel-s6e8aa0a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e8aa0a_of_match);
+
+static struct mipi_dsi_driver s6e8aa0a_driver = {
+	.probe = s6e8aa0a_probe,
+	.remove = s6e8aa0a_remove,
+	.driver = {
+		.name = "panel-samsung-s3ve3g-s6e8aa0a",
+		.of_match_table = s6e8aa0a_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e8aa0a_driver);
+
+MODULE_DESCRIPTION("DRM driver for the Samsung Galaxy S III Neo's S6E8AA0A video mode DSI panel");
+MODULE_LICENSE("GPL");

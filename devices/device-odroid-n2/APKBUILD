# Reference: <https://postmarketos.org/devicepkg>
# nura-builds: the plain ODROID N2 (S922X, 2019), from pmaports' device/testing/device-odroid-n2plus
# 6-r0 (pmaports 286d3b4ecc): the N2's dtb (meson-g12b-odroid-n2), U-Boot with the N2's boot
# firmware (u-boot-odroid-n2), and a kernel choice: linux-postmarketos-amlogic or its PREEMPT_RT
# build linux-postmarketos-amlogic-rt (nura-builds aports/kernel). Swap on the device with
#   apk add device-odroid-n2-kernel-amlogic-rt '!device-odroid-n2-kernel-amlogic'
# Based on the N2+ package by hexaheximal <hexaheximal@proton.me>
pkgname=device-odroid-n2
pkgdesc="ODROID N2"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-firmware-meson
	postmarketos-base
	soc-amlogic-aarch64
	u-boot-odroid-n2
	"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-kernel-amlogic:kernel_amlogic
	$pkgname-kernel-amlogic-rt:kernel_amlogic_rt
	"
source="deviceinfo kernel-cmdline.conf modules-initfs"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

kernel_amlogic() {
	pkgdesc="postmarketOS' mainline kernel for Amlogic devices (PREEMPT)"
	depends="linux-postmarketos-amlogic"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_amlogic_rt() {
	pkgdesc="The mainline Amlogic kernel with PREEMPT_RT (linux-postmarketos-amlogic-rt), for low audio latency"
	depends="linux-postmarketos-amlogic-rt"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}


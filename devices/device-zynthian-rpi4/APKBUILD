# Reference: <https://postmarketos.org/devicepkg>
# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# zynthian on a Raspberry Pi 4 (the V4 kit first; one device for all Pi 4 kits): pmaports'
# raspberry-pi4 (Alpine's linux-rpi, the Raspberry Pi firmware) with ZynthianOS' common boot
# settings in usercfg.txt (I2C, I2S, SPI, i2s-mmap, MIDI on the UART instead of the serial
# console, Bluetooth on the mini UART, USB gadget), the kit's overlays (sound card, display) in
# /boot/zynthian-kit.txt, which the kit setup writes, and GPIO/I2C/SPI access for the session user
# (groups gpio, i2c, spi). Plan: docs/zynthian-rpi.md.
pkgname=device-zynthian-rpi4
pkgdesc="zynthian (Raspberry Pi 4)"
pkgver=1
pkgrel=0
url="https://github.com/hjanetzek/nura-builds/blob/main/docs/zynthian-rpi.md"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-firmware-brcm
	linux-rpi
	postmarketos-base
	raspberrypi-bootloader
	"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	usercfg.txt
	zynthian-kit.txt
	90-zynthian-hw.rules
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/usercfg.txt "$pkgdir"/boot/usercfg.txt
	install -Dm644 "$srcdir"/zynthian-kit.txt "$pkgdir"/usr/share/$pkgname/zynthian-kit.txt
	install -Dm644 "$srcdir"/90-zynthian-hw.rules "$pkgdir"/usr/lib/udev/rules.d/90-zynthian-hw.rules
}
sha512sums="

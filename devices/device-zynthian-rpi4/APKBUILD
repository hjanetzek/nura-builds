# Reference: <https://postmarketos.org/devicepkg>
# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# zynthian on a Raspberry Pi 4 (the V4 kit first; one device for all Pi 4 kits): pmaports'
# raspberry-pi4 (Alpine's linux-rpi, the Raspberry Pi firmware) with ZynthianOS' common boot
# settings in usercfg.txt (I2C, I2S, SPI, i2s-mmap, MIDI on the UART instead of the serial
# console, Bluetooth on the mini UART, USB gadget), the kit's overlays (sound card, display) in
# /boot/zynthian-kit.txt, which the kit setup writes, and GPIO/I2C/SPI access for the session user
# (groups gpio, i2c, spi). zynscreen-drm.dtbo: the V4 kit's SPI panel through the DRM driver
# ili9486 (fbtft's piscreen2r gives only a framebuffer). Plan: docs/zynthian-rpi.md.
pkgname=device-zynthian-rpi4
pkgdesc="zynthian (Raspberry Pi 4)"
pkgver=1
pkgrel=17
url="https://github.com/hjanetzek/nura-builds/blob/main/docs/zynthian-rpi.md"
license="MIT AND GPL-3.0-or-later"
arch="aarch64"
options="!check !archcheck"
# postmarketos-bootsplash: postmarketOS' boot splash (Plymouth in the initramfs) with ZynthianOS'
# theme zynloganim (zynthian-sys plymouth/), so the kits boot as zynthian users know it. The kit
# panel's modules are in the initramfs (90-device-zynthian-rpi4.modules) so its framebuffer appears
# before the splash starts (r8-r11 had no splash: the fbtft panel registered only from the root
# filesystem, and the initramfs waited 10 s for /dev/fb0); an initramfs hook switches the
# backlight on.
depends="
	linux-firmware-brcm
	postmarketos-base
	postmarketos-bootsplash
	raspberrypi-bootloader
	"
makedepends="devicepkg-dev dtc"
# The kernel (pmbootstrap init asks): Alpine's linux-rpi, or linux-rpi-rt (nura-builds
# aports/kernel: the same with PREEMPT_RT). Swap on the device with
#   apk add device-zynthian-rpi4-kernel-rpi-rt '!device-zynthian-rpi4-kernel-rpi'
subpackages="
	$pkgname-kernel-rpi:kernel_rpi
	$pkgname-kernel-rpi-rt:kernel_rpi_rt
	"
install="$pkgname.post-install $pkgname.post-upgrade"
# zynthian-sys (the boot animation zynloganim), at the commit zynthian-ui's zynthian-data uses
_sys_commit=c2eea576e528e451270b829aa114f504bd34ee90
source="
	zynthian-sys-$_sys_commit.tar.gz::https://github.com/zynthian/zynthian-sys/archive/$_sys_commit.tar.gz
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	usercfg.txt
	zynthian-kit.txt
	zynthian.txt
	91-zynscreen-touch.rules
	92-zynthian-backlight.rules
	90-zynthian-backlight.sh
	50-zynthian-no-quit.conf
	zynthian-plymouth-quit
	zynthian-plymouth-quit.service
	piscreen2r-notouch.dts
	piscreen2r-backlight.dts
	goodix_z2.dts
	90-zynthian-hw.rules
	zynscreen-drm-overlay.dts
	50-zynthian-rpi4-drm.sh
	zynthian-hw-modules.conf
	50-zynthian-rpi4.conf
	50-zynthian-journal.conf
	50-zynthian-realtime.conf
	"

build() {
	devicepkg_build $startdir $pkgname
	# The V4 kit's SPI panel as a DRM device (tiny DRM ili9486 instead of fbtft's piscreen2r)
	dtc -@ -I dts -O dtb -o zynscreen-drm.dtbo "$srcdir"/zynscreen-drm-overlay.dts
	# ZynthianOS' own overlays (zynthian-sys custom/display/*/boot/overlays, GPL-3.0, at 4913037),
	# which the kits' configurations name (V4, V2: piscreen2r-notouch; the Z2's display: goodix_z2):
	# they aren't in the kernel's overlays (sainsmart18 is: linux-rpi's own, not ours). Without them the V4's panel didn't appear at all.
	local o
	for o in piscreen2r-notouch piscreen2r-backlight goodix_z2; do
		dtc -@ -I dts -O dtb -o $o.dtbo "$srcdir"/$o.dts
	done
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/usercfg.txt "$pkgdir"/boot/usercfg.txt
	install -Dm644 "$srcdir"/zynthian-kit.txt "$pkgdir"/usr/share/$pkgname/zynthian-kit.txt
	# The kit choice on the FAT partition (zynthian-hw's zynthian-kit-boot reads it): the
	# post-install script copies it to /boot once, the user edits it there
	install -Dm644 "$srcdir"/zynthian.txt "$pkgdir"/usr/share/$pkgname/zynthian.txt
	# The ZynScreen's ADS7846 touch is flipped on both axes (ZynthianOS has a calibration matrix
	# in X): the same for libinput
	install -Dm644 "$srcdir"/91-zynscreen-touch.rules -t "$pkgdir"/usr/lib/udev/rules.d/
	# The panel's backlight on at boot (it came up powered down with fbtft), switchable by video
	install -Dm644 "$srcdir"/92-zynthian-backlight.rules -t "$pkgdir"/usr/lib/udev/rules.d/
	# The boot splash: ZynthianOS' Plymouth theme (selected by the post-install script: plymouth owns
	# plymouthd.conf), the kit panel's modules in the initramfs, the backlight on in the initramfs
	install -Dm644 "$srcdir"/zynthian-sys-$_sys_commit/plymouth/zynloganim/* \
		-t "$pkgdir"/usr/share/plymouth/themes/zynloganim/
	printf "%s\n" spi_bcm2835 backlight gpio_backlight fbtft fb_ili9486 |
		install -Dm644 /dev/stdin "$pkgdir"/usr/share/mkinitfs/modules/90-$pkgname.modules
	install -Dm755 "$srcdir"/90-zynthian-backlight.sh -t "$pkgdir"/usr/share/mkinitfs/hooks/
	# The animation until zynthian's first frame (its Qt UI writes a marker): no Plymouth quit at
	# the boot target (tinydm is ordered after plymouth-quit-wait), zynthian-plymouth-quit ends it
	local u
	for u in plymouth-quit plymouth-quit-wait; do
		install -Dm644 "$srcdir"/50-zynthian-no-quit.conf -t "$pkgdir"/usr/lib/systemd/system/$u.service.d/
	done
	install -Dm755 "$srcdir"/zynthian-plymouth-quit -t "$pkgdir"/usr/libexec/
	# No firewall on the kits, as on ZynthianOS: they sit in a home or studio network, and
	# zynthian's services are meant to be reachable there (OSC on UDP 1370, RTP-MIDI, QmidiNet,
	# Ableton Link, mDNS, webconf); postmarketOS' nftables (policy drop) blocked all but SSH and
	# webconf. Masked (it is a dependency of the UI packages, postmarketos-base-nftables)
	mkdir -p "$pkgdir"/etc/systemd/system
	ln -s /dev/null "$pkgdir"/etc/systemd/system/nftables.service
	install -Dm644 "$srcdir"/zynthian-plymouth-quit.service -t "$pkgdir"/usr/lib/systemd/system/
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../zynthian-plymouth-quit.service "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/
	install -Dm644 "$srcdir"/90-zynthian-hw.rules "$pkgdir"/usr/lib/udev/rules.d/90-zynthian-hw.rules
	install -Dm644 zynscreen-drm.dtbo "$pkgdir"/boot/overlays/zynscreen-drm.dtbo
	local o
	for o in piscreen2r-notouch piscreen2r-backlight goodix_z2; do
		install -Dm644 $o.dtbo "$pkgdir"/boot/overlays/$o.dtbo
	done
	install -Dm644 "$srcdir"/zynthian-hw-modules.conf "$pkgdir"/usr/lib/modules-load.d/zynthian-hw.conf
	install -Dm644 "$srcdir"/50-zynthian-rpi4-drm.sh \
		"$pkgdir"/usr/share/tinydm/env-wayland.d/50-zynthian-rpi4-drm.sh
	install -Dm644 "$srcdir"/50-zynthian-rpi4.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/50-zynthian-rpi4.conf
	install -Dm644 "$srcdir"/50-zynthian-journal.conf -t "$pkgdir"/usr/lib/systemd/journald.conf.d/
	install -Dm644 "$srcdir"/50-zynthian-realtime.conf \
		"$pkgdir"/usr/lib/systemd/system/user@.service.d/50-zynthian-realtime.conf
}
kernel_rpi() {
	pkgdesc="Alpine's Raspberry Pi kernel (PREEMPT)"
	depends="linux-rpi"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_rpi_rt() {
	pkgdesc="The Raspberry Pi kernel with PREEMPT_RT (linux-rpi-rt), for low audio latency"
	depends="linux-rpi-rt"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}


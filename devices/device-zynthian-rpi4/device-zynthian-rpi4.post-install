#!/bin/sh
# Groups for the kits' interfaces (90-zynthian-hw.rules)
for g in gpio i2c spi; do
	getent group $g >/dev/null || addgroup -S $g
done
# The kit's overlays: written by the kit setup, so not a file of this package
[ -e /boot/zynthian-kit.txt ] || cp /usr/share/device-zynthian-rpi4/zynthian-kit.txt /boot/zynthian-kit.txt
# The kit choice for zynthian-kit-boot (zynthian-hw), edited by the user on the FAT partition
[ -e /boot/zynthian.txt ] || cp /usr/share/device-zynthian-rpi4/zynthian.txt /boot/zynthian.txt
# The boot splash's theme: ZynthianOS' zynloganim (in /etc/plymouth/plymouthd.conf, which the plymouth
# package owns: set here instead of shipped); the mkinitfs trigger then puts it into the initramfs
conf=/etc/plymouth/plymouthd.conf
mkdir -p /etc/plymouth
# DeviceTimeout 0.1 s: plymouth waits that long for a DRM display before it takes a framebuffer;
# vc4's HDMI has no display connected on the kits, and with the default (5 s, pmOS) the splash fell
# back to the SPI panel only after plymouth had been told to quit (0 itself makes plymouthd abort)
grep -q '^\[Daemon\]' "$conf" 2>/dev/null || printf '[Daemon]\n' >> "$conf"
sed -i '/^Theme=/d; /^DeviceTimeout=/d; /^\[Daemon\]/a Theme=zynloganim\nDeviceTimeout=0.1' "$conf"
# The first boot grows the root partition to the whole SD card: postmarketOS' initramfs does that only
# with pmos.force-partition-resize on the kernel command line, and then at every boot (resize2fs
# "Nothing to do!", ~1 s on a Pi 4). Only on a fresh install (the image build): zynthian-kit-boot
# (zynthian-hw) removes the file on the first boot, before its mkinitfs writes cmdline.txt again
mkdir -p /etc/kernel-cmdline.d
[ -e /var/lib/zynthian-kit/applied ] ||
	printf '%s\n' "# zynthian: the first boot grows the root partition; removed by zynthian-kit-boot" \
		pmos.force-partition-resize > /etc/kernel-cmdline.d/10-zynthian-first-boot.conf
exit 0

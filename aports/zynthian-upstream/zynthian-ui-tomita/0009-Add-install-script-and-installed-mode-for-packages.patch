From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Mon, 2 Nov 2026 21:59:05 +0100
Subject: [PATCH] Add install script and installed mode for packages

desktop/install.sh installs one component (ui, zyncoder, sys, data, help)
into a destdir: code and data in $PREFIX/share/zynthian, native libraries
in $PREFIX/lib/zynthian, and a /usr/bin/zynthian wrapper that sets
ZYNTHIAN_DIR and ZYNTHIAN_LIB_DIR. Only the config templates of zynthian-sys
are needed.

With ZYNTHIAN_LIB_DIR set, the launcher doesn't build anything and uses the
system Python unless a venv exists; it still creates the user's directories
on first start. Tested with the installed tree read-only and empty user
directories: no writes outside the user's directories.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d28ae6a9c515dbc35dc77232816be436fd88bb92)
---
 desktop/install.sh          | 106 ++++++++++++++++++++++++++++++++++++
 desktop/setup_desktop.sh    |  11 ++--
 desktop/zynthian_desktop.sh |  28 +++++++---
 3 files changed, 131 insertions(+), 14 deletions(-)
 create mode 100755 desktop/install.sh

diff --git a/desktop/install.sh b/desktop/install.sh
new file mode 100755
index 00000000..ff300455
--- /dev/null
+++ b/desktop/install.sh
@@ -0,0 +1,106 @@
+#!/bin/bash
+#******************************************************************************
+# ZYNTHIAN PROJECT: install zynthian for desktop Linux / Nura packages
+#
+#   desktop/install.sh <component> <destdir> [<source dir>]
+#
+# Components (each one becomes a package):
+#   ui        zynthian-ui code and assets, zynlibs, launcher. Build the zynlibs first
+#             (zynlibs/build.sh).
+#   zyncoder  libzyncore.so and its Python module. <source dir>: the built zyncoder
+#             checkout (default: ../zyncoder).
+#   sys       configuration templates from zynthian-sys (default: ../zynthian-sys)
+#   data      zynthian-data (default: ../zynthian-data)
+#   help      zynthian-help (default: ../zynthian-help)
+#
+# Layout (PREFIX defaults to /usr):
+#   $PREFIX/share/zynthian/{zynthian-ui,zynthian-sys,zynthian-data,zynthian-help}
+#   $PREFIX/lib/zynthian/*.so
+#   $PREFIX/bin/zynthian
+#******************************************************************************
+
+set -e
+
+component="$1"
+destdir="$2"
+if [ -z "$component" ] || [ -z "$destdir" ]; then
+	sed -n '4,20p' "$0" | sed 's/^# \{0,1\}//'
+	exit 1
+fi
+
+ui_src="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+PREFIX="${PREFIX:-/usr}"
+share_dir="$destdir$PREFIX/share/zynthian"
+lib_dir="$destdir$PREFIX/lib/zynthian"
+ui_dst="$share_dir/zynthian-ui"
+
+# Copy a directory tree, leaving out git, build and cache files
+copy_tree() {
+	local src="$1" dst="$2"
+	mkdir -p "$dst"
+	(cd "$src" && find . \( -name .git -o -name build -o -name __pycache__ \) -prune -o \
+		\( -type f -o -type l \) -print0 | tar --null -T - -cf -) | tar -C "$dst" -xf -
+}
+
+install_ui() {
+	mkdir -p "$ui_dst" "$lib_dir" "$destdir$PREFIX/bin"
+	for d in zyngui zyngine zynconf zynautoconnect fonts icons img; do
+		copy_tree "$ui_src/$d" "$ui_dst/$d"
+	done
+	# Python modules of the zynlibs, without tests
+	(cd "$ui_src" && find zynlibs -name '*.py' ! -name 'unit_tests.py' ! -name 'test.py' ! -name 'format_docs.py' -print0 |
+		tar --null -T - -cf -) | tar -C "$ui_dst" -xf -
+	install -m 755 "$ui_src/zynthian_main.py" "$ui_dst/"
+	install -m 644 "$ui_src/LICENSE.txt" "$ui_dst/"
+	mkdir -p "$ui_dst/desktop"
+	install -m 755 "$ui_src/desktop/zynthian_desktop.sh" "$ui_src/desktop/setup_desktop.sh" "$ui_dst/desktop/"
+	install -m 644 "$ui_src/desktop/zynthian_desktop_env.sh" "$ui_src/desktop/zynthian_envars_desktop.sh" "$ui_dst/desktop/"
+	# Help is a separate package, linked like in the git checkout
+	ln -sfn ../zynthian-help "$ui_dst/help"
+
+	for lib in zynsmf/build/libzynsmf.so zynseq/build/libzynseq.so zynaudioplayer/build/libzynaudioplayer.so \
+		zynmixer/build/libzynmixer.so zynmixer/build/libzynmixer_mixbus.so zynclippy/build/libzynclippy.so; do
+		install -m 755 "$ui_src/zynlibs/$lib" "$lib_dir/"
+	done
+
+	cat > "$destdir$PREFIX/bin/zynthian" <<-EOF
+	#!/bin/sh
+	export ZYNTHIAN_DIR="\${ZYNTHIAN_DIR:-$PREFIX/share/zynthian}"
+	export ZYNTHIAN_LIB_DIR="\${ZYNTHIAN_LIB_DIR:-$PREFIX/lib/zynthian}"
+	exec "\$ZYNTHIAN_DIR/zynthian-ui/desktop/zynthian_desktop.sh" "\$@"
+	EOF
+	chmod 755 "$destdir$PREFIX/bin/zynthian"
+
+	# Byte-compile: the installed tree is read-only at run time
+	python3 -m compileall -q -d "$PREFIX/share/zynthian/zynthian-ui" "$ui_dst" >/dev/null || true
+}
+
+install_zyncoder() {
+	local src="${1:-$ui_src/../zyncoder}"
+	mkdir -p "$lib_dir" "$ui_dst/zyncoder"
+	install -m 755 "$src/build/libzyncore.so" "$lib_dir/"
+	install -m 644 "$src/__init__.py" "$src/zyncore.py" "$ui_dst/zyncoder/"
+	python3 -m compileall -q -d "$PREFIX/share/zynthian/zynthian-ui/zyncoder" "$ui_dst/zyncoder" >/dev/null || true
+}
+
+install_sys() {
+	local src="${1:-$ui_src/../zynthian-sys}"
+	copy_tree "$src/config" "$share_dir/zynthian-sys/config"
+}
+
+install_data() {
+	copy_tree "${1:-$ui_src/../zynthian-data}" "$share_dir/zynthian-data"
+}
+
+install_help() {
+	copy_tree "${1:-$ui_src/../zynthian-help}" "$share_dir/zynthian-help"
+}
+
+case "$component" in
+	ui) install_ui ;;
+	zyncoder) install_zyncoder "$3" ;;
+	sys) install_sys "$3" ;;
+	data) install_data "$3" ;;
+	help) install_help "$3" ;;
+	*) echo "Unknown component: $component"; exit 1 ;;
+esac
diff --git a/desktop/setup_desktop.sh b/desktop/setup_desktop.sh
index 94eda1fd..1d028834 100755
--- a/desktop/setup_desktop.sh
+++ b/desktop/setup_desktop.sh
@@ -52,9 +52,10 @@ PY_PACKAGES=(
 	pyusb
 )
 
+# check_dirs <dir>... => fail if one is missing
 check_dirs() {
 	local missing=0
-	for d in "$ZYNTHIAN_SYS_DIR" "$ZYNTHIAN_DATA_DIR" "$ZYNTHIAN_ZYNCODER_DIR"; do
+	for d in "$@"; do
 		if [ ! -d "$d" ]; then
 			echo "Missing: $d (clone it next to zynthian-ui, see desktop/README.md)"
 			missing=1
@@ -139,13 +140,11 @@ do_dirs() {
 	mkdir -p "$ZYNTHIAN_LV2_DIR" "$ZYNTHIAN_SW_DIR"
 }
 
-check_dirs
-
 case "${1:-all}" in
-	build) do_build ;;
+	build) check_dirs "$ZYNTHIAN_ZYNCODER_DIR"; do_build ;;
 	venv) do_venv ;;
-	dirs) do_dirs ;;
-	all) do_build; do_venv; do_dirs ;;
+	dirs) check_dirs "$ZYNTHIAN_SYS_DIR" "$ZYNTHIAN_DATA_DIR"; do_dirs ;;
+	all) check_dirs "$ZYNTHIAN_SYS_DIR" "$ZYNTHIAN_DATA_DIR" "$ZYNTHIAN_ZYNCODER_DIR"; do_build; do_venv; do_dirs ;;
 	*) echo "Usage: $0 [all|build|venv|dirs]"; exit 1 ;;
 esac
 
diff --git a/desktop/zynthian_desktop.sh b/desktop/zynthian_desktop.sh
index 957b803d..993d9de3 100755
--- a/desktop/zynthian_desktop.sh
+++ b/desktop/zynthian_desktop.sh
@@ -13,12 +13,21 @@
 
 source "$(dirname "${BASH_SOURCE[0]}")/zynthian_desktop_env.sh"
 
-if [ ! -f "$ZYNTHIAN_CONFIG_DIR/zynthian_envars.sh" ] || [ ! -x "$ZYNTHIAN_VENV_DIR/bin/python3" ]; then
-	echo "zynthian is not set up yet, running setup_desktop.sh ..."
-	"$ZYNTHIAN_UI_DIR/desktop/setup_desktop.sh" || exit 1
-fi
-if [ ! -f "$ZYNTHIAN_ZYNCODER_DIR/build/libzyncore.so" ]; then
-	"$ZYNTHIAN_UI_DIR/desktop/setup_desktop.sh" build || exit 1
+if [ -n "$ZYNTHIAN_LIB_DIR" ]; then
+	# Installed (package): libraries and Python packages come with it, only the
+	# user's directories need to be created
+	if [ ! -f "$ZYNTHIAN_CONFIG_DIR/zynthian_envars.sh" ]; then
+		"$ZYNTHIAN_UI_DIR/desktop/setup_desktop.sh" dirs || exit 1
+	fi
+else
+	# Source checkout
+	if [ ! -f "$ZYNTHIAN_CONFIG_DIR/zynthian_envars.sh" ] || [ ! -x "$ZYNTHIAN_VENV_DIR/bin/python3" ]; then
+		echo "zynthian is not set up yet, running setup_desktop.sh ..."
+		"$ZYNTHIAN_UI_DIR/desktop/setup_desktop.sh" || exit 1
+	fi
+	if [ ! -f "$ZYNTHIAN_ZYNCODER_DIR/build/libzyncore.so" ]; then
+		"$ZYNTHIAN_UI_DIR/desktop/setup_desktop.sh" build || exit 1
+	fi
 fi
 
 load_config_env() {
@@ -48,11 +57,14 @@ fi
 
 # zyncoder is imported as a package from the UI directory
 if [ ! -e "$ZYNTHIAN_UI_DIR/zyncoder" ]; then
-	echo "Missing $ZYNTHIAN_UI_DIR/zyncoder (symlink to $ZYNTHIAN_ZYNCODER_DIR)"
+	echo "Missing $ZYNTHIAN_UI_DIR/zyncoder (symlink to $ZYNTHIAN_ZYNCODER_DIR, or the zyncoder package)"
 	exit 1
 fi
 
-source "$ZYNTHIAN_VENV_DIR/bin/activate"
+# The venv, if there is one (source checkout); a package uses the system Python
+if [ -f "$ZYNTHIAN_VENV_DIR/bin/activate" ]; then
+	source "$ZYNTHIAN_VENV_DIR/bin/activate"
+fi
 
 # LV2 plugin cache, generated on first boot on ZynthianOS. Regenerate it after
 # installing plugins with: (cd zyngine && python3 zynthian_lv2.py)

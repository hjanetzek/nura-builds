From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Tue, 3 Nov 2026 00:11:45 +0100
Subject: [PATCH] UI scale: ZYNTHIAN_UI_SCALE factor or "auto" for the font
 size; kiosk uses auto

Tk sizes fonts in points from the DPI the display reports. XWayland reports
96 dpi whatever the panel, so the font size made for 1024x600 was tiny on the
Lenovo Duet's 1920x1200 panel. ZYNTHIAN_UI_SCALE multiplies the configured
font size; "auto" scales it with the screen height relative to 600 px
(16 => 32 on the Duet, which looked right there). The kiosk session sets
auto; override in zynthian_custom_config.sh. Unset: no change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 zyngui/zynthian_gui_config.py | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/zyngui/zynthian_gui_config.py b/zyngui/zynthian_gui_config.py
index 764b9b61..80e2b30c 100644
--- a/zyngui/zynthian_gui_config.py
+++ b/zyngui/zynthian_gui_config.py
@@ -863,6 +863,22 @@ if "zynthian_main.py" in sys.argv[0]:
         if not font_size:
             font_size = int(display_width / 40)
 
+        # UI scale (desktop/kiosk): a factor for the font size, or "auto" to scale it with the
+        # screen height, relative to 600 px (the 1024x600 layout the font sizes are made for).
+        # Tk sizes fonts in points from the DPI the display reports; XWayland reports 96 dpi
+        # whatever the panel, so on a high-DPI screen the fonts come out small.
+        ui_scale = os.environ.get('ZYNTHIAN_UI_SCALE', "").strip()
+        if ui_scale == "auto":
+            ui_scale = display_height / 600
+        else:
+            try:
+                ui_scale = float(ui_scale)
+            except ValueError:
+                ui_scale = 1.0
+        if ui_scale > 0 and ui_scale != 1.0:
+            font_size = max(1, round(font_size * ui_scale))
+            logging.info(f"UI scale {ui_scale:.2f} => font size {font_size}")
+
         # Topbar variables
         if screen_width >= 800:
             topbar_height = screen_height // 12

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Mon, 2 Nov 2026 21:35:37 +0100
Subject: [PATCH] Add desktop mode (ZYNTHIAN_DESKTOP=1)

When zynthian runs as an application on a desktop or Nura system it doesn't
own the system. In desktop mode it doesn't start or stop system services
(Bluetooth, VNC, network MIDI, aubionotes, headphones), call
powersave_control.sh, poll the Wi-Fi status or check for software updates,
and the admin menu hides Wi-Fi, VNC, Bluetooth, RBPi headphones and
touchscreen calibration. is_service_active() reports the host's services as
inactive.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 1a554d6ccfd31b03b66eb52c7c4307763445df19)
---
 zynconf/zynthian_config.py        |  8 +++++++
 zyngine/zynthian_state_manager.py | 38 ++++++++++++++++++++++++++++---
 zyngui/zynthian_gui_admin.py      | 37 ++++++++++++++++--------------
 3 files changed, 63 insertions(+), 20 deletions(-)

diff --git a/zynconf/zynthian_config.py b/zynconf/zynthian_config.py
index 7001d94a..4640b3df 100755
--- a/zynconf/zynthian_config.py
+++ b/zynconf/zynthian_config.py
@@ -172,6 +172,11 @@ config_dir = zynthian_paths.config_dir
 my_data_dir = zynthian_paths.my_data_dir
 config_fpath = config_dir + "/zynthian_envars.sh"
 
+# Running as an application on a desktop (or Nura) system instead of ZynthianOS:
+# zynthian doesn't own the system there, so it must not start or stop system
+# services, change power, display or network settings, or update the system.
+desktop_mode = os.environ.get("ZYNTHIAN_DESKTOP", "0") == "1"
+
 # -------------------------------------------------------------------------------
 # Config management
 # -------------------------------------------------------------------------------
@@ -541,6 +546,9 @@ def is_process_running(procname):
 
 
 def is_service_active(service):
+    if desktop_mode:
+        # The system's services are not zynthian's
+        return False
     cmd = "systemctl is-active %s" % service
     try:
         result = check_output(cmd, shell=True).decode('utf-8', 'ignore')

# zynthian-ui from upstream (tomita, zynthian's development branch) for postmarketOS/Nura: the Tk UI,
# unmodified except for the port patches below, for those who want zynthian as upstream ships it
# on the devices Nura supports. The Qt UI port is the package zynthian-ui (hjanetzek/zynthian-ui,
# nura branch).
#
# The patches are the port's essentials from the nura branch (git format-patch; regenerate them
# by cherry-picking onto a newer upstream commit, see docs/zynthian-upstream.md): desktop mode
# (no Raspberry Pi hardware), directories from the environment instead of /zynthian, native
# libraries from ZYNTHIAN_LIB_DIR, the install script and launcher (desktop/), PipeWire (port
# aliases, the main output), and a few fixes needed to run (see each patch).
#
# Installs where zynthian-ui does and provides it, so the kiosk package (postmarketos-ui-zynthian)
# works with it (it falls back to the Tk UI); excludes the other zynthian-ui packages.
pkgname=zynthian-ui-tomita
_commit=322e9079ac44ed31a1473ba765d5f7c80a9bdf5f
pkgver=0_git20261107
pkgrel=1
pkgdesc="zynthian synthesizer platform: user interface and engine manager (upstream tomita, Tk UI)"
url="https://github.com/zynthian/zynthian-ui"
arch="aarch64 x86_64"
license="GPL-3.0-or-later"
options="!check"
# Versioned: apk then allows only one package providing zynthian-ui (and prefers the real zynthian-ui
# when it resolves the name, e.g. for the kiosk package)
provides="zynthian-ui=$pkgver-r$pkgrel"

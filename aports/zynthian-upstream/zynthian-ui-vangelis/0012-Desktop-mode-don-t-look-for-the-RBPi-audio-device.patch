From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Mon, 2 Nov 2026 22:31:10 +0100
Subject: [PATCH] Desktop mode: don't look for the RBPi audio device

get_rbpi_audio_device.sh is part of zynthian-sys's system scripts, which a
desktop or package install doesn't have.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3a71674a791415669ea9377504ab74b2cd2f407b)
---
 zyngine/zynthian_engine_alsa_mixer.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/zyngine/zynthian_engine_alsa_mixer.py b/zyngine/zynthian_engine_alsa_mixer.py
index 829b02fe..45227664 100644
--- a/zyngine/zynthian_engine_alsa_mixer.py
+++ b/zyngine/zynthian_engine_alsa_mixer.py
@@ -31,6 +31,7 @@ import logging
 import alsaaudio
 from subprocess import check_output
 
+import zynconf
 from zyncoder.zyncore import lib_zyncore
 from zyngine.zynthian_engine import zynthian_engine
 from zyngine.zynthian_controller import zynthian_controller
@@ -604,6 +605,9 @@ class zynthian_engine_alsa_mixer(zynthian_engine):
         self.device = f"hw:{self.device_name}"
 
         try:
+            if zynconf.desktop_mode:
+                # Raspberry Pi onboard audio; the zynthian-sys script isn't installed
+                raise Exception("desktop mode")
             cmd = self.sys_dir + "/sbin/get_rbpi_audio_device.sh"
             self.rbpi_device_name = check_output(cmd, shell=True).decode("utf-8")
         except:

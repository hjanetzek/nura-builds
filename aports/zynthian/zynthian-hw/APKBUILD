4c4f925868e4bc2c687551952eff6c9ef463448f7554ea6494110c502c4638fdc0e3c8179120f91d63ac29f87f3cbe73a678c2bb51847aefed24f78df77b9320  zynthian-kit-boot
97e0c1a845d6a0b5eac1d3ed52b94c9b27c38381e179c86f6585eff45de0ef6a522c4ac3674afb9accba865122e67208d6e455dfd6aaa2c5318cab5c80eb5805  zynthian-kit-boot.service
f7e3144d4366d2f0805a69b61803e44d42176b34970af57961a7c1b031aa94584f8e0bafc3ba9fff76f13cc3633a20ba61a3030622ff861265b5e70f66662b5c  sudoers

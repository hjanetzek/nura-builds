# zynthian's configuration templates (zynthian-sys config/) with nura's engine defaults merged in,
# and zynseq's keymaps (zynthian-data zynseq/keymaps.json) with nura's engines' entries.
# A recipe of its own, not a zynthian-data subpackage as up to r4: a change of these then doesn't
# bump zynthian-data (330 MB on every device). Keep _sys_commit at the commit zynthian-data's
# comment names (the same zynthian-sys), _data_commit at zynthian-data's.
pkgname=zynthian-sys-config
pkgver=2610_git20261030
pkgrel=6
pkgdesc="zynthian configuration templates (from zynthian-sys)"
url="https://github.com/zynthian/zynthian-sys"
arch="noarch"
license="GPL-3.0-or-later"
makedepends="python3"
options="!check"
# keymaps.json: zynthian-data up to its r4 build of 2026-11-25 has it too (later builds leave it
# out); zynthian-ui reads it only there
replaces="zynthian-data"
_sys_commit=c2eea576e528e451270b829aa114f504bd34ee90
_data_commit=271e9188cc6bcbd5ff89ba27d1b312a8c68a3417
source="
	zynthian-sys-$_sys_commit.tar.gz::https://github.com/zynthian/zynthian-sys/archive/$_sys_commit.tar.gz
	nura-engine-config.json
	keymaps-$_data_commit.json::https://raw.githubusercontent.com/zynthian/zynthian-data/$_data_commit/zynseq/keymaps.json
	nura-keymaps.json
	"
builddir="$srcdir/zynthian-sys-$_sys_commit"

package() {
	mkdir -p "$pkgdir"/usr/share/zynthian/zynthian-sys
	cp -a config "$pkgdir"/usr/share/zynthian/zynthian-sys/config
	# nura's own engines' defaults (nura-engine-config.json: e.g. eDrumSynth enabled), added to
	# zynthian-sys' engine_config.json without changing its entries; zynthian merges them at its
	# engine rescan
	python3 - "$srcdir"/nura-engine-config.json \
		"$pkgdir"/usr/share/zynthian/zynthian-sys/config/engine_config.json <<-'PY'
	import json, sys
	add = json.load(open(sys.argv[1]))
	cfg = json.load(open(sys.argv[2]))
	for k, v in add.items():
	    cfg.setdefault(k, v)
	json.dump(cfg, open(sys.argv[2], "w"), indent=4)
	PY
	# zynseq's keymaps: upstream's, nura's entries added after them (the first key found in the
	# synth's preset path wins)
	mkdir -p "$pkgdir"/usr/share/zynthian/zynthian-data/zynseq
	python3 - "$srcdir"/keymaps-$_data_commit.json "$srcdir"/nura-keymaps.json \
		"$pkgdir"/usr/share/zynthian/zynthian-data/zynseq/keymaps.json <<-'PY'
	import json, sys
	maps = json.load(open(sys.argv[1]))
	for k, v in json.load(open(sys.argv[2])).items():
	    maps.setdefault(k, v)
	json.dump(maps, open(sys.argv[3], "w"), indent=1)
	PY
}


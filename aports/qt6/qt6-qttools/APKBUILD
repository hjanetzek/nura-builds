# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=qt6
maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=qt6-qttools
pkgver=6.12.0
pkgrel=0
# zrythm: local build of aports MR !107047, see ../README.md
pkgdesc="A cross-platform application and UI framework (Development Tools, QtHelp)"
url="https://qt.io/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
depends_dev="$pkgname=$pkgver-r$pkgrel
	vulkan-headers
	"
# zrythm: without clang/llvm (no qdoc, no clang-based lupdate C++ parser);
# without $depends_dev, which names this package itself: abuild leaves it
# out, but pmbootstrap would try to install it before it is built
makedepends="
	cmake
	perl
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	samurai
	vulkan-headers
	"
case "$CARCH" in
	armhf) ;;
	*)
		depends_dev="$depends_dev qt6-qtdeclarative-dev"
		makedepends="$makedepends
			qt6-qtdeclarative-dev
			qt6-qtdeclarative-private-dev
			"
		;;
esac
subpackages="$pkgname-dev $pkgname-libs"
builddir="$srcdir/qttools-everywhere-src-${pkgver/_/-}"

case $pkgver in
	*_alpha*|*_beta*|*_rc*) _rel=development_releases;;
	*) _rel=official_releases;;
esac

source="https://download.qt.io/$_rel/qt/${pkgver%.*}/${pkgver/_/-}/submodules/qttools-everywhere-src-${pkgver/_/-}.tar.xz"
options="!check" # Tests aren't found

build() {
	# zrythm: built without LTO and without debug info (Release, no -dbg
	# subpackage), to keep the build chroot small and the build fast under
	# pmbootstrap (LTO code generation would run under qemu).
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DINSTALL_PUBLICBINDIR=usr/bin \
		-DQT_FEATURE_qdoc=OFF \
		-DQT_FEATURE_clang=OFF \
		-DQT_FEATURE_clangcpp=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build

	mkdir -p "$pkgdir"/usr/bin
	local target name
	while read -r target name; do
		ln -sv "$target" "$pkgdir/$name"
	done < "$builddir"/build/user_facing_tool_links.txt
}

dev() {
	default_dev

	amove usr/lib/qt6/sbom
}

sha512sums="
0f29196c1fbec2156676df11ea095a295e71de750b4be01897b58d23701df29269e612475dee85a5770590c57cef934e83ded91c0222e6d42c06b702306b5646  qttools-everywhere-src-6.12.0.tar.xz
"

# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=qt6
maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=qt6-qtshadertools
pkgver=6.12.0
pkgrel=0
# zrythm: local build of aports MR !107047, see ../README.md
pkgdesc="Experimental module providing APIs and a host tool to host tool to perform graphics and compute shader conditioning"
url="https://qt.io/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
depends_dev="vulkan-headers"
makedepends="$depends_dev
	cmake
	perl
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	samurai
	"
subpackages="$pkgname-dev"
options="!check" # No tests
builddir="$srcdir/qtshadertools-everywhere-src-${pkgver/_/-}"

case $pkgver in
	*_alpha*|*_beta*|*_rc*) _rel=development_releases;;
	*) _rel=official_releases;;
esac

source="https://download.qt.io/$_rel/qt/${pkgver%.*}/${pkgver/_/-}/submodules/qtshadertools-everywhere-src-${pkgver/_/-}.tar.xz
	"

build() {
	# zrythm: built without LTO and without debug info (Release, no -dbg
	# subpackage), to keep the build chroot small and the build fast under
	# pmbootstrap (LTO code generation would run under qemu).
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

dev() {
	default_dev

	amove usr/lib/qt6/sbom
}

sha512sums="
2993c6e541ff6bdf370dc22a0873dded988ffc46b0e0c3b5607962d06e667283e8c30b88a1691dfa590971f0ae821e3e47a65f673efccee9286027adc7987856  qtshadertools-everywhere-src-6.12.0.tar.xz
"

# The power key switches the screen off and on (backlight bl_power, touchscreen inhibited), for
# phones and tablets running zynthian without a desktop (Lenovo Duet, Pixel 3; the Galaxy S III
# Neo's device package has its own s3ve3g-powerkey, which this one generalizes). logind (systemd)
# or elogind (OpenRC) ignores the key. Devices found by capability; overrides in
# /etc/default/nura-powerkey (POWERKEY_NAME, TOUCH_NAMES, BACKLIGHT).
pkgname=nura-powerkey
pkgver=1
pkgrel=2
pkgdesc="Power key switches the screen (backlight and touchscreen)"
url="https://github.com/hjanetzek/nura-builds"
arch="noarch"
license="MIT"
options="!check"
depends="busybox"
subpackages="$pkgname-systemd:_systemd $pkgname-openrc:_openrc"
install="$pkgname-openrc.post-install"
source="
	nura-powerkey.sh
	nura-powerkey.service
	nura-powerkey.initd
	50-nura-powerkey.conf
	80-nura-powerkey.preset
	"

package() {
	install -Dm755 "$srcdir"/nura-powerkey.sh "$pkgdir"/usr/libexec/nura-powerkey
}

_systemd() {
	pkgdesc="$pkgdesc (systemd service)"
	depends="$pkgname=$pkgver-r$pkgrel"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$srcdir"/nura-powerkey.service -t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/50-nura-powerkey.conf -t "$subpkgdir"/usr/lib/systemd/logind.conf.d/
	# enabled by postmarketOS' systemd preset trigger (an enable in post-install didn't take)
	install -Dm644 "$srcdir"/80-nura-powerkey.preset -t "$subpkgdir"/usr/lib/systemd/system-preset/
}

_openrc() {
	pkgdesc="$pkgdesc (OpenRC service)"
	depends="$pkgname=$pkgver-r$pkgrel"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install -Dm755 "$srcdir"/nura-powerkey.initd "$subpkgdir"/etc/init.d/nura-powerkey
	install -Dm644 "$srcdir"/50-nura-powerkey.conf -t "$subpkgdir"/etc/elogind/logind.conf.d/
}

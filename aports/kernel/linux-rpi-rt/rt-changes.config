# linux-rpi-rt: on top of Alpine's common-changes.config (same format)
# PREEMPT_RT (mainline since 6.12; needs EXPERT, which bcm2711_defconfig sets)
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
# 1000 Hz timer, as Patchbox OS' RT kernel (Blokas' rpi-rt featureset)
CONFIG_HZ_250=n
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Neural Amp Modeler LV2 (URI http://github.com/mikeoliphant/neural-amp-modeler-lv2; zynthian's
# recipe install_nam.sh): NAM and RTNeural models through NeuralAudio. The git submodules are extra
# sources (tools/gh-submodule-sources.py); Eigen comes from RTNeural's copy, so the two GitLab Eigen
# submodules of NeuralAmpModelerCore aren't needed. Models are separate (zynthian-data's
# files/Neural Models). CPU-heavy.
pkgname=neural-amp-modeler-lv2
pkgver=0.2.3
pkgrel=0
_commit=3d0e1c26a4cfb7085b185811dd564f7ec7ec4991
_deps_lv2=e9d94328743d630e27a9d322015437fd9080695d
_deps_neuralaudio=b1137e1db2d43670e7dcf6345ade7808613cac20
_deps_neuralaudio_deps_neuralampmodelercore=4c0ee78b71abd5eb20aec58562e7540f43caac3b
_deps_neuralaudio_deps_neuralampmodelercore_dependencies_audiodsptools=0827c6c2fc0deced568536142ea86f189e0b98a1
_deps_neuralaudio_deps_rtneural=5909c44909cd6100367f62cd04b348de85d57dbf
_deps_neuralaudio_deps_rtneural_modules_xsimd=a00c81f7b9e808a42aedcf7da2fbb1f9a636da34
_deps_neuralaudio_deps_math_approx=f6d55e70f0c5e888d3a0c4e252b02b530210c78a
_deps_neuralaudio_utils_deps_argparse=d924b84eba1f0f0adf38b20b7b4829f6f65b6570
pkgdesc="Neural Amp Modeler LV2 plugin"
url="https://github.com/mikeoliphant/neural-amp-modeler-lv2"
arch="aarch64 x86_64"
license="GPL-3.0-or-later"
# linux-headers: xsimd (in RTNeural, the commit BYOD failed with) includes <asm/hwcap.h>
makedepends="cmake linux-headers lv2-dev samurai"
source="$pkgname-$_commit.tar.gz::https://github.com/mikeoliphant/neural-amp-modeler-lv2/archive/$_commit.tar.gz
	deps_lv2-${_deps_lv2}.tar.gz::https://github.com/lv2/lv2/archive/${_deps_lv2}.tar.gz
	deps_neuralaudio-${_deps_neuralaudio}.tar.gz::https://github.com/mikeoliphant/NeuralAudio/archive/${_deps_neuralaudio}.tar.gz
	deps_neuralaudio_deps_neuralampmodelercore-${_deps_neuralaudio_deps_neuralampmodelercore}.tar.gz::https://github.com/mikeoliphant/NeuralAmpModelerCore/archive/${_deps_neuralaudio_deps_neuralampmodelercore}.tar.gz
	deps_neuralaudio_deps_neuralampmodelercore_dependencies_audiodsptools-${_deps_neuralaudio_deps_neuralampmodelercore_dependencies_audiodsptools}.tar.gz::https://github.com/sdatkinson/AudioDSPTools/archive/${_deps_neuralaudio_deps_neuralampmodelercore_dependencies_audiodsptools}.tar.gz
	deps_neuralaudio_deps_rtneural-${_deps_neuralaudio_deps_rtneural}.tar.gz::https://github.com/mikeoliphant/RTNeural/archive/${_deps_neuralaudio_deps_rtneural}.tar.gz
	deps_neuralaudio_deps_rtneural_modules_xsimd-${_deps_neuralaudio_deps_rtneural_modules_xsimd}.tar.gz::https://github.com/xtensor-stack/xsimd/archive/${_deps_neuralaudio_deps_rtneural_modules_xsimd}.tar.gz
	deps_neuralaudio_deps_math_approx-${_deps_neuralaudio_deps_math_approx}.tar.gz::https://github.com/Chowdhury-DSP/math_approx/archive/${_deps_neuralaudio_deps_math_approx}.tar.gz
	deps_neuralaudio_utils_deps_argparse-${_deps_neuralaudio_utils_deps_argparse}.tar.gz::https://github.com/p-ranav/argparse/archive/${_deps_neuralaudio_utils_deps_argparse}.tar.gz
	"
builddir="$srcdir/neural-amp-modeler-lv2-$_commit"
options="!check" # no tests

prepare() {
	# git submodules (outer ones first)
	rm -rf deps/lv2 && mv "$srcdir"/lv2-${_deps_lv2} deps/lv2
	rm -rf deps/NeuralAudio && mv "$srcdir"/NeuralAudio-${_deps_neuralaudio} deps/NeuralAudio
	rm -rf deps/NeuralAudio/deps/NeuralAmpModelerCore && mv "$srcdir"/NeuralAmpModelerCore-${_deps_neuralaudio_deps_neuralampmodelercore} deps/NeuralAudio/deps/NeuralAmpModelerCore
	rm -rf deps/NeuralAudio/deps/NeuralAmpModelerCore/Dependencies/AudioDSPTools && mv "$srcdir"/AudioDSPTools-${_deps_neuralaudio_deps_neuralampmodelercore_dependencies_audiodsptools} deps/NeuralAudio/deps/NeuralAmpModelerCore/Dependencies/AudioDSPTools
	rm -rf deps/NeuralAudio/deps/RTNeural && mv "$srcdir"/RTNeural-${_deps_neuralaudio_deps_rtneural} deps/NeuralAudio/deps/RTNeural
	rm -rf deps/NeuralAudio/deps/RTNeural/modules/xsimd && mv "$srcdir"/xsimd-${_deps_neuralaudio_deps_rtneural_modules_xsimd} deps/NeuralAudio/deps/RTNeural/modules/xsimd
	rm -rf deps/NeuralAudio/deps/math_approx && mv "$srcdir"/math_approx-${_deps_neuralaudio_deps_math_approx} deps/NeuralAudio/deps/math_approx
	rm -rf deps/NeuralAudio/Utils/deps/argparse && mv "$srcdir"/argparse-${_deps_neuralaudio_utils_deps_argparse} deps/NeuralAudio/Utils/deps/argparse
	default_prepare
}

build() {
	# CMake 4: some (sub)projects declare cmake_minimum_required < 3.5
	cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

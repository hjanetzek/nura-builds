	mesa-dev
	samurai
	"
source="$pkgname-$_commit.tar.gz::https://github.com/dsp56300/gearmulator/archive/$_commit.tar.gz
	source_cpu_dsp56300-${_source_cpu_dsp56300}.tar.gz::https://github.com/dsp56300/dsp56300/archive/${_source_cpu_dsp56300}.tar.gz
	source_cpu_dsp56300_source_asmjit-${_source_cpu_dsp56300_source_asmjit}.tar.gz::https://github.com/dsp56300/asmjit/archive/${_source_cpu_dsp56300_source_asmjit}.tar.gz
	source_3rdparty_juce-${_source_3rdparty_juce}.tar.gz::https://github.com/dsp56300/JUCE/archive/${_source_3rdparty_juce}.tar.gz
	source_3rdparty_cpp_terminal-${_source_3rdparty_cpp_terminal}.tar.gz::https://github.com/dsp56300/cpp-terminal/archive/${_source_3rdparty_cpp_terminal}.tar.gz
	source_cpu_mc68k-${_source_cpu_mc68k}.tar.gz::https://github.com/dsp56300/mc68k/archive/${_source_cpu_mc68k}.tar.gz
	source_3rdparty_clap_juce_extensions-${_source_3rdparty_clap_juce_extensions}.tar.gz::https://github.com/dsp56300/clap-juce-extensions/archive/${_source_3rdparty_clap_juce_extensions}.tar.gz
	source_3rdparty_clap_juce_extensions_clap_libs_clap-${_source_3rdparty_clap_juce_extensions_clap_libs_clap}.tar.gz::https://github.com/free-audio/clap/archive/${_source_3rdparty_clap_juce_extensions_clap_libs_clap}.tar.gz
	source_3rdparty_clap_juce_extensions_clap_libs_clap_helpers-${_source_3rdparty_clap_juce_extensions_clap_libs_clap_helpers}.tar.gz::https://github.com/free-audio/clap-helpers/archive/${_source_3rdparty_clap_juce_extensions_clap_libs_clap_helpers}.tar.gz
	source_3rdparty_rmlui-${_source_3rdparty_rmlui}.tar.gz::https://github.com/dsp56300/RmlUi/archive/${_source_3rdparty_rmlui}.tar.gz
	source_3rdparty_freetype-${_source_3rdparty_freetype}.tar.gz::https://github.com/freetype/freetype/archive/${_source_3rdparty_freetype}.tar.gz
	source_3rdparty_freetype_subprojects_dlg-${_source_3rdparty_freetype_subprojects_dlg}.tar.gz::https://github.com/nyorain/dlg/archive/${_source_3rdparty_freetype_subprojects_dlg}.tar.gz
	source_3rdparty_portmidi_latest-${_source_3rdparty_portmidi_latest}.tar.gz::https://github.com/PortMidi/portmidi/archive/${_source_3rdparty_portmidi_latest}.tar.gz
	source_3rdparty_lunasvg-${_source_3rdparty_lunasvg}.tar.gz::https://github.com/sammycage/lunasvg/archive/${_source_3rdparty_lunasvg}.tar.gz
	source_3rdparty_lunasvg_plutovg-${_source_3rdparty_lunasvg_plutovg}.tar.gz::https://github.com/sammycage/plutovg/archive/${_source_3rdparty_lunasvg_plutovg}.tar.gz
	"
builddir="$srcdir/gearmulator-$_commit"
options="!check" # no tests

prepare() {
	# musl: no execinfo.h (JUCE uses backtrace() for crash reports only): a stub without backtraces
	mkdir -p "$srcdir"/musl-compat
	cat > "$srcdir"/musl-compat/execinfo.h <<-'EOF'
	#pragma once
	static inline int backtrace(void **buf, int size) { (void) buf; (void) size; return 0; }
	static inline char **backtrace_symbols(void *const *buf, int size) { (void) buf; (void) size; return 0; }
	static inline void backtrace_symbols_fd(void *const *buf, int size, int fd) { (void) buf; (void) size; (void) fd; }
	EOF
	# git submodules (outer ones first)
	rm -rf source/cpu/dsp56300 && mv "$srcdir"/dsp56300-${_source_cpu_dsp56300} source/cpu/dsp56300
	rm -rf source/cpu/dsp56300/source/asmjit && mv "$srcdir"/asmjit-${_source_cpu_dsp56300_source_asmjit} source/cpu/dsp56300/source/asmjit
	rm -rf source/3rdparty/JUCE && mv "$srcdir"/JUCE-${_source_3rdparty_juce} source/3rdparty/JUCE
	rm -rf source/3rdparty/cpp-terminal && mv "$srcdir"/cpp-terminal-${_source_3rdparty_cpp_terminal} source/3rdparty/cpp-terminal
	rm -rf source/cpu/mc68k && mv "$srcdir"/mc68k-${_source_cpu_mc68k} source/cpu/mc68k
	rm -rf source/3rdparty/clap-juce-extensions && mv "$srcdir"/clap-juce-extensions-${_source_3rdparty_clap_juce_extensions} source/3rdparty/clap-juce-extensions
	rm -rf source/3rdparty/clap-juce-extensions/clap-libs/clap && mv "$srcdir"/clap-${_source_3rdparty_clap_juce_extensions_clap_libs_clap} source/3rdparty/clap-juce-extensions/clap-libs/clap
	rm -rf source/3rdparty/clap-juce-extensions/clap-libs/clap-helpers && mv "$srcdir"/clap-helpers-${_source_3rdparty_clap_juce_extensions_clap_libs_clap_helpers} source/3rdparty/clap-juce-extensions/clap-libs/clap-helpers
	rm -rf source/3rdparty/RmlUi && mv "$srcdir"/RmlUi-${_source_3rdparty_rmlui} source/3rdparty/RmlUi
	rm -rf source/3rdparty/freetype && mv "$srcdir"/freetype-${_source_3rdparty_freetype} source/3rdparty/freetype
	rm -rf source/3rdparty/freetype/subprojects/dlg && mv "$srcdir"/dlg-${_source_3rdparty_freetype_subprojects_dlg} source/3rdparty/freetype/subprojects/dlg
	rm -rf source/3rdparty/portmidi-latest && mv "$srcdir"/portmidi-${_source_3rdparty_portmidi_latest} source/3rdparty/portmidi-latest
	rm -rf source/3rdparty/lunasvg && mv "$srcdir"/lunasvg-${_source_3rdparty_lunasvg} source/3rdparty/lunasvg
	rm -rf source/3rdparty/lunasvg/plutovg && mv "$srcdir"/plutovg-${_source_3rdparty_lunasvg_plutovg} source/3rdparty/lunasvg/plutovg
	default_prepare
}

build() {
	# musl: the execinfo.h stub; stat64 and friends only with _LARGEFILE64_SOURCE; glibc's
	# _NL_IDENTIFICATION_*/_NL_ADDRESS_* locale items as items musl doesn't have (nl_langinfo() returns "")
	export CXXFLAGS="$CXXFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE \
		-D_NL_IDENTIFICATION_LANGUAGE=0x60000 -D_NL_IDENTIFICATION_TERRITORY=0x60001 \
		-D_NL_ADDRESS_LANG_AB=0x60002 -D_NL_ADDRESS_COUNTRY_AB2=0x60003"
	export CFLAGS="$CFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE"
	# (mesa-dev: juce_opengl, GL/glx.h)
	# GCC 15: uint32_t without <cstdint> (juceRmlUi)
	export CXXFLAGS="$CXXFLAGS -include cstdint"
	cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-Dgearmulator_BUILD_JUCEPLUGIN_LV2=ON -Dgearmulator_BUILD_JUCEPLUGIN_VST2=OFF -Dgearmulator_BUILD_JUCEPLUGIN_VST3=OFF -Dgearmulator_BUILD_JUCEPLUGIN_CLAP=OFF -Dgearmulator_BUILD_JUCEPLUGIN_AU=OFF \
		-Dgearmulator_SYNTH_VAVRA=OFF -Dgearmulator_SYNTH_XENIA=OFF -Dgearmulator_SYNTH_NODALRED2X=OFF -Dgearmulator_SYNTH_JE8086=OFF -Dgearmulator_SYNTH_88EMU=OFF \
		-Dgearmulator_COMPONENT_DSPBRIDGE=OFF -Dgearmulator_BUILD_INSTALLER=OFF -DBUILD_TESTING=OFF
	# at most 3 jobs: the JUCE translation units need ~1 GB each
	cmake --build build --parallel 3 --target osirusJucePlugin_LV2 osTIrusJucePlugin_LV2
}

package() {
	local d
	mkdir -p "$pkgdir"/usr/lib/lv2
	# the bundles are written to bin/plugins/Release/LV2, outside the build directory
	for d in bin/plugins/Release/LV2/Osirus.lv2 bin/plugins/Release/LV2/OsTIrus.lv2; do
		[ -f "$d"/manifest.ttl ] || die "$d: no manifest.ttl"
		cp -r "$d" "$pkgdir"/usr/lib/lv2/
	done
}

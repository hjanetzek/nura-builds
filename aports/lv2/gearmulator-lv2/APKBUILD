builddir="$srcdir/gearmulator-$_commit"
options="!check" # no tests

prepare() {
	# musl: no execinfo.h (JUCE uses backtrace() for crash reports only): a stub without backtraces
	mkdir -p "$srcdir"/musl-compat
	cat > "$srcdir"/musl-compat/execinfo.h <<-'EOF'
	#pragma once
	static inline int backtrace(void **buf, int size) { (void) buf; (void) size; return 0; }
	static inline char **backtrace_symbols(void *const *buf, int size) { (void) buf; (void) size; return 0; }
	EOF
	# git submodules (outer ones first)
	rm -rf source/cpu/dsp56300 && mv "$srcdir"/dsp56300-${_source_cpu_dsp56300} source/cpu/dsp56300
	rm -rf source/cpu/dsp56300/source/asmjit && mv "$srcdir"/asmjit-${_source_cpu_dsp56300_source_asmjit} source/cpu/dsp56300/source/asmjit
	rm -rf source/3rdparty/JUCE && mv "$srcdir"/JUCE-${_source_3rdparty_juce} source/3rdparty/JUCE
	rm -rf source/3rdparty/cpp-terminal && mv "$srcdir"/cpp-terminal-${_source_3rdparty_cpp_terminal} source/3rdparty/cpp-terminal
	rm -rf source/cpu/mc68k && mv "$srcdir"/mc68k-${_source_cpu_mc68k} source/cpu/mc68k
	rm -rf source/3rdparty/clap-juce-extensions && mv "$srcdir"/clap-juce-extensions-${_source_3rdparty_clap_juce_extensions} source/3rdparty/clap-juce-extensions
	rm -rf source/3rdparty/clap-juce-extensions/clap-libs/clap && mv "$srcdir"/clap-${_source_3rdparty_clap_juce_extensions_clap_libs_clap} source/3rdparty/clap-juce-extensions/clap-libs/clap
	rm -rf source/3rdparty/clap-juce-extensions/clap-libs/clap-helpers && mv "$srcdir"/clap-helpers-${_source_3rdparty_clap_juce_extensions_clap_libs_clap_helpers} source/3rdparty/clap-juce-extensions/clap-libs/clap-helpers
	rm -rf source/3rdparty/RmlUi && mv "$srcdir"/RmlUi-${_source_3rdparty_rmlui} source/3rdparty/RmlUi
	rm -rf source/3rdparty/freetype && mv "$srcdir"/freetype-${_source_3rdparty_freetype} source/3rdparty/freetype
	rm -rf source/3rdparty/freetype/subprojects/dlg && mv "$srcdir"/dlg-${_source_3rdparty_freetype_subprojects_dlg} source/3rdparty/freetype/subprojects/dlg
	rm -rf source/3rdparty/portmidi-latest && mv "$srcdir"/portmidi-${_source_3rdparty_portmidi_latest} source/3rdparty/portmidi-latest
	rm -rf source/3rdparty/lunasvg && mv "$srcdir"/lunasvg-${_source_3rdparty_lunasvg} source/3rdparty/lunasvg
	rm -rf source/3rdparty/lunasvg/plutovg && mv "$srcdir"/plutovg-${_source_3rdparty_lunasvg_plutovg} source/3rdparty/lunasvg/plutovg
	default_prepare
}

build() {
	# musl: the execinfo.h stub; stat64 and friends only with _LARGEFILE64_SOURCE; glibc's
	# _NL_IDENTIFICATION_*/_NL_ADDRESS_* locale items as items musl doesn't have (nl_langinfo() returns "")
	export CXXFLAGS="$CXXFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE \
		-D_NL_IDENTIFICATION_LANGUAGE=0x60000 -D_NL_IDENTIFICATION_TERRITORY=0x60001 \
		-D_NL_ADDRESS_LANG_AB=0x60002 -D_NL_ADDRESS_COUNTRY_AB2=0x60003"
	export CFLAGS="$CFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE"
	cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Dgearmulator_BUILD_JUCEPLUGIN_LV2=ON -Dgearmulator_BUILD_JUCEPLUGIN_VST2=OFF -Dgearmulator_BUILD_JUCEPLUGIN_VST3=OFF -Dgearmulator_BUILD_JUCEPLUGIN_CLAP=OFF -Dgearmulator_BUILD_JUCEPLUGIN_AU=OFF -Dgearmulator_SYNTH_VAVRA=OFF -Dgearmulator_SYNTH_XENIA=OFF -Dgearmulator_SYNTH_NODALRED2X=OFF -Dgearmulator_SYNTH_JE8086=OFF -Dgearmulator_SYNTH_88EMU=OFF -Dgearmulator_COMPONENT_DSPBRIDGE=OFF -Dgearmulator_BUILD_INSTALLER=OFF -DBUILD_TESTING=OFF
	# at most 3 jobs: the JUCE translation units need ~1 GB each
	cmake --build build --parallel 3 --target osirusJucePlugin_LV2 osTIrusJucePlugin_LV2
}

package() {
	local d
	mkdir -p "$pkgdir"/usr/lib/lv2
	for d in $(find build -type d -path '*/LV2/*.lv2' -prune); do
		cp -r "$d" "$pkgdir"/usr/lib/lv2/
	done
}

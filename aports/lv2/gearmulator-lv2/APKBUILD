source="$pkgname-$_commit.tar.gz::https://github.com/dsp56300/gearmulator/archive/$_commit.tar.gz
	source_cpu_dsp56300-${_source_cpu_dsp56300}.tar.gz::https://github.com/dsp56300/dsp56300/archive/${_source_cpu_dsp56300}.tar.gz
	source_cpu_dsp56300_source_asmjit-${_source_cpu_dsp56300_source_asmjit}.tar.gz::https://github.com/dsp56300/asmjit/archive/${_source_cpu_dsp56300_source_asmjit}.tar.gz

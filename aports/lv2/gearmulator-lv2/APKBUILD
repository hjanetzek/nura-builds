# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# gearmulator (The Usual Suspects): Osirus (Virus A/B/C) and OsTIrus (Virus TI) DSP56300 emulations, JUCE with RmlUi skins. Need the user's ROMs (not packaged). Disabled in zynthian's config (shared snapshots use them); the other synths (Vavra, Xenia, NodalRed2x, JE-8086, 88Emu) not built yet.
# JUCE and the other git submodules are extra sources (nura/tools/gh-submodule-sources.py). LV2
# only. The plugin has its JUCE GUI built in, so it needs X11 and freetype headers to build (JUCE
# loads X11 only when the editor opens).
pkgname=gearmulator-lv2
pkgver=2.2.27
pkgrel=0
_commit=719f92ee3b3a606143d30bea4647ce501b95094c
_source_cpu_dsp56300=2a7ca1e9ce4b0d74b47d9a6384f6d15c1588d2b0
_source_cpu_dsp56300_source_asmjit=3577608cab0bc509f856ebf6e41b2f9d9f71acc4
_source_3rdparty_juce=54e15111b0355db5245039250b348e58b3e45e24
_source_3rdparty_cpp_terminal=43f5dc0061ce31ea0ddc8fd4cc1d65d83e33a232
_source_cpu_mc68k=cc3693a23fde2ea97aec261198f9e6291ead5e5e
_source_3rdparty_clap_juce_extensions=2aaad9e637c62a4eed4664a7e8ef52dca9dc3ba6
_source_3rdparty_clap_juce_extensions_clap_libs_clap=df8f16c69ba1c1a15fb105f0c5a2e5b9ac6be742
_source_3rdparty_clap_juce_extensions_clap_libs_clap_helpers=7b53a685e11465154b4ccba3065224dbcbf8a893
_source_3rdparty_rmlui=0c8e94e49e76ab5e40526aea62d22d21605e1125
_source_3rdparty_freetype=828916527ce4f69af722bce46ce54d289001a0bd
_source_3rdparty_freetype_subprojects_dlg=72dfcc858c040c54a6a0b88fcb7e70ee186d3167
_source_3rdparty_portmidi_latest=101dac9455e2718512c94e24cbcae6a6f34b908b
_source_3rdparty_lunasvg=f8aabfb444bb37f69df7290790f57e4a27730a93
_source_3rdparty_lunasvg_plutovg=5e4712cf873b0c7829a4a6157763e2ad3ac49164
pkgdesc="Osirus and OsTIrus Virus emulations (LV2, with GUI; ROMs not included)"
url="https://github.com/dsp56300/gearmulator"
arch="aarch64 x86_64"
license="GPL-3.0-or-later"
makedepends="
	alsa-lib-dev
	cmake
	fontconfig-dev
	freetype-dev
	libx11-dev
	libxcursor-dev
	libxext-dev
	libxinerama-dev

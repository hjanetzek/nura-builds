prepare() {
	# musl: no execinfo.h (JUCE uses backtrace() for crash reports only): a stub without backtraces
	mkdir -p "$srcdir"/musl-compat
	cat > "$srcdir"/musl-compat/execinfo.h <<-'EOF'
	#pragma once
	static inline int backtrace(void **buf, int size) { (void) buf; (void) size; return 0; }
	static inline char **backtrace_symbols(void *const *buf, int size) { (void) buf; (void) size; return 0; }
	EOF
	# git submodules (outer ones first)
	rm -rf Libraries/JUCE && mv "$srcdir"/JUCE-${_libraries_juce} Libraries/JUCE
	rm -rf Libraries/pure-data && mv "$srcdir"/plugdata-pd-${_libraries_pure_data} Libraries/pure-data
	rm -rf Libraries/heavylib && mv "$srcdir"/heavylib-${_libraries_heavylib} Libraries/heavylib
	rm -rf Libraries/pd-lua && mv "$srcdir"/pd-lua-${_libraries_pd_lua} Libraries/pd-lua
	rm -rf Libraries/pd-lua/luas/lua-compat-5.3 && mv "$srcdir"/lua-compat-5.3-${_libraries_pd_lua_luas_lua_compat_5_3} Libraries/pd-lua/luas/lua-compat-5.3
	rm -rf Libraries/pd-lua/luas/luajit && mv "$srcdir"/LuaJIT-${_libraries_pd_lua_luas_luajit} Libraries/pd-lua/luas/luajit
	rm -rf Libraries/pd-lua/luas/lua && mv "$srcdir"/lua-${_libraries_pd_lua_luas_lua} Libraries/pd-lua/luas/lua
	rm -rf Libraries/clap-juce-extensions && mv "$srcdir"/clap-juce-extensions-${_libraries_clap_juce_extensions} Libraries/clap-juce-extensions
	rm -rf Libraries/clap-juce-extensions/clap-libs/clap && mv "$srcdir"/clap-${_libraries_clap_juce_extensions_clap_libs_clap} Libraries/clap-juce-extensions/clap-libs/clap
	rm -rf Libraries/clap-juce-extensions/clap-libs/clap-helpers && mv "$srcdir"/clap-helpers-${_libraries_clap_juce_extensions_clap_libs_clap_helpers} Libraries/clap-juce-extensions/clap-libs/clap-helpers
	rm -rf Libraries/pd-else && mv "$srcdir"/pd-else-${_libraries_pd_else} Libraries/pd-else
	rm -rf Libraries/readerwriterqueue && mv "$srcdir"/readerwriterqueue-${_libraries_readerwriterqueue} Libraries/readerwriterqueue
	rm -rf Libraries/concurrentqueue && mv "$srcdir"/concurrentqueue-${_libraries_concurrentqueue} Libraries/concurrentqueue
	rm -rf Libraries/Gem && mv "$srcdir"/plugdata-gem-${_libraries_gem} Libraries/Gem
	rm -rf Libraries/Gem/freetype && mv "$srcdir"/freetype-${_libraries_gem_freetype} Libraries/Gem/freetype
	rm -rf Libraries/Gem/freetype/subprojects/dlg && mv "$srcdir"/dlg-${_libraries_gem_freetype_subprojects_dlg} Libraries/Gem/freetype/subprojects/dlg
	rm -rf Libraries/Gem/ftgl && mv "$srcdir"/ftgl-${_libraries_gem_ftgl} Libraries/Gem/ftgl
	rm -rf Libraries/ghc_filesystem && mv "$srcdir"/filesystem-${_libraries_ghc_filesystem} Libraries/ghc_filesystem
	rm -rf Libraries/nanovg && mv "$srcdir"/nanovg-${_libraries_nanovg} Libraries/nanovg
	rm -rf Libraries/pd-cyclone && mv "$srcdir"/pd-cyclone-${_libraries_pd_cyclone} Libraries/pd-cyclone
	rm -rf Libraries/melatonin_perfetto && mv "$srcdir"/melatonin_perfetto-${_libraries_melatonin_perfetto} Libraries/melatonin_perfetto
	rm -rf Libraries/libwebp && mv "$srcdir"/libwebp-${_libraries_libwebp} Libraries/libwebp
	rm -rf Libraries/xz && mv "$srcdir"/xz-${_libraries_xz} Libraries/xz
	rm -rf Libraries/fuzzysearchdatabase && mv "$srcdir"/j_norberg-fuzzysearchdatabase-${_libraries_fuzzysearchdatabase%"${_libraries_fuzzysearchdatabase#????????????}"} Libraries/fuzzysearchdatabase
	default_prepare
	# no LTO: the final links (standalone, two LV2 plugins) take longer than pmbootstrap's
	# 900 s without output in CI
	sed -i 's/^if (ipo_supported)/if (FALSE)/' CMakeLists.txt
	grep -q '^if (FALSE)' CMakeLists.txt
	# DEBUG: don't run the LV2 helper after linking (it hangs in CI); run it by hand in build()
	sed -i 's/COMMAND juce_lv2_helper "\$<TARGET_FILE:\${target_name}>"/COMMAND true/' \
		Libraries/JUCE/extras/Build/CMake/JUCEUtils.cmake
	grep -n 'COMMAND true' Libraries/JUCE/extras/Build/CMake/JUCEUtils.cmake
}

build() {
	# musl: the execinfo.h stub; stat64 and friends only with _LARGEFILE64_SOURCE; glibc's
	# _NL_IDENTIFICATION_*/_NL_ADDRESS_* locale items as items musl doesn't have (nl_langinfo() returns "")
	export CXXFLAGS="$CXXFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE \
		-D_NL_IDENTIFICATION_LANGUAGE=0x60000 -D_NL_IDENTIFICATION_TERRITORY=0x60001 \
		-D_NL_ADDRESS_LANG_AB=0x60002 -D_NL_ADDRESS_COUNTRY_AB2=0x60003"
	# Pd's d_soundfile.h: with _LARGEFILE64_SOURCE off_t is __off64_t (glibc) unless HAVE_OFF64_T;
	# musl has off64_t
	export CFLAGS="$CFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE -DHAVE_OFF64_T=1"
	cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DQUICK_BUILD=ON
	# at most 3 jobs: the JUCE translation units need ~1 GB each
	cmake --build build --parallel 3 --target plugdata_standalone plugdata_LV2 plugdata_fx_LV2
	# DEBUG: the LV2 helper by hand, with a backtrace of all threads if it still runs after 90 s
	local so pid
	for so in Plugins/LV2/plugdata.lv2/libplugdata.so; do
		ls -la "$so" build/juce_lv2_helper
		build/juce_lv2_helper "$so" > "$srcdir"/helper.log 2>&1 &
		pid=$!
		sleep 90
		if kill -0 $pid 2>/dev/null; then
			echo "=== helper still running after 90 s"
			gdb -batch -p $pid -ex "info threads" -ex "thread apply all bt 25" 2>&1 | tail -n 200
			kill -9 $pid
		else
			wait $pid; echo "=== helper exited: $?"
		fi
		echo "=== helper output"; tail -n 50 "$srcdir"/helper.log
	done
	return 1
}

package() {
	# outputs in Plugins/ (Standalone/plugdata, LV2/*.lv2). The standalone program unpacks its
	# resources (abstractions, help, fonts) into the user's ~/Documents/plugdata on the first start.
	install -Dm755 Plugins/Standalone/plugdata "$pkgdir"/usr/bin/plugdata
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r Plugins/LV2/plugdata.lv2 Plugins/LV2/plugdata-fx.lv2 "$pkgdir"/usr/lib/lv2/
	[ -f "$pkgdir"/usr/lib/lv2/plugdata.lv2/manifest.ttl ] || die "plugdata.lv2: no manifest.ttl"
}

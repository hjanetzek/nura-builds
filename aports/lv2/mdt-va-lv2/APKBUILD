# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# mTrio and mAnalog: MicroDexed-touch's Trio and Analog synths as LV2
# instruments (URIs https://github.com/hjanetzek/mdt-lv2/mtrio, .../manalog);
# Zynthian engine keys "JV/mTrio", "JV/mAnalog". The plugins are va/ in the
# mdt-lv2 repository (it uses ../common).
# No ARM flags here: they come from the build.
pkgname=mdt-va-lv2
_commit=c25cd617ecbf4d72d15358a3a4d4b28a2830fd9b
pkgver=0.0.1_git20261123
pkgrel=0
pkgdesc="mTrio and mAnalog: MicroDexed-touch's Trio and Analog synths as LV2 instruments"
url="https://github.com/hjanetzek/mdt-lv2"
arch="all"
license="GPL-3.0-only"
makedepends="cmake samurai lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/hjanetzek/mdt-lv2/archive/$_commit.tar.gz"
builddir="$srcdir/mdt-lv2-$_commit/va"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

check() {
	# the generator, render and import tests; the TTL validators
	# (lv2lint, sord_validate, lv2_validate) run only where installed
	ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
sha512sums="
c7806ce5ec9ccd586af2292203996dd2f7a93591d56ca7689f20b81f73b539f0582dd7aced3310facee5f0eaffe052bb1c409d3b920ae15d822089d50af16630  mdt-va-lv2-c25cd617ecbf4d72d15358a3a4d4b28a2830fd9b.tar.gz
"

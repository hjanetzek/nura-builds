# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# MOD's Arpeggiator (URI http://moddevices.com/plugins/mod-devel/arpeggiator; zynthian's recipe
# install_mod-arpeggiator.sh). A DPF plugin with DPF in the repository; DSP only (lv2_dsp) with
# the project's static TTLs, as its Makefile installs them.
pkgname=mod-arpeggiator-lv2
_commit=82f3d9f159ce216454656a8782362c3d5ed48bed
pkgver=0_git20211109
pkgrel=0
pkgdesc="MOD Arpeggiator LV2 MIDI plugin"
url="https://github.com/mod-audio/mod-arpeggiator-lv2"
arch="all"
license="GPL-3.0-or-later"
makedepends="lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/mod-audio/mod-arpeggiator-lv2/archive/$_commit.tar.gz"
builddir="$srcdir/mod-arpeggiator-lv2-$_commit"
options="!check" # no tests

build() {
	make -C plugins/arpeggiator NOOPT=true HAVE_DGL=false HAVE_OPENGL=false lv2_dsp
	cp -r static-lv2-data/mod-arpeggiator.lv2/* bin/mod-arpeggiator.lv2/
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r bin/mod-arpeggiator.lv2 "$pkgdir"/usr/lib/lv2/
}
sha512sums="
df5970d625bd0d017c22b13de7f6d33558115f155d7e9cd11f0e1abec508e61673f780f8927476704ed85435f97c06dcf3c42c9b4793bf5ef81a101a95dd40cc  mod-arpeggiator-lv2-82f3d9f159ce216454656a8782362c3d5ed48bed.tar.gz
"

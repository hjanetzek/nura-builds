# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# The LV2 specification's example plugins (eg-amp, eg-fifths, eg-metro, eg-midigate, eg-params,
# eg-sampler, eg-scope), which Alpine's lv2 package doesn't build. Same version as Alpine's lv2;
# only the eg-*.lv2 bundles are packaged (the specification bundles are in lv2). Example Fifths
# is used by shared zynthian snapshots. The sampler's and scope's GTK 2 UIs are left out (GTK 2
# UIs can't be embedded in a GTK 3 host).
pkgname=lv2-examples
pkgver=1.18.10
pkgrel=0
pkgdesc="LV2 example plugins (eg-amp, eg-fifths, eg-sampler, ...)"
url="https://lv2plug.in"
arch="all"
license="ISC"
makedepends="libsamplerate-dev libsndfile-dev meson"
source="https://lv2plug.in/spec/lv2-$pkgver.tar.xz"
builddir="$srcdir/lv2-$pkgver"
options="!check" # the specification's tests, run by Alpine's lv2

build() {
	# plugins=auto (enabled would require gtk+-2.0); libsamplerate and libsndfile are in makedepends
	abuild-meson -Dplugins=auto -Dtests=disabled -Ddocs=disabled \
		-Donline_docs=false -Dold_headers=false . output
	meson compile -C output
}

package() {
	DESTDIR="$srcdir/inst" meson install --no-rebuild -C output
	mkdir -p "$pkgdir"/usr/lib/lv2
	mv "$srcdir"/inst/usr/lib/lv2/eg-*.lv2 "$pkgdir"/usr/lib/lv2/
}
sha512sums="
ab4bcf593f633b1ed16c0eb6aa4525458a00655ef9c87619bf85eaa966f8fd094a8e871b825f679e0d97923f8bbbf11841ff467022390ca2f1a5b5f66ccd5d1b  lv2-1.18.10.tar.xz
"

# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# rncbc's synthv1, a polyphonic subtractive synthesizer (URI http://synthv1.sourceforge.net/lv2; Debian's
# synthv1-lv2 on ZynthianOS). LV2 only (no JACK application, NSM or OSC). The plugin links its Qt 6
# Widgets UI, so it needs Qt 6 development files matching the device's Qt (6.12 on Nura).
pkgname=synthv1-lv2
pkgver=1.5.2
pkgrel=0
pkgdesc="synthv1 polyphonic subtractive synthesizer (LV2)"
url="https://synthv1.sourceforge.io"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	cmake
	lv2-dev
	qt6-qtbase-dev
	qt6-qtsvg-dev
	samurai
	"
source="synthv1-$pkgver.tar.gz::https://github.com/rncbc/synthv1/archive/v$pkgver.tar.gz"
builddir="$srcdir/synthv1-$pkgver"
options="!check" # no tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCONFIG_QT6=ON \
		-DCONFIG_JACK=OFF \
		-DCONFIG_ALSA_MIDI=OFF \
		-DCONFIG_LIBLO=OFF \
		-DCONFIG_NSM=OFF \
		-DCONFIG_LV2=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	# only the plugin (no application without JACK)
	rm -rf "$pkgdir"/usr/share "$pkgdir"/usr/bin
}
sha512sums="
30cab1273e6e8003ab5702abd719da5043563dc1fdc0caf5e8bb79c70027ee235d1f6fcdcbc2352af27e6aee5007b8ef9fbcc43371097ee7e7ea8e5e4fbd53a5  synthv1-1.5.2.tar.gz
"

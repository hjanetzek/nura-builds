+  // so the first sample always computes
+  float mPerfPitchMod = NAN, mPerfBaseFreq = NAN, mPerfFreq = 0.f;
+  float mPerfVcfBaseHz = NAN, mPerfKbdBaseFreq = NAN, mPerfKbdPitch = NAN, mPerfKbdRef = NAN;
+  float mPerfVcfFreqOffset = NAN, mPerfVcfKbd = NAN, mPerfVcfFrqStatic = 0.f;
+
   float mPostOscDcG = 0.f;
+  float mPostOscDcA = 0.f; // mPostOscDcG / (1 + mPostOscDcG)
   float mPostOscDcS = 0.f;
 
   // Apply post-DCO DC blocker. One-pole TPT high-pass
   inline float DcBlockPostOsc(float in)
   {
-    const float v = (in - mPostOscDcS) * mPostOscDcG / (1.f + mPostOscDcG);
+    const float v = (in - mPostOscDcS) * mPostOscDcA; // A = G / (1 + G), precomputed
     const float lp = mPostOscDcS + v;
     mPostOscDcS = lp + v;
     return in - lp;

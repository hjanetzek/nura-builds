# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# eDrumSynth: MicroDexed-touch's drum engine (the voices of the OpenElixir-02
# firmware) as an LV2 instrument (URI https://github.com/hjanetzek/mdt-lv2/edrumsynth);
# Zynthian engine key "JV/eDrumSynth". The plugin is lxrdrums/ in the mdt-lv2
# repository. No ARM flags here: they come from the build.
pkgname=edrumsynth-lv2
_commit=72c7049ba712a8528f95fe42bf6a4bf32ca37629
pkgver=0.1.0
pkgrel=0
pkgdesc="eDrumSynth: synthesized drums (MicroDexed-touch's drum engine) as an LV2 instrument"
url="https://github.com/hjanetzek/mdt-lv2"
arch="all"
license="GPL-3.0-only"
makedepends="cmake samurai lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/hjanetzek/mdt-lv2/archive/$_commit.tar.gz"
builddir="$srcdir/mdt-lv2-$_commit/lxrdrums"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

check() {
	# the generator, render and resampler tests; the TTL validators
	# (lv2lint, sord_validate, lv2_validate) run only where installed
	ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
sha512sums="
c2cb1f4051bf2660920b49d8ce31ef878b9d34218495647202ba4d1a86b9b60f6d329a06692cc30763eaa13190da36fce231a842bfad921e59eee51b217d468d  edrumsynth-lv2-72c7049ba712a8528f95fe42bf6a4bf32ca37629.tar.gz
"

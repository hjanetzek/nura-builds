# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Regrader, a degrading delay (URI https://github.com/linuxmao-org/regrader; ZynthianOS has
# Debian's regrader). linuxmao-org's DPF port (the repository is regrader-port now). DPF (a git
# submodule, the old one MiniOPL3 also uses) is a second source; DSP only (lv2_dsp, UI off).
pkgname=regrader-lv2
_commit=9154881ad6553537cc7f2a743541f6b47de2a207
_dpf=4e180a77ec6e93abb021b28495bd84b43498bf31
pkgver=0_git20200616
pkgrel=0
pkgdesc="Regrader degrading delay (LV2)"
url="https://github.com/linuxmao-org/regrader-port"
arch="all"
license="MIT"
# bash: DPF's utils/generate-ttl.sh
makedepends="bash lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/linuxmao-org/regrader-port/archive/$_commit.tar.gz
	dpf-$_dpf.tar.gz::https://github.com/DISTRHO/DPF/archive/$_dpf.tar.gz"
builddir="$srcdir/regrader-port-$_commit"
options="!check" # no tests

prepare() {
	default_prepare
	rm -rf dpf
	mv "$srcdir"/DPF-$_dpf dpf
	# no GUI: without this the TTL references the UI binary, which isn't built
	sed -i 's/\(DISTRHO_PLUGIN_HAS_UI *\)1/\10/' sources/plugin/DistrhoPluginInfo.h
}

build() {
	make -C plugins/Regrader NOOPT=true HAVE_DGL=false HAVE_OPENGL=false lv2_dsp
	make -C dpf/utils/lv2-ttl-generator
	# the old DPF script finds its generator relative to $0, after a cd: call it by absolute path
	"$builddir"/dpf/utils/generate-ttl.sh
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r bin/*.lv2 "$pkgdir"/usr/lib/lv2/
}
sha512sums="

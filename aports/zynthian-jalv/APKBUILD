14a3652b362a01b435191cb1e31f51f0bb721a75a7b91c7fa00733b40bb4a25d58d859762cc41a26617227177ab481c25218237d821419fceb5a704e4ac73e20  bundle-list.patch
e4dc911a7123b1ec85dcb798dbb926b0466b9f06f8269ac4fe570adc7a3beddd7f0ff9255f155102a703d90b8fcf418ba9ea5f93438767ef204bac3fa2dc378f  exit-fixes.patch
"

# zynthian's jalv for postmarketOS/Nura: the LV2 host zynthian's jalv engine runs. The engine
# talks to the command line of this fork (branch asyncli, ZynthianOS recipe
# install_lv2_jalv.sh); with Alpine's jalv, loading an LV2 chain waits forever.
#
# Installed as /usr/lib/zynthian/bin/jalv, beside Alpine's jalv; zynthian's environment
# (desktop/zynthian_desktop_env.sh) puts /usr/lib/zynthian/bin first on PATH.
#
# The JACK command line host, and in zynthian-jalv-gtk the GTK frontend jalv.gtk3 (suil), which
# shows plugin GUIs (X11 UIs embedded through suil's x11-in-gtk3, GTK3 UIs) in sessions that can
# show other windows (postmarketos-ui-zynthian-niri). No Qt frontend (Alpine's suil has no Qt5
# wrapper), no PortAudio. Patches (zynthian/jalv fork branches, for upstream), applied in this order:
# - bundle-list.patch: -B DIRS loads only the given bundles instead of all of LV2_PATH, in both
#   frontends (jalv and jalv.gtk3; zynthian-ui passes each plugin's bundles: ~0.8 s less per jalv
#   start on a Pi 4);
# - exit-fixes.patch: at exit, JACK is deactivated before the worker stops, and no command line
#   command runs while jalv frees the plugin and the world (a preset loaded right before SIGTERM
#   crashed in lilv_world_free);
# - fast-exit.patch: after SIGTERM stop audio, worker, UI and plugin, then _exit() without freeing
#   the LV2 world (most of Helm's/Dexed's exit); a preset's file is parsed before the command lock,
#   so a stop doesn't wait for it (Helm/Dexed: seconds on a Pi); the exit gives up after 2 s with
#   status 3 if the plugin is stuck in run();
# - gtk-hide-ui.patch: start the GTK frontend with the window hidden (-H) and show/hide it by
#   command ("ui show", "ui hide"), so that zynthian opens a plugin's GUI on demand;
# - gtk-lazy-ui.patch: with -H, the plugin UI is instantiated when the window is shown and freed
#   when it is hidden, and the UI update timer runs only while it is shown: hidden JUCE UIs kept
#   their timers and repaints going (8 hidden KR-106 GUIs: ~2.5 cores on the Duet, against ~0.6
#   core of DSP); SIGTERM is handled in the GTK main loop.
# From a local checkout:
#   pmbootstrap build --src=/path/to/jalv zynthian-jalv
pkgname=zynthian-jalv
_commit=e01b6d64651d451107640b1a502e06c9ec10e353
pkgver=1.12.1_git20260330
pkgrel=5
pkgdesc="zynthian's jalv: LV2 host with the asynchronous command line zynthian uses"
url="https://github.com/zynthian/jalv"
arch="aarch64 armv7 x86_64"
license="ISC"
options="!check"
makedepends="
	gtk+3.0-dev
	jack-dev
	lilv-dev
	lv2-dev
	meson
	serd-dev
	sord-dev
	sratom-dev
	suil-dev
	zix-dev
	"
subpackages="$pkgname-gtk"
source="$pkgname-$_commit.tar.gz::https://github.com/zynthian/jalv/archive/$_commit.tar.gz
	bundle-list.patch
	exit-fixes.patch
	fast-exit.patch
	gtk-hide-ui.patch
	gtk-lazy-ui.patch
	"
builddir="$srcdir/jalv-$_commit"

build() {
	abuild-meson \
		--wrap-mode=nodownload \
		-Djack=enabled \
		-Dgtk3=enabled \
		-Dqt5=disabled \
		-Dportaudio=disabled \
		-Dsuil=enabled \
		-Dtests=disabled \
		. output
	meson compile -C output
}

package() {
	install -Dm755 output/jalv -t "$pkgdir"/usr/lib/zynthian/bin/
}

gtk() {
	pkgdesc="$pkgdesc (GTK frontend: plugin GUIs)"
	depends="$pkgname=$pkgver-r$pkgrel"
	install -Dm755 "$builddir"/output/jalv.gtk3 -t "$subpkgdir"/usr/lib/zynthian/bin/
}


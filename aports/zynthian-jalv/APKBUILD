# zynthian's jalv for postmarketOS/Nura: the LV2 host zynthian's jalv engine runs. The engine
# talks to the command line of this fork (branch asyncli, ZynthianOS recipe
# install_lv2_jalv.sh); with Alpine's jalv, loading an LV2 chain waits forever.
#
# Installed as /usr/lib/zynthian/bin/jalv, beside Alpine's jalv; zynthian's environment
# (desktop/zynthian_desktop_env.sh) puts /usr/lib/zynthian/bin first on PATH.
#
# The JACK command line host, and in zynthian-jalv-gtk the GTK frontend jalv.gtk3 (suil), which
# shows plugin GUIs (X11 UIs embedded through suil's x11-in-gtk3, GTK3 UIs) in sessions that can
# show other windows (postmarketos-ui-zynthian-niri). No Qt frontend (Alpine's suil has no Qt5
# wrapper), no PortAudio.
#
# Built from the fork https://github.com/hjanetzek/jalv, branch `nura`: zynthian's asyncli
# (e01b6d6) plus these changes, each also a topic branch there for upstream pull requests:
# - bundle-list: -B DIRS loads only the given bundles instead of all of LV2_PATH, in both
#   frontends (zynthian-ui passes each plugin's bundles: ~0.8 s less per jalv start on a Pi 4);
# - exit-fixes: at exit, JACK is deactivated before the worker stops, and no command line command
#   runs while jalv frees the plugin and the world (a preset loaded right before SIGTERM crashed);
# - fast-exit: after SIGTERM stop audio, worker, UI and plugin, then _exit() without freeing the
#   LV2 world; a preset's file is parsed before the command lock; the exit gives up after 2 s
#   (status 3) if the plugin is stuck in run();
# - gtk-hide-ui: start the GTK frontend with the window hidden (-H), show/hide it by command
#   ("ui show", "ui hide") - the topic branch sits on exit-fixes; `nura` has it rebased onto fast-exit;
# - gtk-lazy-ui: with -H, the plugin UI exists only while the window is shown and the update timer
#   runs only then (8 hidden KR-106 GUIs cost ~2.5 cores on the Duet); SIGTERM in the GTK main loop.
# New versions: the `nura` commit in _commit (no patch files here).
# From a local checkout:
#   pmbootstrap build --src=/path/to/jalv zynthian-jalv
pkgname=zynthian-jalv
_commit=0f93f91525efb0e4a81b338fd186b62c92bd0532
pkgver=1.12.1_git20261118
pkgrel=0
pkgdesc="zynthian's jalv: LV2 host with the asynchronous command line zynthian uses"
url="https://github.com/hjanetzek/jalv"
arch="aarch64 armv7 x86_64"
license="ISC"
options="!check"
makedepends="
	gtk+3.0-dev
	jack-dev
	lilv-dev
	lv2-dev
	meson
	serd-dev
	sord-dev
	sratom-dev
	suil-dev
	zix-dev
	"
subpackages="$pkgname-gtk"
source="$pkgname-$_commit.tar.gz::https://github.com/hjanetzek/jalv/archive/$_commit.tar.gz"
builddir="$srcdir/jalv-$_commit"

build() {
	abuild-meson \
		--wrap-mode=nodownload \
		-Djack=enabled \
		-Dgtk3=enabled \
		-Dqt5=disabled \
		-Dportaudio=disabled \
		-Dsuil=enabled \
		-Dtests=disabled \
		. output
	meson compile -C output
}

package() {
	install -Dm755 output/jalv -t "$pkgdir"/usr/lib/zynthian/bin/
}

gtk() {
	pkgdesc="$pkgdesc (GTK frontend: plugin GUIs)"
	depends="$pkgname=$pkgver-r$pkgrel"
	install -Dm755 "$builddir"/output/jalv.gtk3 -t "$subpkgdir"/usr/lib/zynthian/bin/
}

sha512sums="
abf9669e3353077133dd6589071d26c5ff583ec83e698f097e2430bd6c7dee7e522b1dce630571d943de60af2dadbe9a97904b5809e66121e9d6391d1c90bef9  zynthian-jalv-0f93f91525efb0e4a81b338fd186b62c92bd0532.tar.gz
"

From c529033c4dfb6b8e77645222baf7f56547c00ac0 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Tue, 17 Nov 2026 18:17:22 +0100
Subject: [PATCH] Exit: deactivate audio before the worker, no commands during
 close

jalv_close() terminated the worker while the plugin was still running in the JACK
process thread, and the command line thread kept running commands while jalv freed
the plugin and the world: a preset loaded right before SIGTERM crashed in
lilv_world_free/sord (seen in zynthian). Deactivate and close the audio backend first
(as upstream jalv does now), and hold a lock while a command runs that main() takes
before jalv_close().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FXkgPvuShs23GDcEBASZCU
---
 src/jalv.c | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/src/jalv.c b/src/jalv.c
index 86d354b..6197f43 100644
--- a/src/jalv.c
+++ b/src/jalv.c
@@ -1593,15 +1593,16 @@ jalv_open(Jalv* const jalv, int* argc, char*** argv)
 int
 jalv_close(Jalv* const jalv)
 {
-  // Terminate the worker
-  jalv_worker_exit(jalv->worker);
-
-  // Deactivate audio
+  // Deactivate audio first: the plugin's run() may still schedule work or read worker
+  // responses
   if (jalv->backend) {
     jalv_backend_deactivate(jalv);
     jalv_backend_close(jalv);
   }
 
+  // Terminate the worker
+  jalv_worker_exit(jalv->worker);
+
   // Free event port buffers
   for (uint32_t i = 0; i < jalv->num_ports; ++i) {
     if (jalv->ports[i].evbuf) {
@@ -1850,6 +1851,10 @@ jalv_process_command(Jalv* jalv, const char* cmd)
 }
 
 
+// Held while the command line thread runs a command; main() takes it for good before
+// jalv_close(), so no command (e.g. a preset load into the world) runs while jalv frees
+static pthread_mutex_t cli_command_lock = PTHREAD_MUTEX_INITIALIZER;
+
 void * cli_thread(void *arg) {
 	Jalv* jalv = (Jalv*) arg;
 	fprintf(stdout, "> \n");
@@ -1857,7 +1862,9 @@ void * cli_thread(void *arg) {
 	while (1) {
 		char line[1024];
 		if (fgets(line, sizeof(line), stdin)) {
+			pthread_mutex_lock(&cli_command_lock);
 			jalv_process_command(jalv, line);
+			pthread_mutex_unlock(&cli_command_lock);
 		} else {
 			break;
 		}
@@ -1905,5 +1912,8 @@ main(int argc, char** argv)
   // Wait for finish signal from UI or signal handler
   zix_sem_wait(&jalv.done);
 
+  // Wait for a running command to finish, and keep further ones from running
+  pthread_mutex_lock(&cli_command_lock);
+
   return jalv_close(&jalv);
 }

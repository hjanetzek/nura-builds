From 20eb8bb03aea738a6639ffb0ba2d4bc8d8ef7173 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Tue, 17 Nov 2026 20:25:13 +0100
Subject: [PATCH 1/3] Exit quickly: stop audio, worker, UI and plugin, then
 _exit()

After SIGTERM, jalv freed everything before returning from main(). For
plugins with many presets, freeing the LV2 world was most of the exit
(Helm, Dexed with -B: ~35 of ~40 ms on x86_64, several times that on a
Raspberry Pi, where a host stopping a dozen jalvs at once waited seconds).
main() now stops what has effects outside the process (audio, the worker,
the UI, the plugin's deactivate and cleanup), removes the temporary
directory, flushes stdout/stderr and calls _exit(). This also skips
exit()'s stdio cleanup, which on musl waits for stdin's lock held by the
command line thread's fgets() until stdin is closed, and the libraries'
static destructors, which raced plugin threads in some plugins.
jalv_close() still frees everything (internal client).

The console frontend waited up to 30 ms after SIGTERM before noticing
it (try_wait + usleep): it now waits on the semaphore with a 30 ms
timeout, updating at the same rate.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FXkgPvuShs23GDcEBASZCU
---
 src/jalv.c         | 27 ++++++++++++++++++++++++---
 src/jalv_console.c | 12 ++++++++++--
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/src/jalv.c b/src/jalv.c
index 366ffa1..3bebe70 100644
--- a/src/jalv.c
+++ b/src/jalv.c
@@ -1590,8 +1590,10 @@ jalv_open(Jalv* const jalv, int* argc, char*** argv)
   return 0;
 }
 
-int
-jalv_close(Jalv* const jalv)
+/// Stop what runs and has effects outside the process: audio, the worker, the
+/// UI, the plugin (deactivate and clean up)
+static void
+jalv_stop(Jalv* const jalv)
 {
   // Deactivate audio first: the plugin's run() may still schedule work or read worker
   // responses
@@ -1622,6 +1624,12 @@ jalv_close(Jalv* const jalv)
     lilv_instance_deactivate(jalv->instance);
     lilv_instance_free(jalv->instance);
   }
+}
+
+int
+jalv_close(Jalv* const jalv)
+{
+  jalv_stop(jalv);
 
   // Clean up
   free(jalv->ports);
@@ -1923,5 +1931,18 @@ main(int argc, char** argv)
   // Wait for a running command to finish, and keep further ones from running
   pthread_mutex_lock(&cli_command_lock);
 
-  return jalv_close(&jalv);
+  // Quick exit: stop audio, the worker, the UI and the plugin, then end without freeing
+  // the rest. Freeing the LV2 world alone took most of the exit of plugins with many
+  // presets (Helm, Dexed: ~35 of ~40 ms on x86_64, several times that on a Raspberry Pi,
+  // with a dozen jalvs stopped at once when a host loads another setup). _exit() also
+  // skips exit()'s stdio cleanup, which on musl waits for stdin's lock, held by the
+  // command line thread's fgets() until the host closes stdin, and the plugin libraries'
+  // static destructors, which raced plugin threads in several plugins (crashes at exit).
+  jalv_stop(&jalv);
+  if (jalv.temp_dir) {
+    remove(jalv.temp_dir);
+  }
+  fflush(stdout);
+  fflush(stderr);
+  _exit(EXIT_SUCCESS);
 }
diff --git a/src/jalv_console.c b/src/jalv_console.c
index 5e98530..619da9c 100644
--- a/src/jalv_console.c
+++ b/src/jalv_console.c
@@ -250,9 +250,17 @@ jalv_frontend_open(Jalv* jalv)
   }
 
   if (!jalv_run_custom_ui(jalv)) {
-    while (zix_sem_try_wait(&jalv->done)) {
+    // Update every 30 ms, but return as soon as done is posted (SIGTERM), not
+    // up to 30 ms later
+    ZixStatus st = ZIX_STATUS_SUCCESS;
+    while ((st = zix_sem_timed_wait(&jalv->done, 0, 30000000U))) {
+      if (st == ZIX_STATUS_NOT_SUPPORTED) {
+        usleep(30000);
+        if (!zix_sem_try_wait(&jalv->done)) {
+          break;
+        }
+      }
       jalv_update(jalv);
-      usleep(30000);
     }
   } else {
     zix_sem_wait(&jalv->done);

From 40716a0cb9b354273659b5f1e43150370bdea110 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Tue, 17 Nov 2026 20:48:29 +0100
Subject: [PATCH 3/3] Quick exit: end after 2 s even if the plugin is stuck

A plugin stuck in run() (Helm: an endless loop in updateMemoryOutput with
a bad sample rate) keeps jack_deactivate() from returning: PipeWire's
pw_data_loop_stop() joins the data loop thread, which never finishes the
cycle. jalv then never ended; the host had to SIGKILL it. An alarm now
ends the exit after 2 s with status 3 and "error: exit timed out (plugin
stuck?)" on stderr, so the host can tell such a plugin from a clean exit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FXkgPvuShs23GDcEBASZCU
---
 src/jalv.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/jalv.c b/src/jalv.c
index 4d89e01..9d56cd0 100644
--- a/src/jalv.c
+++ b/src/jalv.c
@@ -1928,6 +1928,19 @@ pthread_t init_cli_thread(Jalv* jalv) {
 // Main
 //-----------------------------------------------------------------------------
 
+#define JALV_EXIT_TIMEOUT 2  ///< Seconds the quick exit may take
+#define JALV_EXIT_TIMED_OUT 3 ///< Exit status if it took longer
+
+static void
+exit_timeout_handler(int ZIX_UNUSED(sig))
+{
+  static const char msg[] = "error: exit timed out (plugin stuck?)\n";
+  if (write(STDERR_FILENO, msg, sizeof(msg) - 1) < 0) {
+    // Nothing to do: ending anyway
+  }
+  _exit(JALV_EXIT_TIMED_OUT);
+}
+
 int
 main(int argc, char** argv)
 {
@@ -1957,6 +1970,10 @@ main(int argc, char** argv)
   // skips exit()'s stdio cleanup, which on musl waits for stdin's lock, held by the
   // command line thread's fgets() until the host closes stdin, and the plugin libraries'
   // static destructors, which raced plugin threads in several plugins (crashes at exit).
+  // A plugin stuck in run() keeps the audio backend from deactivating (the backend
+  // waits for the cycle): end anyway after a while, with a status that says so
+  signal(SIGALRM, exit_timeout_handler);
+  alarm(JALV_EXIT_TIMEOUT);
   jalv_stop(&jalv);
   if (jalv.temp_dir) {
     remove(jalv.temp_dir);
-- 

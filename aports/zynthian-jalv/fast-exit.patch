From a4d5a7537e966d383ab4e3f328812cbf9bfc5128 Mon Sep 17 00:00:00 2001
From: Hannes Janetzek <hannes.janetzek@gmail.com>
Date: Tue, 17 Nov 2026 20:47:06 +0100
Subject: [PATCH 2/3] Parse a preset's file before the command lock

The first "preset" command of a jalv parses the plugin's presets file;
plugins that keep all presets in one file (Helm 4.6 MB, Dexed 4.1 MB)
take 0.3-0.4 s for it on x86_64 and seconds on a Raspberry Pi. It ran
under the command lock that main() takes before closing, so a SIGTERM
right after a preset load waited for the parse (zynthian loading another
setup while the presets of the last one still load).

The command line thread now loads the preset's resource before it takes
the lock. That only touches the world, which the quick exit doesn't free;
the command then finds the file loaded (lilv loads each file once), and if
main() has taken the lock meanwhile, the thread blocks and ends with the
process.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FXkgPvuShs23GDcEBASZCU
---
 src/jalv.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/jalv.c b/src/jalv.c
index 3bebe70..4d89e01 100644
--- a/src/jalv.c
+++ b/src/jalv.c
@@ -1871,6 +1871,24 @@ jalv_process_command(Jalv* jalv, const char* cmd)
 // jalv_close(), so no command (e.g. a preset load into the world) runs while jalv frees
 static pthread_mutex_t cli_command_lock = PTHREAD_MUTEX_INITIALIZER;
 
+// Parse the data file of the preset a "preset", "presetd" or "presetn" command loads, before
+// the command takes the lock. Plugins that keep all their presets in one file (Helm, Dexed:
+// 4-5 MB) take ~0.4 s for this on x86_64, seconds on a Raspberry Pi; under the lock, a stop
+// (SIGTERM) waited for it. Only the world is touched, which the quick exit doesn't free; the
+// command then finds the file loaded (lilv loads a file once).
+static void
+cli_preload_preset(Jalv* jalv, const char* line)
+{
+	char uri[1024];
+	if (sscanf(line, "preset %1023[-a-zA-Z0-9_:/.%%#]", uri) == 1 ||
+	    sscanf(line, "presetd %1023[-a-zA-Z0-9_:/.%%#]", uri) == 1 ||
+	    sscanf(line, "presetn %1023[-a-zA-Z0-9_:/.%%#]", uri) == 1) {
+		LilvNode* preset = lilv_new_uri(jalv->world, uri);
+		lilv_world_load_resource(jalv->world, preset);
+		lilv_node_free(preset);
+	}
+}
+
 void * cli_thread(void *arg) {
 	Jalv* jalv = (Jalv*) arg;
 	fprintf(stdout, "> \n");
@@ -1878,6 +1896,7 @@ void * cli_thread(void *arg) {
 	while (1) {
 		char line[1024];
 		if (fgets(line, sizeof(line), stdin)) {
+			cli_preload_preset(jalv, line);
 			pthread_mutex_lock(&cli_command_lock);
 			jalv_process_command(jalv, line);
 			pthread_mutex_unlock(&cli_command_lock);
-- 

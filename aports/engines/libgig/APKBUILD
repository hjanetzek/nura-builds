# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# libgig: Gigasampler/GigaStudio, DLS, SoundFont and KORG file library (linuxsampler's), and its
# command line tools (gigtools, which ZynthianOS installs with linuxsampler). Not in Alpine.
pkgname=libgig
pkgver=4.6.0
pkgrel=1
pkgdesc="C++ library for Gigasampler/GigaStudio, DLS, SoundFont and KORG sound files"
url="https://www.linuxsampler.org/libgig/"
arch="all"
license="GPL-2.0-or-later"
# linux-headers: linux/cdrom.h (the Akai CD-ROM reader)
makedepends="libsndfile-dev linux-headers util-linux-dev"
subpackages="$pkgname-dev $pkgname-doc gigtools:_tools"
source="https://download.linuxsampler.org/packages/libgig-$pkgver.tar.bz2"
options="!check" # no tests

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-static
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

dev() {
	default_dev
	# The libraries are in /usr/lib/libgig, where default_dev doesn't look: their unversioned links
	# too (from them abuild derives -dev's dependency on the libraries)
	amove usr/lib/libgig/libgig.so usr/lib/libgig/libakai.so
}

_tools() {
	pkgdesc="Tools for Gigasampler/GigaStudio, DLS, SoundFont and KORG files (libgig)"
	amove usr/bin
}

sha512sums="
c5c0a4f36fd6b62baefdacbc2250a65de2f095aecd70242b860fb406a6f983a9b871096d725d4a83808e13f2522de1913eea9618abd6fea3146ee820df77eef0  libgig-4.6.0.tar.bz2
"

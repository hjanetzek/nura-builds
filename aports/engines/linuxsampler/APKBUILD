# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# LinuxSampler: the sampler of zynthian's LS engine (linuxsampler --lscp-port, LSCP over a socket).
# ZynthianOS installs it (Debian's linuxsampler), and six of its factory snapshots play SFZ
# instruments with it. Not in Alpine: its licence is the GPL with an exception, it may not be used
# in commercial software or hardware products without the authors' written permission (README).
# JACK and ALSA drivers, GIG/SFZ/SF2 engines, the instruments database; no LV2/DSSI plugin.
pkgname=linuxsampler
pkgver=2.5.0
pkgrel=1
pkgdesc="Software audio sampler (GIG, SFZ, SF2)"
url="https://www.linuxsampler.org/"
arch="all"
license="custom"
# flex, bison, perl, perl-xml-parser: required by configure (configure.ac:46-63)
makedepends="alsa-lib-dev bison flex jack-dev libgig-dev libsndfile-dev perl perl-xml-parser sqlite-dev"
subpackages="$pkgname-dev $pkgname-doc"
# thread-stop-joined.patch: Thread::StopThread() detached a thread after joining it, a use after free
# on musl (crash on every RESET CHANNEL of an SFZ channel, i.e. when zynthian removes the chain)
source="https://download.linuxsampler.org/packages/linuxsampler-$pkgver.tar.bz2
	thread-stop-joined.patch
	"
options="!check" # no tests

prepare() {
	default_prepare
	# musl: no execinfo.h (backtrace() only for the Mutex debug info): a stub without backtraces
	mkdir -p "$srcdir"/musl-compat
	cat > "$srcdir"/musl-compat/execinfo.h <<-'EOF2'
	#pragma once
	static inline int backtrace(void **buf, int size) { (void) buf; (void) size; return 0; }
	static inline char **backtrace_symbols(void *const *buf, int size) { (void) buf; (void) size; return 0; }
	EOF2
}

build() {
	export CXXFLAGS="$CXXFLAGS -I$srcdir/musl-compat"
	# libgig is in /usr/lib/libgig: without its libtool .la (packages drop them) libtool loses the
	# -L of gig.pc, links no runtime path and leaves -lgig out of liblinuxsampler.so, so all three
	# explicitly (-lgig for make only: with LIBS set, configure's compiler test failed in CI)
	export LDFLAGS="$LDFLAGS -L/usr/lib/libgig -Wl,-rpath,/usr/lib/libgig"
	# HAVE_UNIX98: configure's UNIX98 test fails on musl, which has pthread_mutexattr_settype(),
	# the call it is about (configure says to set it then). NPTL bug check: a test for an old glibc
	# pthread bug, which doesn't apply to musl.
	HAVE_UNIX98=1 ./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-static \
		--disable-nptl-bug-check \
		--disable-arts-driver
	make LIBS="-lgig"
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 README COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="

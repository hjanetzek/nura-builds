# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# The kernel's real-time test tools (cyclictest, hackbench, oslat, ...), to measure scheduling
# latency on the zynthian devices: linux-rpi-rt (PREEMPT_RT) against linux-rpi on the Pi 4
# (docs/zynthian-rpi.md). Not an engine: in aports/engines only for the plugin-* CI builds; not in
# any image. Without python3 (hwlatdetect, get_cyclictest_snapshot), which the Makefile then skips.
# musl: cyclictest's fallback define of sigev_notify_thread_id (glibc's internal field) only where
# the C library lacks it (patch); pi_stress left out (needs _POSIX_THREAD_PRIO_INHERIT, which musl
# doesn't define).
pkgname=rt-tests
pkgver=2.11
pkgrel=0
pkgdesc="Programs that test various real-time Linux features (cyclictest, hackbench, ...)"
url="https://wiki.linuxfoundation.org/realtime/documentation/howto/tools/rt-tests"
arch="all"
license="GPL-2.0-only"
makedepends="linux-headers numactl-dev"
subpackages="$pkgname-doc"
options="!check" # tests need root and real-time scheduling
source="https://www.kernel.org/pub/linux/utils/rt-tests/rt-tests-$pkgver.tar.xz
	cyclictest-musl-sigev_notify_thread_id.patch
	"
# The Makefile's sources without pi_stress.c
_sources="cyclictest.c hackbench.c pip_stress.c pmqtest.c ptsematest.c rt-migrate-test.c
	signaltest.c sigwaittest.c svsematest.c cyclicdeadline.c deadline_test.c queuelat.c ssdd.c
	oslat.c"

build() {
	make PYLIB= prefix=/usr sources="$(echo $_sources)"
}

package() {
	make PYLIB= prefix=/usr sources="$(echo $_sources)" DESTDIR="$pkgdir" install
	# its man page (installed with the others)
	rm -f "$pkgdir"/usr/share/man/man8/pi_stress.8*
}

sha512sums="
541a47585fd87ae6998d7359a311a0c5a3b89cc3f7d7f43d9b3e63d2ec8172a009e2f8bbabc2c798f5f5e42cb5b38124b23a2ecb4be06faba51749709988113e  rt-tests-2.11.tar.xz
e61804eb786b96e729c1612f4310ac475fc304df816dfc4f19ca0e73fe01fc6ad933c7e51fef8d4dadf0c4b014d6ba2798dee7c15f2449dba632ef483ec04339  cyclictest-musl-sigev_notify_thread_id.patch
"

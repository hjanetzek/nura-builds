ceffbc9d572da53d86f5802cd030a002d85b9924eeb24af860a288a9c792a150c28acfe28adf2790d35bdc0c5f31b957d838841a203ca5a2b0070654bda488ca  niri-session.patch
0ff81d4c6cb9fd8c6f1206cb05a10729495adbcd689949d5e3d5b7150e6a67e84a1ce307ccb4367fb800833a2806e215d62621fc0621a88b4e82d462dba0f360  fix-rustix-statx.patch
"
